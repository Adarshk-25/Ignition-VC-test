            "borderWidth": "0.02px",
            "gap": "2px",
            "marginRight": 5
          },
          "value": "Line 2"
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\n    container \u003d self.parent\n\n    date \u003d container.getChild(\"DateInput\").props.value\n    line \u003d container.getChild(\"LineDropdown\").props.value\n    category \u003d container.getChild(\"CategoryDropdown\").props.value\n    due_date \u003d container.getChild(\"DueDateInput\").props.value\n    person \u003d container.getChild(\"PersonName\").props.text\n    issue \u003d container.getChild(\"CommentInput\").props.text\n    action \u003d container.getChild(\"ActionInput\").props.text\n\n    # 🔹 Category mapping\n    category_map \u003d {\n        \"Safety\": \"S\",\n        \"Quality\": \"Q\",\n        \"Cost\": \"C\",\n        \"Delivery\": \"D\",\n        \"People\": \"P\"\n    }\n\n    # 🔹 Get current year + month\n    now \u003d system.date.now()\n    year \u003d system.date.format(now, \"yyyy\")\n    month \u003d system.date.format(now, \"MM\")\n\n    # 🔹 Count existing entries\n    count_query \u003d \"\"\"\n    SELECT COUNT(*) FROM issues_log\n    WHERE \n        FORMAT(event_date, \u0027yyyyMM\u0027) \u003d ?\n        AND category \u003d ?\n    \"\"\"\n\n    count \u003d system.db.runScalarPrepQuery(\n        count_query,\n        [year + month, category],\n        \"Dev_MSSQL_Server\"\n    )\n\n    # 🔹 Generate sequence\n    sequence \u003d str(count + 1).zfill(3)\n\n    # 🔹 Generate reference number\n    ref_number \u003d year + month + category_map[category] + sequence\n\n    # 🔹 Insert with reference_number\n    query \u003d \"\"\"\n    INSERT INTO issues_log \n    (event_date, line_number, category, due_date, issue, action, person_responsible, reference_number)\n    VALUES (?, ?, ?, ?, ?, ?, ?, ?)\n    \"\"\"\n\n    system.db.runPrepUpdate(\n        query, \n        [date, line, category, due_date, issue,action, person, ref_number], \n        \"Dev_MSSQL_Server\"\n    )"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
