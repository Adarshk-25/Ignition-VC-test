{
  "custom": {},
  "params": {
    "tabValue": "value"
  },
  "propConfig": {
    "params.tabValue": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1600
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Cell Unloading_Template"
            },
            "props": {
              "path": "Page/Film_Wraping/Cell Unloading_Template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "DimensionMeasurement_Template"
            },
            "position": {
              "tabIndex": 1
            },
            "props": {
              "path": "Page/Film_Wraping/DimensionMeasurement_Template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "HiPot_template"
            },
            "position": {
              "tabIndex": 2
            },
            "props": {
              "path": "Page/Film_Wraping/HiPot_template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "WeightMeasurement_Template"
            },
            "position": {
              "tabIndex": 3
            },
            "props": {
              "path": "Page/Film_Wraping/WeightMeasurement_Template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Thickness Measurement_Template"
            },
            "position": {
              "tabIndex": 4
            },
            "props": {
              "path": "Page/Film_Wraping/ThicknessMeasurement_Template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "Laser Marking_Template"
            },
            "position": {
              "tabIndex": 5
            },
            "props": {
              "path": "Page/Film_Wraping/Laser Marking_Template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "EOL_Template"
            },
            "position": {
              "tabIndex": 6
            },
            "props": {
              "path": "Page/Film_Wraping/EOL_Template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "EOL_NG_Port_Template"
            },
            "position": {
              "tabIndex": 7
            },
            "props": {
              "path": "Page/Film_Wraping/EOL_NG_Port_Template"
            },
            "type": "ia.display.view"
          },
          {
            "meta": {
              "name": "OutputConveyor_Template"
            },
            "position": {
              "tabIndex": 8
            },
            "props": {
              "path": "Page/Film_Wraping/OutputConveyor_Template"
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "TabContainer"
        },
        "position": {
          "basis": "300px",
          "grow": 1
        },
        "propConfig": {
          "props.currentTabIndex": {
            "binding": {
              "config": {
                "path": "view.params.tabValue"
              },
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif currentValue !\u003d previousValue :\n\t\tself.session.custom.nav.currentPath \u003d self.props.tabs[self.props.currentTabIndex]"
            }
          }
        },
        "props": {
          "tabSize": {
            "height": 35,
            "width": 200
          },
          "tabs": [
            "Cell Unloading",
            "Dimension Check",
            "Hi Pot",
            "Weight Measurement",
            "Thickness Measurement",
            "Laser Marking",
            "EOL",
            "EOL NG Port",
            "Output Conveyor"
          ]
        },
        "type": "ia.container.tab"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}