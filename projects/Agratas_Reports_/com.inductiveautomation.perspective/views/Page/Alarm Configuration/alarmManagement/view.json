{
  "custom": {
    "selectedRow": null
  },
  "params": {
    "machineName": "/",
    "zoneId": "[default]Structure/Agratas/Sanand/zoneE"
  },
  "propConfig": {
    "params.machineName": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    },
    "params.zoneId": {
      "binding": {
        "config": {
          "path": "/root/dropDownFlex/alarmStatusDropDownArea.props.value"
        },
        "type": "property"
      },
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 1211,
      "width": 1321
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "alarmStatusDropDownSite"
            },
            "position": {
              "basis": "109px"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "1"
                  },
                  "transforms": [
                    {
                      "code": "\tnames\u003d[]\n\tresults\u003dsystem.tag.browse(\"[default]Structure/Agratas\")\n\tfor result in results.getResults():\n\t\tnames.append({\"value\":result[\u0027fullPath\u0027],\"label\":result[\u0027name\u0027]})\n\treturn names",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                },
                "onChange": {
                  "enabled": null,
                  "script": "\tif currentValue!\u003dpreviousValue:\n\t\tself.view.getChild(\"root\").custom.changedName\u003dcurrentValue"
                }
              },
              "props.value": {
                "onChange": {
                  "enabled": null,
                  "script": "    if currentValue !\u003d previousValue:\n        # Enable the dropdown\n       self.getSibling(\"alarmStatusDropDownArea\").props.enabled \u003d True\n       self.getSibling(\"alarmStatusDropDownArea\").props.value\u003dNone\n    else:\n        self.getSibling(\"alarmStatusDropDownArea\").props.enabled \u003d False"
                }
              }
            },
            "props": {
              "placeholder": {
                "color": "#000000",
                "text": "Select Site"
              },
              "style": {
                "borderColor": "var(--qual-2)"
              },
              "value": "[default]Structure/Agratas/Sanand"
            },
            "type": "ia.input.dropdown"
          },
          {
            "meta": {
              "contextMenu": {
                "enabled": true
              },
              "name": "alarmStatusDropDownArea"
            },
            "position": {
              "basis": "125px"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "{../alarmStatusDropDownSite.props.value}"
                  },
                  "transforms": [
                    {
                      "code": "\tnames\u003d[]\n\tresults\u003dsystem.tag.browse(value)\n\tfor result in results.getResults():\n\t\tnames.append({\"value\":result[\u0027fullPath\u0027],\"label\":result[\u0027name\u0027]})\n\treturn names",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.value": {
                "onChange": {
                  "enabled": null,
                  "script": "\tif currentValue!\u003dpreviousValue:\n\t\tself.getSibling(\"alarmStatusDropDownPLine\").props.enabled\u003dTrue\n\t\tself.getSibling(\"alarmStatusDropDownPLine\").props.value\u003dNone\n\telse:\n\t\tself.getSibling(\"alarmStatusDropDownPLine\").props.enabled\u003dFalse"
                }
              }
            },
            "props": {
              "placeholder": {
                "text": "Select Area"
              },
              "style": {
                "borderColor": "var(--qual-2)"
              },
              "value": "[default]Structure/Agratas/Sanand/zoneE"
            },
            "type": "ia.input.dropdown"
          },
          {
            "meta": {
              "name": "alarmStatusDropDownPLine"
            },
            "position": {
              "basis": "177px"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "{../alarmStatusDropDownArea.props.value}"
                  },
                  "transforms": [
                    {
                      "code": "\tnames\u003d[]\n\tresults\u003dsystem.tag.browse(value)\n\tfor result in results.getResults():\n\t\t#print(result[\u0027fullPath\u0027])\n\t\tnames.append({\"value\":result[\u0027fullPath\u0027],\"label\":result[\u0027name\u0027]})\n\treturn names",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
              "props.value": {
                "onChange": {
                  "enabled": null,
                  "script": "\tif currentValue!\u003dpreviousValue:\n\t\tself.getSibling(\"alarmStatusDropDownEName\").props.enabled\u003dTrue\n\t\tself.getSibling(\"alarmStatusDropDownEName\").props.value\u003dNone\n\telse:\n\t\tself.getSibling(\"alarmStatusDropDownEName\").props.enabled\u003dFalse"
                }
              }
            },
            "props": {
              "placeholder": {
                "color": "#000000",
                "text": "Select Production Line"
              },
              "style": {
                "borderColor": "var(--qual-2)"
              },
              "value": "[default]Structure/Agratas/Sanand/zoneE/Line2"
            },
            "type": "ia.input.dropdown"
          },
          {
            "meta": {
              "name": "alarmStatusDropDownEName"
            },
            "position": {
              "basis": "177px"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "{../alarmStatusDropDownPLine.props.value}"
                  },
                  "transforms": [
                    {
                      "code": "\tnames\u003d[]\n\tresults\u003dsystem.tag.browse(value)\n\tfor result in results.getResults():\n\t\t#print(result[\u0027fullPath\u0027])\n\t\tresult[\u0027fullPath\u0027]\u003dstr(result[\u0027fullPath\u0027]).replace(\"[default]\",\"\")\n\t\tnames.append({\"value\":\"*\"+result[\u0027fullPath\u0027]+\"*\",\"label\":result[\u0027name\u0027]})\n\treturn names",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "placeholder": {
                "color": "#000000",
                "text": "Select Production Line"
              },
              "style": {
                "borderColor": "var(--qual-2)"
              },
              "value": "*Structure/Agratas/Sanand/zoneE/Line2/machine2*"
            },
            "type": "ia.input.dropdown"
          }
        ],
