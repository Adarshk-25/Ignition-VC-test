                "sort": "descending",
                "strictWidth": false,
                "width": ""
              },
              {
                "enabled": true,
                "field": "Alarm Description",
                "order": 1,
                "sort": "none",
                "strictWidth": false,
                "width": ""
              },
              {
                "enabled": true,
                "field": "Troubleshoot",
                "order": 9,
                "sort": "none",
                "strictWidth": false,
                "width": ""
              }
            ]
