              },
              "label": {
                "order": 7
              },
              "name": {
                "enabled": false,
                "order": 1
              },
              "priority": {
                "enabled": false,
                "order": 9
              },
              "source": {
                "enabled": false
              },
              "state": {
                "order": 8
              }
            }
          },
          "columnsAssociated": {
            "active": [
              {
                "enabled": true,
                "field": "Alarm Group Id",
                "order": 2,
                "sort": "none",
                "strictWidth": true,
                "width": "10px"
              },
              {
                "enabled": true,
                "field": "Alarm Code",
                "order": 3,
                "sort": "none",
                "strictWidth": true,
                "width": "10px"
              },
              {
