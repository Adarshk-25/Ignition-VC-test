{
  "custom": {},
  "params": {
    "path": "/"
  },
  "propConfig": {
    "params.path": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 99,
      "width": 1409
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "   \tselected_data \u003d self.props.selection.active.data\n   \tif len(selected_data) \u003e 0:\n   \t\talarm_source \u003d selected_data[0].source\n   \tequipment_name \u003d alarm_source.split(\"tag:\", 1)[1]\n   \tif selected_data and str(equipment_name)\u003d\u003d\"IN11_E115_PCE_MIX21_IN11_E115_PCE/MIX21/AGAdmin/CurrentAlarms/Active_0:/alm:Alarm\":\n   \t\tpath\u003d\"/sanand/zone-e/mixing/anode-line-1/process-flow-1F-mixing\"\n   \t\tsystem.perspective.navigate(page\u003dpath)   \t\t\n    \t"
              },
              "enabled": false,
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "AlarmStatusTable"
        },
        "position": {
          "basis": "80px",
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
