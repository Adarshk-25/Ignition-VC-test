{
  "custom": {},
  "params": {
    "value": "value"
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 100,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "SimpleGauge"
        },
        "position": {
          "height": 0.95,
          "width": 1
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "arc": {
            "width": 5
          },
          "label": {
            "offsetX": 0.5,
            "size": 15
          }
        },
        "type": "ia.chart.simple-gauge"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "type": "ia.container.coord"
  }
}