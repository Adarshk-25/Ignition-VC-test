        },
        "position": {
          "basis": "35px"
        },
        "props": {
          "style": {
            "gap": "5px",
            "margin": "2px",
            "overflow": "hidden",
            "padding": "2px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "widgets/spacing"
      }
    },
    "type": "ia.container.flex"
  }
