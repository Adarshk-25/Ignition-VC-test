{
  "custom": {},
  "params": {
    "status": "value"
  },
  "propConfig": {
    "params.status": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 51,
      "width": 128
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "height": 0.4902,
          "width": 0.7813,
          "x": 0.067,
          "y": 0.2312
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "config": {
                "path": "view.params.status"
              },
              "transforms": [
                {
                  "code": "\n    return {\n        0: \"LightGray\",\n        1: \"limegreen\", \n        2:\"red\",\n        3: \"yellow\"  \n    }.get(value, \"LightGray\")",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.status} \u003d 2, \"Title/blink\", \"\")"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.status"
              },
              "transforms": [
                {
                  "code": "    try:\n        value \u003d int(value)\n    except:\n        return \"Unknown\"\n\n    return {\n        0: \"STOPPED\",\n        1: \"RUNNING\",\n        2: \"FAULT\",\n        3: \"MAINTENANCE\"\n    }.get(value, \"UNKNOWN\")",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderBottomLeftRadius": 10,
            "borderBottomRightRadius": 10,
            "borderColor": "#000000",
            "borderStyle": "groove",
            "borderTopLeftRadius": 10,
            "borderTopRightRadius": 10,
            "fontWeight": "bold",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.coord"
  }
}