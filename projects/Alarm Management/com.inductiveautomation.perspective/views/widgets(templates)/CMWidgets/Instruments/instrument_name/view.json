{
  "custom": {},
  "params": {
    "DisplayName": "Dewpoint",
    "instrument_ID": "123-380 "
  },
  "propConfig": {
    "params.DisplayName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.instrument_ID": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 26,
      "width": 50
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "DisplayName"
            },
            "position": {
              "basis": "65px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.DisplayName"
                  },
                  "type": "property"
                }
              },
              "props.textStyle.fontSize": {
                "binding": {
                  "config": {
                    "expression": "if(len({view.params.DisplayName})\u003c\u003d14,\"50%\",\"40%\")"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "textStyle": {
                "fontFamily": "sans-serif",
                "fontWeight": "normal",
                "textAlign": "center",
                "textTransform": "capitalize"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "backgroundColor": "#FFFFFF4F",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "ValUnit"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.instrument_ID"
              },
              "type": "property"
            }
          },
          "props.textStyle.fontSize": {
            "binding": {
              "config": {
                "expression": "if(len({view.params.instrument_ID})\u003c\u003d7,\"60%\",\"40%\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "color": "#0000FF",
            "fontFamily": "sans-serif",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#E8E8E8",
        "borderColor": "#AAAAAA",
        "borderStyle": "ridge",
        "borderWidth": "1px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}