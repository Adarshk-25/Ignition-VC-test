{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 250,
      "width": 250
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "apexchart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.options": {
            "persistent": true
          },
          "props.series": {
            "persistent": true
          }
        },
        "props": {
          "options": {
            "chart": {
              "stacked": false,
              "toolbar": {
                "show": false
              },
              "type": "bar"
            },
            "colors": [
              "#22C55E",
              "#F59E0B",
              "#EF4444"
            ],
            "dataLabels": {
              "enabled": false
            },
            "grid": {
              "borderColor": "#E5E7EB",
              "padding": {
                "bottom": 0,
                "left": 10,
                "right": 10,
                "top": 0
              },
              "strokeDashArray": 4
            },
            "legend": {
              "horizontalAlign": "center",
              "markers": {
                "radius": 15
              },
              "position": "bottom",
              "show": true
            },
            "plotOptions": {
              "bar": {
                "borderRadius": 4,
                "columnWidth": "45%"
              }
            },
            "title": {
              "align": "left",
              "style": {
                "color": "#111827",
                "fontSize": "12px",
                "fontWeight": "bold"
              },
              "text": "Day vs Value"
            },
            "xaxis": {
              "categories": [
                "Shift1",
                "Shift2",
                "Shift3",
                "Shift4",
                "Shift5",
                "Shift6",
                "Shift7",
                "Shift8"
              ],
              "labels": {
                "style": {
                  "colors": "#6B7280"
                }
              }
            },
            "yaxis": {
              "labels": {
                "style": {
                  "colors": "#6B7280"
                }
              },
              "max": 100,
              "min": 0
            }
          },
          "series": [
            {
              "data": [
                "70%",
                "75%",
                "80%",
                "78%",
                "76%",
                "79%",
                "77%",
                "78%"
              ],
              "name": "Skill Utilization"
            },
            {
              "data": [
                90,
                90,
                90,
                90,
                90,
                90,
                90,
                90
              ],
              "name": "Target"
            }
          ]
        },
        "type": "kyvislabs.display.apexchart"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}