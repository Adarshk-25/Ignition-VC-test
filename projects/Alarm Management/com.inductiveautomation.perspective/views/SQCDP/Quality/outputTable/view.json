        "events": {
          "component": {
            "onEditCellCommit": {
              "config": {
                "script": "# 1. Extract the edit details from the built-in event object\n\trow_index   \u003d event.rowIndex  # fixed: was event.row\n\tcolumn_name \u003d event.column   # fixed: was event.column\n\tnew_value   \u003d event.value  # fixed: was event.value\n\n# 2. Get the unique identifier (Primary Key) for the database row\n# This assumes you have a hidden or visible column named \u0027id\u0027 in your table data\n\trow_id \u003d self.props.data[row_index][\u0027SNo\u0027]\n\n# 3. Build your SQL Update Statement dynamically\n# Using a prepared statement prevents SQL injection vulnerabilities\n\tquery \u003d \"UPDATE [OEE_Summary2] SET [{}] \u003d ? WHERE [SNo] \u003d ?\".format(column_name)\n\targs  \u003d [new_value, row_id]\n\n# 4. Execute the update query\n\tsystem.db.runPrepUpdate(query, args, database\u003d\"Dev_MSSQL_Server\")\n\t#self.getSibling(\"Label\").props.text\u003dnew_value\n\n# 5. Force the table UI component to fetch the fresh data immediately\n\tself.refreshBinding(\"props.data\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
