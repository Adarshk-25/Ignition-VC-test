        "events": {
          "component": {
            "onEditCellCommit": {
              "config": {
                "script": "    row_index   \u003d event.rowIndex\n    column_name \u003d event.column\n    new_value   \u003d event.value\n\n    # Get row_id from props.data (this should always be available \n    # regardless of data source since it\u0027s loaded into the table)\n    row_id \u003d self.props.data[row_index][\u0027Sn\u0027]\n\n    # Fetch old value directly from DB instead of relying on props.data\n    query      \u003d \"SELECT [{}] FROM [PeopleActions] WHERE [Sn] \u003d ?\".format(column_name)\n    result     \u003d system.db.runPrepQuery(query, [row_id], database\u003d\"Dev_MSSQL_Server\")\n    old_value  \u003d result.getValueAt(0, 0) if result.rowCount \u003e 0 else \"N/A\"\n\n    # Open confirmation popup with accurate old value from DB\n    system.perspective.openPopup(\n        id      \u003d \"confirmEditPopup\",\n        view    \u003d \"SQCDP/confirmEdit\",\n        params  \u003d {\n            \"rowId\"      : row_id,\n            \"columnName\" : column_name,\n            \"oldValue\"   : str(old_value),\n            \"newValue\"   : str(new_value)\n        },\n        title         \u003d \"Confirm Edit\",\n        showCloseIcon \u003d False,\n        modal         \u003d True\n    )\n\n    # Revert UI immediately until user confirms\n    self.refreshBinding(\"props.data\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Table"
        },
        "position": {
          "grow": 1
        },
