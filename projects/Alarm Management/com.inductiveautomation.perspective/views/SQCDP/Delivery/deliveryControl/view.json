                  "config": {
                    "script": "\t# 1. Gather your input values from your Perspective UI components\n\tval1 \u003dself.getSibling(\"TextField\").props.text\n\tval2 \u003dself.getSibling(\"TextField_0\").props.text\n\tval3 \u003dself.getSibling(\"TextField_1\").props.text\n\tval4 \u003dself.getSibling(\"TextField_2\").props.text\n\tval5 \u003dself.getSibling(\"TextField_3\").props.text\n\n\n# 2. Define your parameterized SQL statement\n\tquery \u003d \"INSERT INTO ProcessEfficiency (SNo, Process, ChangeoverTime_Min,Downtime_Min,LineSpeedStability) VALUES (?, ?,?,?,?)\"\n\n# 3. List the arguments in the exact order of the question marks\n\targs \u003d [val1, val2,val3,val4,val5]\n\n# 4. Execute the update query \n# (Omit the database argument if you want to use the project\u0027s default database)\n\tsystem.db.runPrepUpdate(query, args, database\u003d\"Dev_MSSQL_Server\")\n\n# 5. Tell the Perspective Table component to refresh its data binding\n\t\n\t#self.parent.getChild(\"Table\").refreshBinding(\"props.data\")\n\tself.parent.parent.getChild(\"Table\").refreshBinding(\"props.data\")\n\tself.parent.position.display\u003dFalse\n\tself.parent.parent.getChild(\"Table\").position.display\u003dTrue\n\tself.parent.parent.getChild(\"FlexContainer\").position.display\u003dTrue"
