{
  "custom": {
    "popupOpen": false
  },
  "params": {
    "Screen_Path": 0,
    "Tag_Path": 0,
    "Title": 0,
    "ToolTip": 0
  },
  "propConfig": {
    "custom.popupOpen": {
      "persistent": true
    },
    "params.Screen_Path": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Tag_Path": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ToolTip": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 26,
      "width": 47
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tself.view.custom.popupOpen \u003d True"
              },
              "scope": "G",
              "type": "script"
            },
            "onMouseOut": {
              "config": {
                "script": "\tself.props.style.backgroundColor \u003d \"\""
              },
              "scope": "G",
              "type": "script"
            },
            "onMouseOver": {
              "config": {
                "script": "\tself.props.style.backgroundColor \u003d \"#D3D3D3\""
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Label",
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "height": 0.77,
          "width": 0.8936,
          "x": 0.0426,
          "y": 0.1154
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.ToolTip"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "Tag_Path": "{view.params.Tag_Path}"
                },
                "tagPath": "{Tag_Path}.Name"
              },
              "type": "tag"
            }
          },
          "props.textStyle.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if({view.custom.popupOpen}, \"#D3D3D3\", \"transparent\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "borderStyle": "outset",
            "borderWidth": 1,
            "classes": "Page/Label3",
            "paddingBottom": 9,
            "paddingLeft": 0,
            "paddingRight": 0,
            "paddingTop": 9,
            "resize": "both",
            "whiteSpace": "normal"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "draggable": true,
            "id": "LeiSbHz5",
            "modal": false,
            "overlayDismiss": false,
            "position": {
              "height": 800,
              "width": 1200
            },
            "positionType": "exact",
            "resizable": true,
            "showCloseIcon": true,
            "title": "{view.params.Title}",
            "type": "open",
            "viewParams": {
              "Screen_Path": "{view.params.Screen_Path}",
              "Tag_Path_0": "{view.params.Tag_Path}"
            },
            "viewPath": "Page/LaserNotching_Templates/PopUpScreensTemplate/ProcessScreenTemplate",
            "viewportBound": false
          },
          "scope": "C",
          "type": "popup"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "aspectRatio": "42:20",
      "mode": "percent",
      "style": {
        "alignItems": "stretch",
        "overflow": "hidden"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "popupClosed",
          "pageScope": true,
          "script": "\t# implement your handler here\n\tself.view.custom.popupOpen \u003d False",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.coord"
  }
}