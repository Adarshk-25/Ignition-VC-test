{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 65,
      "width": 65
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "height": 0.7231,
          "width": 0.7385,
          "x": 0.1046,
          "y": 0.2035
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "tagPath": "[default]agratas/Alarm Metrics.hasActiveUnackedCritical"
              },
              "transforms": [
                {
                  "fallback": "#000000",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "#FF4747"
                    },
                    {
                      "input": false,
                      "output": "#AAAAAA"
                    }
                  ],
                  "outputType": "color",
                  "type": "map"
                }
              ],
              "type": "tag"
            }
          }
        },
        "props": {
          "path": "sample-components/display-alarmStatusTable"
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "height": 0.2702,
          "width": 0.2444,
          "x": 0.6365,
          "y": 0.0263
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "now(1000)"
              },
              "transforms": [
                {
                  "code": "\t\t\n\talarms \u003d system.alarm.queryStatus()\n\tactive \u003d [a for a in alarms \n\t          if \"Active\" in str(a.state) \n\t          and \"prov:default:/tag:agratas/sanand\" in str(a.source)]\n\treturn  len(active)",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "alignVertical": "top",
          "style": {
            "fontSize": "18px"
          },
          "textStyle": {
            "alignSelf": "flex-end"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "page": "/alarmsManagement"
          },
          "scope": "C",
          "type": "nav"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "type": "ia.container.coord"
  }
