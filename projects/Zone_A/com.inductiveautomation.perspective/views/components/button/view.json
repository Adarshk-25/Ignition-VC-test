{
  "custom": {},
  "params": {
    "imgSource": "value",
    "key": {},
    "label": "value",
    "source": "value"
  },
  "propConfig": {
    "params.imgSource": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.key": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.source": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 62,
      "width": 207
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "page": "{view.params.source}"
              },
              "scope": "C",
              "type": "nav"
            }
          }
        },
        "meta": {
          "name": "Button"
        },
        "position": {
          "basis": "78px"
        },
        "propConfig": {
          "props.image.source": {
            "binding": {
              "config": {
                "path": "view.params.imgSource"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "height": 100,
            "icon": {
              "path": "material/login"
            },
            "style": {
              "fontSize": 25
            },
            "width": 50
          },
          "style": {
            "fontSize": 25
          }
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}