{
  "custom": {},
  "params": {
    "value": "{value}"
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 150
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.value} \u003d \"login\", \"#dcfce7\",\r\nif({view.params.value} \u003d \"logout\", \"#fee2e2\",\r\nif({view.params.value} \u003d \"project save\", \"#dbeafe\",\r\nif({view.params.value} \u003d \"resources modified\", \"#fef3c7\",\r\n\"#ede9fe\"))))"
                  },
                  "type": "expr"
                }
              },
              "props.style.color": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.value} \u003d \"login\", \"#166534\",\r\nif({view.params.value} \u003d \"logout\", \"#991b1b\",\r\nif({view.params.value} \u003d \"project save\", \"#1e40af\",\r\nif({view.params.value} \u003d \"resources modified\", \"#92400e\",\r\n\"#5b21b6\"))))"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.value"
                  },
                  "transforms": [
                    {
                      "code": "\n    value \u003d value or \"\"\n    return \" \".join(word.capitalize() for word in value.split())\n    ",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "alignItems": "center",
                "borderRadius": "16px",
                "display": "flex",
                "fontSize": "12px",
                "fontWeight": "500",
                "justifyContent": "center",
                "overflow": "hidden",
                "padding": " 4px 12px",
                "textAlign": "center",
                "whitespace": "nowrap"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "FlexContainer"
        },
        "position": {
          "height": 0.82,
          "width": 0.9733,
          "x": 0.0133,
          "y": 0.08
        },
        "props": {
          "justify": "center"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "mode": "percent"
    },
    "type": "ia.container.coord"
  }
}