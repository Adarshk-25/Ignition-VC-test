              "transforms": [
                {
                  "code": "\tds \u003d system.report.getReportNamesAsDataset()\n\t\n\toptions \u003d []\n\t\n\tfor row in range(ds.rowCount):\n\t    name \u003d ds.getValueAt(row, 0)\n\t    \n\t    options.append({\n\t        \"label\": name,\n\t        \"value\": name\n\t    })\n\t\n\treturn options",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
