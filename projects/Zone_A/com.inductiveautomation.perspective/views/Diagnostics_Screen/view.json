          "config": {
            "script": "\t# 1. Sync the UI values to the Custom Properties manually\n\tself.view.custom.equipment_id \u003d self.getSibling(\"Dropdown_Equipment\").props.value\n\tself.view.custom.unit_id \u003d self.getSibling(\"Dropdown_Unit\").props.value\n\tself.view.custom.shift_id \u003d self.getSibling(\"Dropdown_Shift\").props.value\n\tself.view.custom.start_date \u003d self.getSibling(\"DateTime_Start\").props.value\n\tself.view.custom.end_date \u003d self.getSibling(\"DateTime_End\").props.value\n\t\n\t# 2. Validation: Don\u0027t refresh if critical IDs are missing\n\tif self.view.custom.equipment_id is None or self.view.custom.shift_id is None:\n\t\tsystem.perspective.print(\"Validation Failed: Equipment or Shift not selected\")\n\telse:\n\t\tself.getSibling(\"ReportViewer\").refreshReport()"
          },
