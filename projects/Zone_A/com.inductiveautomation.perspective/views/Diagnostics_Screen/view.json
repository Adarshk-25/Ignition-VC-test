            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\n    # 1. FETCH \u0026 SYNC VALUES\n    # These names (Dropdown, Dropdown_0, etc.) match your Project Browser\n    equipment \u003d self.getSibling(\"Dropdown\").props.value      # Equipment Selection\n    unit \u003d self.getSibling(\"Dropdown_0\").props.value       # Unit Selection\n    shift \u003d self.getSibling(\"Dropdown_1\").props.value      # Shift Selection\n    start \u003d self.getSibling(\"Dropdown_2\").props.value      # Start Date Picker\n    end \u003d self.getSibling(\"Dropdown_3\").props.value        # End Date Picker\n    \n    # 2. UPDATE CUSTOM PROPERTIES\n    # These push the UI values to the root container for the ReportViewer to \u0027see\u0027\n    self.view.custom.equipment_id \u003d equipment\n    self.view.custom.unit_id \u003d unit\n    self.view.custom.shift_id \u003d shift\n    self.view.custom.start_date \u003d start\n    self.view.custom.end_date \u003d end\n    \n    # 3. VALIDATION LOGIC\n    # Prevents the \u0027Loading\u0027 hang seen in your video if a user forgets a selection\n    if None in [equipment, shift, start, end]:\n        # Log to the console for debugging\n        system.perspective.print(\"Validation Failed: One or more required filters are empty.\")\n    \n    elif start \u003e\u003d end:\n        # Prevents SQL errors from an invalid date range\n        system.perspective.print(\"Validation Failed: Start Date must be before End Date.\")\n        \n    else:\n        # 4. TRIGGER REPORT REFRESH\n        # This calls the 5-page report with the KPI Risk Summary\n        self.getSibling(\"ReportViewer\").refreshReport()\n        system.perspective.print(\"Report refreshed successfully.\")"
                  },
