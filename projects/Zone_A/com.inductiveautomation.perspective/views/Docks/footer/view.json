{
  "custom": {},
  "params": {
    "path": "/"
  },
  "propConfig": {
    "params.path": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "type": "property"
      },
      "paramDirection": "output",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 125
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AlarmStatusTable"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "props.filters.active.conditions.source": {
            "binding": {
              "config": {
                "expression": "\"*\"+{view.params.path}+\"*\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "columns": {
            "active": {
              "label": {
                "enabled": true
              },
              "source": {
                "enabled": false
              }
            }
          },
          "enableDetails": false,
          "enableHeader": false,
          "filters": {
            "active": {
              "conditions": {},
              "priorities": {
                "high": false,
                "low": false,
                "medium": false
              },
              "text": "active"
            }
          },
          "pager": {
            "enabled": false
          },
          "style": {
            "margin": "5px",
            "padding": "5px"
          },
          "toolbar": {
            "enableActiveTab": false,
            "enableConfiguration": false,
            "enableFilter": false,
            "enableFilterResults": false,
            "enablePreFilters": false,
            "enableShelvedTab": false
          }
        },
        "type": "ia.display.alarmstatustable"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "page": "/alarmsManagement"
          },
          "scope": "C",
          "type": "nav"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}