        "meta": {
          "name": "Tree"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.selectionData[0].value.path": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "page.props.path"
              },
              "type": "property"
            }
          },
          "props.selection[0]": {
            "binding": {
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "code": "\ttargetPath \u003d value.lstrip(\"/\")\n\t\n\tdef findPath(items, parent\u003d\"\"):\n\t    for i, item in enumerate(items):\n\t        indexPath \u003d parent + str(i)\n\t\n\t        if \"data\" in item and item[\"data\"].get(\"path\", \"\") \u003d\u003d targetPath:\n\t            return indexPath\n\t\n\t        if item.get(\"items\"):\n\t            result \u003d findPath(item[\"items\"], indexPath + \"/\")\n\t            if result:\n\t                return result\n\t\n\t    return None\n\t\n\ttreeItems \u003d self.props.items\n\tfound \u003d findPath(treeItems)\n\t\n\tif found:\n\t    return found\n\t\n\treturn None",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
