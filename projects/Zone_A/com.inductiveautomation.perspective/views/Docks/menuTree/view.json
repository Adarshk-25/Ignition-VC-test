            "onItemClicked": {
              "config": {
                "script": "\tselected \u003d self.props.selectionData[0].value.path\n\tsystem.perspective.navigate(page\u003d\"/{}\".format(selected))\n\tif self.page.props.path \u003d\u003d \u0027/alarmsManagement\u0027:\n\t\tsystem.perspective.closeDock(\"footerDock\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
