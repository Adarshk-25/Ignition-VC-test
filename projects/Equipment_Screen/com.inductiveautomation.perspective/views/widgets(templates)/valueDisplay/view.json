      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.screenPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag_TM": {
      "paramDirection": "input",
