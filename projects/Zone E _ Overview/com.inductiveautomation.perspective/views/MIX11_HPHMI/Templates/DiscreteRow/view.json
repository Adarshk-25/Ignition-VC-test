    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "stretch",
      "style": {
        "borderBottom": "1px solid #D2D2D2",
        "fontFamily": "Roboto, 'Segoe UI', Arial, sans-serif"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Code_1"
        },
        "position": {
          "basis": "112px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "fontFamily": "Roboto, 'Segoe UI', Arial, sans-serif",
            "fontSize": "11px",
            "color": "#333333",
