              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "\"HPHMI/Badge/\" + if({view.custom.alarms.worst} = \"none\", \"Info\", {view.custom.alarms.worst})"
                  }
                }
              },
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.alarms.count} > 0"
                  }
                }
              }
            }
