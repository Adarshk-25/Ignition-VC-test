                  "props.color": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.alarms.worst} = \"Critical\", \"#FFFFFF\", \"#1F2328\")"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Count"
                },
                "position": {
                  "basis": "auto",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "text": "0",
                  "style": {
                    "fontWeight": "700",
                    "fontSize": "14px"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "toStr({view.custom.alarms.count})"
