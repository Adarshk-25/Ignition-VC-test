        "meta": {
          "name": "Banner"
        },
        "position": {
          "basis": "48px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "wrap": "nowrap",
          "justify": "flex-start",
          "alignItems": "center",
          "alignContent": "flex-start",
          "style": {
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.icon",
            "meta": {
              "name": "StateIcon"
            },
            "position": {
              "basis": "28px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "path": "material/help_outline",
              "color": "#555C64",
              "style": {
                "minWidth": "28px",
                "height": "28px"
              }
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "case({view.custom.key}, \"Running\",\"material/play_arrow\", \"Stopped\",\"material/stop\", \"Starved\",\"material/hourglass_empty\", \"Blocked\",\"material/block\", \"OutOfService\",\"material/build\", \"NotAvailable\",\"material/remove_circle_outline\", \"material/help_outline\")"
                  }
                }
              },
              "props.color": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "case({view.custom.key}, \"Running\",\"#1F2328\", \"Starved\",\"#1F5FA8\", \"Blocked\",\"#1F5FA8\", \"NotAvailable\",\"#868C94\", \"#555C64\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "State"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "HPHMI/Popup/StateText"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "case({view.custom.key}, \"Running\",\"Running\", \"Stopped\",\"Stopped\", \"Starved\",\"Starved – no input\", \"Blocked\",\"Blocked – output\", \"OutOfService\",\"Out of service\", \"NotAvailable\",\"Not available\", \"No comm · bad quality\")"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Mode"
            },
