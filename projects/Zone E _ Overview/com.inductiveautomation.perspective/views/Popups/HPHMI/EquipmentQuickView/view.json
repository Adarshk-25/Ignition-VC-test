                "props": {
                  "path": "material/warning",
                  "color": "#1F2328",
                  "style": {
                    "minWidth": "18px",
                    "height": "18px"
                  }
                },
                "propConfig": {
                  "props.path": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "case({view.custom.alarms.worst}, \"Critical\",\"material/report\", \"Warning\",\"material/warning\", \"Advisory\",\"material/info\", \"material/notifications\")"
                      }
                    }
