      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Footer"
        },
        "position": {
          "basis": "56px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "wrap": "nowrap",
          "justify": "flex-start",
          "alignItems": "center",
          "alignContent": "flex-start",
          "style": {
            "classes": "HPHMI/Popup/Footer",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "TagRoot"
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "text": "",
              "style": {
                "classes": "HPHMI/Text/Muted"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.tagRoot"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "OpenArea"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "Open area screen",
              "primary": false,
              "image": {
                "icon": {
                  "path": "material/open_in_new",
                  "color": "#1F2328"
                },
                "position": "right",
                "width": 18,
                "height": 18
              },
              "style": {
                "classes": "HPHMI/Button/Secondary HPHMI/Button/Big"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tHPHMI_ZoneE.openAreaScreen(self.view.params.areaPage)"
                  }
                }
              }
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.params.areaPage} != \"\""
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "OpenFaceplate"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "Open faceplate",
              "primary": false,
              "image": {
                "icon": {
                  "path": "material/launch",
                  "color": "#FFFFFF"
                },
                "position": "right",
                "width": 18,
                "height": 18
              },
              "style": {
                "classes": "HPHMI/Button/Primary"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tHPHMI_ZoneE.openFaceplate(self.view.params.tagRoot)"
                  }
                }
              }
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.hasFaceplate"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "auto",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "text": "Close",
              "primary": false,
              "image": {
                "icon": {
                  "path": "",
                  "color": "#FFFFFF"
                },
                "position": "right",
                "width": 0,
                "height": 0
              },
              "style": {
                "classes": "HPHMI/Button/Primary"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.closePopup(\"hphmiQuickView\")"
                  }
                }
              }
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "!{view.params.hasFaceplate}"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  },
  "propConfig": {
    "custom.stateCode": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{root}/AGStatus/CurrentState",
          "references": {
            "root": "{view.params.tagRoot}"
          },
          "fallbackDelay": 2.5
        },
        "transforms": [
          {
            "type": "expression",
            "expression": "if(isGood({value}) && !isNull({value}), toInt({value}, -9), -9)"
          }
        ]
      }
    },
    "custom.modeCode": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{root}/AGStatus/CurrentMode",
          "references": {
            "root": "{view.params.tagRoot}"
          },
          "fallbackDelay": 2.5
        },
        "transforms": [
          {
            "type": "expression",
            "expression": "if(isGood({value}) && !isNull({value}), toInt({value}, -9), -9)"
          }
        ]
      }
    },
    "custom.starved": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{root}/AGStatus/EquipmentStarved",
          "references": {
            "root": "{view.params.tagRoot}"
          },
          "fallbackDelay": 2.5
        },
        "transforms": [
          {
            "type": "expression",
            "expression": "if(isGood({value}) && !isNull({value}), toBoolean({value}), false)"
          }
        ]
      }
    },
    "custom.blocked": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{root}/AGStatus/EquipmentBlocked",
          "references": {
            "root": "{view.params.tagRoot}"
          },
          "fallbackDelay": 2.5
        },
        "transforms": [
          {
            "type": "expression",
            "expression": "if(isGood({value}) && !isNull({value}), toBoolean({value}), false)"
          }
        ]
      }
    },
    "custom.key": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.params.tagRoot} = \"\", \"NoComm\",\n case({view.custom.stateCode},\n  3, if({view.custom.blocked}, \"Blocked\", if({view.custom.starved}, \"Starved\", \"Running\")),\n  2, if({view.custom.blocked}, \"Blocked\", if({view.custom.starved}, \"Starved\", \"Stopped\")),\n  1, \"OutOfService\", 0, \"NotAvailable\", \"NoComm\"))"
        }
      }
    },
    "custom.wo": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{root}/AGAdmin/ActiveWorkOrderID",
          "references": {
            "root": "{view.params.tagRoot}"
          },
          "fallbackDelay": 2.5
        },
        "transforms": [
          {
            "type": "expression",
            "expression": "if(isGood({value}) && !isNull({value}), toStr({value}), \"\")"
          }
        ]
      }
    },
    "custom.recipe": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{root}/AGAdmin/CurrentRecipeID",
          "references": {
            "root": "{view.params.tagRoot}"
          },
          "fallbackDelay": 2.5
        },
        "transforms": [
          {
            "type": "expression",
            "expression": "if(isGood({value}) && !isNull({value}), toStr({value}), \"\")"
          }
        ]
      }
    },
    "custom.mes": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "indirect",
          "tagPath": "{root}/AGStatus/MESRunning",
          "references": {
            "root": "{view.params.tagRoot}"
          },
          "fallbackDelay": 2.5
        },
        "transforms": [
          {
            "type": "expression",
            "expression": "if(isGood({value}) && !isNull({value}), toBoolean({value}), false)"
          }
        ]
      }
    },
    "custom.alarms": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(3000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\t# active alarms whose source is inside this unit\n\treturn HPHMI_ZoneE.unitAlarms(self.view.params.tagRoot)"
          }
        ]
      }
    },
    "custom.drives": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn HPHMI_ZoneE.driveStates(self.view.params.tagRoot)"
          }
        ]
      }
    },
    "params.tagRoot": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.unitId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.description": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.areaTitle": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.keyValues": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.kvRows": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.hasDrives": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.areaPage": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sim": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.hasFaceplate": {
      "paramDirection": "input",
      "persistent": true
    }
  }
}