{
  "base": {
    "style": {
      "backgroundImage": "linear-gradient(180deg, #5E7FA3 0%, #2E5C8A 100%)",
      "backgroundColor": "#2E5C8A",
      "border": "1px solid #1F4468",
      "borderRadius": "3px",
      "color": "#FFFFFF",
      "fontFamily": "Roboto, 'Segoe UI', Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": "600",
      "letterSpacing": "0.4px",
      "textTransform": "uppercase",
      "boxShadow": "0 1px 2px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.8)",
      "cursor": "pointer",
      "padding": "0 12px",
      "transition": "background-image 0.15s, box-shadow 0.15s"
    }
  },
  "variants": [
    {
      "pseudo": "hover",
      "style": {
        "backgroundImage": "linear-gradient(180deg, #6F92B8 0%, #386C9E 100%)",
        "borderColor": "#163552"
      }
    },
    {
      "pseudo": "active",
      "style": {
        "backgroundImage": "linear-gradient(180deg, #24496E 0%, #2E5C8A 100%)",
        "boxShadow": "inset 0 2px 3px rgba(0,0,0,0.45)"
      }
    },
    {
      "pseudo": "focus",
      "style": {
        "outline": "2px solid #2E5C8A",
        "outlineOffset": "1px"
      }
    },
    {
      "pseudo": "disabled",
      "style": {
        "backgroundImage": "none",
        "backgroundColor": "#E3E3E3",
        "color": "#9A9A9A",
        "borderColor": "#C2C2C2",
        "boxShadow": "none",
        "cursor": "not-allowed"
      }
    }
  ]
}