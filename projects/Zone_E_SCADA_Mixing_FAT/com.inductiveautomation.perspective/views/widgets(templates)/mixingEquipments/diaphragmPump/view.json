{
  "custom": {
    "Cmd": true,
    "Run_fb": true,
    "Stp_fb": false
  },
  "params": {
    "feet": "value",
    "name": "[default]agratas/sanand/zoneE/line1/mixing/equipments/Diaphragm pump",
    "orientation": "value",
    "textLocation": "bottom"
  },
  "propConfig": {
    "custom.Cmd": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "name": "{view.params.name}"
          },
          "tagPath": "{name}/Cmd"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Run_fb": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "name": "{view.params.name}"
          },
          "tagPath": "{name}/Run_fb"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.Stp_fb": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "name": "{view.params.name}"
          },
          "tagPath": "{name}/Stp_fb"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.feet": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.orientation": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.textLocation": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 100,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Pump"
        },
        "position": {
          "height": 1,
          "width": 1
        },
        "propConfig": {
          "props.feet": {
            "binding": {
              "config": {
                "path": "view.params.feet"
              },
              "type": "property"
            }
          },
          "props.label.location": {
            "binding": {
              "config": {
                "path": "view.params.textLocation"
              },
              "type": "property"
            }
          },
          "props.label.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "name": "{view.params.name}"
                },
                "tagPath": "{name}.name"
              },
              "type": "tag"
            }
          },
          "props.orientation": {
            "binding": {
              "config": {
                "path": "view.params.orientation"
              },
              "type": "property"
            }
          },
          "props.state": {
            "binding": {
              "config": {
                "expression": "if({view.custom.Cmd} \u0026\u0026 {view.custom.Run_fb}, \"running\",\r\nif({view.custom.Cmd}\u003d0 \u0026\u0026 {view.custom.Stp_fb}, \"stopped\",\r\nif({view.custom.Cmd} \u0026\u0026 {view.custom.Run_fb}\u003d0, \"faulted\",\r\nif({view.custom.Cmd}\u003d0 \u0026\u0026 {view.custom.Stp_fb}, \"faulted\",\r\n\"default\"))))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "appearance": "simple",
          "label": {
            "style": {
              "classes": "PipingAndInst/label"
            }
          },
          "value": {
            "location": "hidden",
            "style": {
              "fontFamily": "sans-serif",
              "fontSize": 5
            }
          },
          "variant": "vacuum"
        },
        "type": "ia.symbol.pump"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "aspectRatio": "100:100",
      "mode": "percent"
    },
    "type": "ia.container.coord"
  }
}