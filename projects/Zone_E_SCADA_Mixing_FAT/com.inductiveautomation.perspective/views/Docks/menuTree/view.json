            "onItemClicked": {
              "config": {
                "script": "#\tselection \u003d event.itemPath\n#\t\n#\tif not selection:\n#\t    return\n#\t\n#\ttree \u003d self.props.items\n#\t\n#\tbreadcrumb \u003d []\n#\tcurrent \u003d tree\n#\t\n#\tfor pos, idx in enumerate(selection):\n#\t\n#\t    i \u003d int(idx)\n#\t    node \u003d current[i]\n#\t\n##\t    breadcrumb.append({\n##\t        \"label\": node.get(\"label\"),\n##\t        \"path\": \"/\" + node.get(\"data\", {}).get(\"path\", \"\").lstrip(\"/\"),\n##\t        \"forwardDisplay\": pos \u003c len(selection) - 1\n##\t    })\n#\n#\t    breadcrumb.append({\n#\t        \"label\": node.get(\"label\"),\n#\t        \"path\": \"/\" + node.get(\"data\", {}).get(\"path\", \"\").lstrip(\"/\"),\n#\t        \"forwardDisplay\": pos \u003c len(selection) - 1\n#\t\t    \"level\": pos,\n##\t\t    \"selection\": selection[:pos + 1],\n##\t\t    \"hasChildren\": len(node.get(\"items\", [])) \u003e 0,\n##\t\t\n##\t\t    \"children\": [\n##\t\t        {\n##\t\t        \"label\": child.get(\"label\"),\n##\t\t        \"path\": \"/\" + child.get(\"data\", {}).get(\"path\", \"\").lstrip(\"/\"),\n##\t\t        \"selection\": selection[:pos + 1] + [childIndex],\n##\t\t        \"hasChildren\": len(child.get(\"items\", [])) \u003e 0\n##\t\t        }\n##\t\t        for childIndex, child in enumerate(node.get(\"items\", []))\n##\t\t    \t\t\t]\n#\t\t})\n#\t    current \u003d node.get(\"items\", [])\n#\t\n#\t# selected page path\n#\tselectedPath \u003d breadcrumb[-1][\"path\"]\n#\t\n#\t# store globally in session\n#\tself.session.custom.nav \u003d {\n#\t    \"selection\": selection,\n#\t    \"breadcrumb\": breadcrumb,\n#\t    \"currentPath\": selectedPath\n#\t}\n#\t\n#\t# navigate only if page is different\n#\tif self.page.props.path !\u003d selectedPath:\n#\t    system.perspective.navigate(page\u003dselectedPath)\n#\t\n#\t# optional\n#\tif selectedPath \u003d\u003d \"/alarms-management\":\n#\t    system.perspective.closeDock(\"footerDock\")\n\tselection \u003d event.itemPath\n\tselection \u003d list(selection)\n\t\n\tif not selection:\n\t    return\n\t\n\ttree \u003d self.props.items\n\t\n\tbreadcrumb \u003d []\n\tcurrent \u003d tree\n\t\n\tfor pos, idx in enumerate(selection):\n\t\n\t    i \u003d int(idx)\n\t    node \u003d current[i]\n\t\n\t    # Build child list\n\t    children \u003d []\n\t\n\t    for childIndex, child in enumerate(node.get(\"items\", [])):\n\t        children.append({\n\t            \"label\": child.get(\"label\"),\n\t            \"path\": \"/\" + child.get(\"data\", {}).get(\"path\", \"\").lstrip(\"/\"),\n\t            \"selection\": selection[:pos + 1] + [childIndex],\n\t            \"hasChildren\": len(child.get(\"items\", [])) \u003e 0\n\t        })\n\t\n\t    breadcrumb.append({\n\t        \"label\": node.get(\"label\"),\n\t        \"path\": \"/\" + node.get(\"data\", {}).get(\"path\", \"\").lstrip(\"/\"),\n\t        \"forwardDisplay\": pos \u003c len(selection) - 1,\n\t        \"level\": pos,\n\t        \"selection\": selection[:pos + 1],\n\t        \"hasChildren\": len(node.get(\"items\", [])) \u003e 0,\n\t        \"children\": children\n\t    })\n\t\n\t    current \u003d node.get(\"items\", [])\n\t\n\t# selected page path\n\tselectedPath \u003d breadcrumb[-1][\"path\"]\n\t\n\t# store globally in session\n\tself.session.custom.nav \u003d {\n\t    \"selection\": selection,\n\t    \"breadcrumb\": breadcrumb,\n\t    \"currentPath\": selectedPath\n\t}\n\t\n\t# navigate only if page is different\n\tif self.page.props.path !\u003d selectedPath:\n\t    system.perspective.navigate(page\u003dselectedPath)\n\t\n\t# optional\n\tif selectedPath \u003d\u003d \"/alarms-management\":\n\t    system.perspective.closeDock(\"footerDock\")"
              },
              "scope": "G",
              "type": "script"
            }
