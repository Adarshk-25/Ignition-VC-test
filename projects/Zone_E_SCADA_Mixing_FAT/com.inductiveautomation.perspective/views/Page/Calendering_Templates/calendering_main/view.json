{
  "custom": {},
  "params": {
    "tabValue": "value"
  },
  "propConfig": {
    "params.tabValue": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Outfeeder1_Screen"
        },
        "props": {
          "path": "Page/Calendering_Templates/Outfeeder1_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Outfeeder2_Screen"
        },
        "position": {
          "tabIndex": 1
        },
        "props": {
          "path": "Page/Calendering_Templates/Outfeeder2_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Unwinder_Screen"
        },
        "position": {
          "tabIndex": 2
        },
        "props": {
          "path": "Page/Calendering_Templates/Unwinder_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Transport_Screen"
        },
        "position": {
          "tabIndex": 3
        },
        "props": {
          "path": "Page/Calendering_Templates/Transport_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "ThicknessGauge_Screen"
        },
        "position": {
          "tabIndex": 4
        },
        "props": {
          "path": "Page/Calendering_Templates/ThicknessGauge_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Press_Screen"
        },
        "position": {
          "tabIndex": 5
        },
        "props": {
          "path": "Page/Calendering_Templates/Press_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Rewinder_Screen"
        },
        "position": {
          "tabIndex": 6
        },
        "props": {
          "path": "Page/Calendering_Templates/Rewinder_Screen"
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.currentTabIndex": {
        "binding": {
          "config": {
            "path": "view.params.tabValue"
          },
          "type": "property"
        },
        "onChange": {
          "enabled": null,
          "script": "\tif currentValue !\u003d previousValue :\n        \tself.session.custom.nav.currentPath \u003d self.props.tabs[self.props.currentTabIndex]\n "
        }
      }
    },
    "props": {
      "tabSize": {
        "width": 200
      },
      "tabs": [
        "Outfeeder I",
        "Outfeeder II",
        "Unwinder",
        "Transport",
        "Thickness Gauge",
        "Press Cathode",
        "Rewinder"
      ]
    },
    "type": "ia.container.tab"
  }
}