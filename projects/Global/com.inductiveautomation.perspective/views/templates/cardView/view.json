{
  "custom": {},
  "params": {
    "machineName": "value",
    "machineSpeed": "value",
    "productId": "value",
    "speedpercent": "value"
  },
  "propConfig": {
    "params.machineName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.machineSpeed": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.productId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.speedpercent": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 701,
      "width": 494
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tsystem.perspective.openPopup(\n    id\u003d\"machineDetails\",\n    view\u003d\"equipment_view_details\",   # your popup view name\n    params\u003d{\"machineName\": \"ColdPress1\"},\n    modal\u003dTrue,\n    draggable\u003dTrue,\n    resizable\u003dFalse,\n    position\u003d{\"top\": 100, \"left\": 200}\n)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Title"
                },
                "position": {
                  "basis": "32.5px"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.machineName"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "alignVertical": "top",
                  "style": {
                    "color": "#111827",
                    "fontSize": "22px",
                    "fontWeight": "600"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "productId"
                },
                "position": {
                  "basis": "9px"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "\"product Id: \" + {view.params.productId}"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "color": "#152734",
                    "fontSize": "13px",
                    "fontWeight": "400",
                    "marginBottom": "10px",
                    "marginLeft": "20px",
                    "marginTop": "-5px"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "machine speed"
                },
                "position": {
                  "basis": "16px"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "\"Machine Speed: \" + {view.params.machineSpeed} + \" m/min\""
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "color": "#3E3E3E",
                    "fontSize": "13px",
                    "fontWeight": "500",
                    "height": "20px",
                    "letterSpacing": "0.5px"
                  }
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Progress"
                },
                "position": {
                  "basis": "12px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.bar.color": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.machineSpeed} \u003c 20, \"#16A34A\",\r\n    if({view.params.machineSpeed} \u003c 40, \"#F59E0B\",\r\n        \"#DC2626\"))"
                      },
                      "type": "expr"
                    }
                  },
                  "props.value": {
                    "binding": {
                      "config": {
                        "path": "view.params.speedpercent"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "bar": {},
                  "style": {
                    "borderRadius": "8px",
                    "color": "#D5D5D5",
                    "fontWeight": "500",
                    "height": "10px",
                    "width": "150px"
                  },
                  "track": {
                    "backgroundColor": "",
                    "style": {
                      "backgroundColor": "#E2E8F0",
                      "borderRadius": "8px"
                    }
                  },
                  "valueDisplay": {
                    "format": "0,0"
                  }
                },
                "type": "ia.display.progress"
              }
            ],
            "meta": {
              "name": "HeaderContainer"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "alignContent": "flex-start",
              "alignItems": "flex-start",
              "direction": "column",
              "justify": "space-between",
              "style": {
                "marginBottom": "20px",
                "overflow": "hidden"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "FlexRepeater"
                },
                "position": {
                  "basis": "350px"
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "config": {
                        "expression": "[]"
                      },
                      "transforms": [
                        {
                          "code": "    results \u003d []\n\n    basePath \u003d \"[default]agratas/sanand/zoneE/calendering/anode/coldPress1/oee\"\n\n    tags \u003d system.tag.browse(basePath)\n\n    tagPaths \u003d []\n    tagNames \u003d []\n\n    for tag in tags.getResults():\n        tagPaths.append(str(tag[\u0027fullPath\u0027]))\n        tagNames.append(tag[\u0027name\u0027])\n\n    values \u003d system.tag.readBlocking(tagPaths)\n\n    for i in range(len(tagPaths)):\n        results.append({\n            \"title\": tagNames[i],\n            \"value\": values[i].value\n        })\n\n    return results",
                          "type": "script"
                        }
                      ],
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "path": "templates/innerTile",
                  "wrap": "wrap"
                },
                "type": "ia.display.flex-repeater"
              }
            ],
            "meta": {
              "name": "FlexContainer"
            },
            "position": {
              "basis": "400px"
            },
            "props": {
              "alignContent": "space-between",
              "justify": "space-between",
              "style": {
                "backgroundColor": "#F8FAFC",
                "borderRadius": "12px",
                "boxShadow": "0px 2px 8px rgba(0,0,0,0.25)",
                "overflow": "hidden",
                "width": 380
              },
              "wrap": "wrap"
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.tag.writeBlocking(\n\t    [\n\t        \"[default]agratas/sanand/zoneE/calendering/anode/coldPress1/status/running\",\n\t        \"[default]agratas/sanand/zoneE/calendering/anode/coldPress1/status/plannedStop\"\n\t    ],\n\t    [\n\t        True,\n\t        False\n\t    ]\n\t)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Button"
                },
                "position": {
                  "basis": "97px"
                },
                "props": {
                  "text": "Start"
                },
                "type": "ia.input.button"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tsystem.tag.writeBlocking(\n\t    [\n\t        \"[default]agratas/sanand/zoneE/calendering/anode/coldPress1/status/running\",\n\t        \"[default]agratas/sanand/zoneE/calendering/anode/coldPress1/status/plannedStop\"\n\t    ],\n\t    [\n\t        False,\n\t        True\n\t    ]\n\t)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "meta": {
                  "name": "Button_1"
                },
                "position": {
                  "basis": "93px"
                },
                "props": {
                  "text": "Stop"
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "FlexContainer_0"
            },
            "position": {
              "basis": "250px",
              "shrink": 0
            },
            "props": {
              "justify": "center",
              "style": {
                "gap": "12px",
                "margin": "20px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "MainContainer"
        },
        "position": {
          "basis": "651px",
          "shrink": 0
        },
        "props": {
          "style": {
            "backgroundColor": "#FFFFFF",
            "borderRadius": "16px",
            "boxShadow": "0px 6px 24px rgba(15,23,42,0.08)\n",
            "gap": "20px",
            "margin": "20px",
            "padding": "20px",
            "width": "450px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}