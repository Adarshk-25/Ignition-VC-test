{
  "custom": {},
  "params": {
    "tabValue": "value"
  },
  "propConfig": {
    "params.tabValue": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Outfeeder_Screen"
        },
        "props": {
          "path": "Page/Coating_Templates/Outfeeder_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "VisionInspectionUnit_Screen"
        },
        "position": {
          "tabIndex": 1
        },
        "props": {
          "path": "Page/Coating_Templates/VisionInspectionUnit_Screen"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Rewinder1 \u0026 2_Screen"
        },
        "position": {
          "tabIndex": 2
        },
        "props": {
          "path": "Page/Coating_Templates/Rewinder1 \u0026 2_Screen"
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.currentTabIndex": {
        "binding": {
          "config": {
            "path": "view.params.tabValue"
          },
          "type": "property"
        },
        "onChange": {
          "enabled": null,
          "script": "\tif currentValue !\u003d previousValue :\n        \tself.session.custom.nav.currentPath \u003d self.props.tabs[self.props.currentTabIndex]"
        }
      }
    },
    "props": {
      "tabSize": {
        "width": 300
      },
      "tabs": [
        "Outfeeder",
        "6th Inspection Unit",
        "Rewinder"
      ]
    },
    "type": "ia.container.tab"
  }
}