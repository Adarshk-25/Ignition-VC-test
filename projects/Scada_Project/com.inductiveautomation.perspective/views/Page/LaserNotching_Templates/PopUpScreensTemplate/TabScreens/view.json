        },
        "transforms": [
          {
            "code": "\tparentPath \u003d str(self.view.params.Tag_Path_0)\n\t\n\tif not parentPath:\n\t    return\n\t\n\t# Browse direct UDT instances under COR001\n\tresults \u003d system.tag.browse(\n\t    parentPath,\n\t    {\n\t        \"tagType\": \"UdtInstance\"\n\t    }\n\t)\n\t\n\tudtInstances \u003d list(results.getResults())\n\t\n\t# Process UDTs sequentially\n\tfor index, udt in enumerate(udtInstances):\n\t\n\t    udtPath \u003d str(udt[\"fullPath\"])\n\t\n\t    # Browse direct children of this UDT\n\t    childResults \u003d system.tag.browse(udtPath)\n\t\n\t    parameterData \u003d []\n\t\n\t    tagPaths \u003d []\n\t    tagNames \u003d []\n\t\n\t    for child in childResults.getResults():\n\t\n\t        if str(child[\"tagType\"]) \u003d\u003d \"AtomicTag\":\n\t\n\t            tagNames.append(str(child[\"name\"]))\n\t            tagPaths.append(str(child[\"fullPath\"]))\n\t\n\t    # Read all tag values\n\t    if tagPaths:\n\t\n\t        values \u003d system.tag.readBlocking(tagPaths)\n\t\n\t        for i in range(len(tagPaths)):\n\t\n\t            parameterData.append({\n\t                \"Parameter\": tagNames[i],\n\t                \"Value\": values[i].value\n\t            })\n\t\n\t    # Write sequentially:\n\t    # 0 → parameterData_0\n\t    # 1 → parameterData_1\n\t    # 2 → parameterData_2\n\t    # ...\n\t    propertyName \u003d \"parameterData_\" + str(index)\n\t\n\t    self.view.custom[propertyName] \u003d parameterData",
            "type": "script"
          }
        ],
        "type": "property"
      },
