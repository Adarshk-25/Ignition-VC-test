    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.tabs": {
        "binding": {
          "config": {
            "struct": {
              "currentIndex": "{this.props.currentTabIndex}",
              "tagPath": "{view.params.Tag_Path_0}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\n    # --------------------------------------------------\n    # Get values from Expression Structure\n    # --------------------------------------------------\n    if value is None:\n        return []\n\n    parentPath \u003d str(value[\"tagPath\"])\n\n    currentIndex \u003d value[\"currentIndex\"]\n\n    if currentIndex is None:\n        currentIndex \u003d 0\n\n    currentIndex \u003d int(currentIndex)\n\n    if not parentPath:\n        return []\n\n    # --------------------------------------------------\n    # Browse only UDT Instances\n    # --------------------------------------------------\n    results \u003d system.tag.browse(\n        parentPath,\n        {\n            \"tagType\": \"UdtInstance\"\n        }\n    )\n\n    udtInstances \u003d results.getResults()\n\n    tabs \u003d []\n\n    # --------------------------------------------------\n    # Tooltip data\n    # --------------------------------------------------\n    manData \u003d self.view.params.Man_Data\n\n    # IMPORTANT:\n    # This index represents ENABLED UDTs only.\n    tabIndex \u003d 0\n\n    # --------------------------------------------------\n    # Process UDT instances\n    # --------------------------------------------------\n    for item in udtInstances:\n\n        udtPath \u003d str(item[\"fullPath\"])\n\n        # --------------------------------------------------\n        # Check UDT Instance Enabled property\n        # --------------------------------------------------\n        enabledPath \u003d udtPath + \".enabled\"\n\n        enabledResult \u003d system.tag.readBlocking(\n            [enabledPath]\n        )[0]\n\n        if not enabledResult.value:\n            continue\n\n        # --------------------------------------------------\n        # Get tooltip\n        # --------------------------------------------------\n        toolTipText \u003d \"\"\n\n        if manData is not None:\n\n            if tabIndex \u003c len(manData):\n\n                dataItem \u003d manData[tabIndex]\n\n                if dataItem is not None:\n\n                    toolTipText \u003d str(\n                        dataItem.get(\n                            \"tab_tooltip\",\n                            \"\"\n                        )\n                    )\n\n        # --------------------------------------------------\n        # Create Tab\n        # --------------------------------------------------\n        tabs.append({\n\n            \"viewPath\": \"widgets(templates)/TabButton\",\n\n            \"viewParams\": {\n\n                # Tab text\n                \"tabText\": str(item[\"name\"]),\n\n                # Tooltip\n                \"toolTipText\": toolTipText,\n\n                # Selected state\n                \"tabSelected\": (\n                    tabIndex \u003d\u003d currentIndex\n                )\n            },\n\n            \"runWhileHidden\": False\n        })\n\n        # Next ENABLED UDT\n        tabIndex +\u003d 1\n\n    return tabs",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "props": {
      "currentTabIndex": -1,
      "tabSize": {
        "width": 120
      }
    },
    "type": "ia.container.tab"
  }
