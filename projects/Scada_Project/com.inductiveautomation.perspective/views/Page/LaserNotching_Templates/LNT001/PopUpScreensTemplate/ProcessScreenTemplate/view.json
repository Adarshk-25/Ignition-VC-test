{
  "custom": {},
  "events": {
    "system": {
      "onShutdown": {
        "config": {
          "script": "\tsystem.perspective.sendMessage(\n\t    \"PopupClosed\",\n\t    scope\u003d\"page\"\n\t)"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {
    "Screen_Path": "value",
    "Tag_Path_0": "value"
  },
  "propConfig": {
    "params.Screen_Path": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Tag_Path_0": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 1600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "ProcessTemplate"
        },
        "propConfig": {
          "props.params.tag": {
            "binding": {
              "config": {
                "path": "view.params.Tag_Path_0"
              },
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.Screen_Path"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "TrendsTemplate"
        },
        "position": {
          "tabIndex": 1
        },
        "propConfig": {
          "props.params.path": {
            "binding": {
              "config": {
                "path": "view.params.Tag_Path_0"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "Page/LaserNotching_Templates/PopUpScreensTemplate/TrendsTemplate"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "PopUpTemplateView"
        },
        "position": {
          "tabIndex": 3
        },
        "propConfig": {
          "props.params.parameterData[0].ActualValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "Tag": "{view.params.metadata}"
                },
                "tagPath": "{Tag}/NodesetVersion"
              },
              "type": "tag"
            }
          },
          "props.params.parameterData[1].ActualValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "Tag": "{view.params.metadata}"
                },
                "tagPath": "{Tag}/PLCManufacturer"
              },
              "type": "tag"
            }
          },
          "props.params.parameterData[2].ActualValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "Tag": "{view.params.metadata}"
                },
                "tagPath": "{Tag}/PLCModel"
              },
              "type": "tag"
            }
          },
          "props.params.parameterData[3].ActualValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "Tag": "{view.params.metadata}"
                },
                "tagPath": "{Tag}/PLCFBS"
              },
              "type": "tag"
            }
          },
          "props.params.parameterData[4].ActualValue": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "Tag": "{view.params.metadata}"
                },
                "tagPath": "{Tag}/YearOfConstruction"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "params": {
            "equipmentGraphic": "widgets(templates)/LaserWidgets/UnwinderNotchingNew",
            "equipmentName": "COR001 : A Core",
            "parameterData": [
              {
                "Parameter": "Nodeset Version"
              },
              {
                "Parameter": "PLC Manufacturer"
              },
              {
                "Parameter": "PLC Model"
              },
              {
                "Parameter": "PLC FBS"
              },
              {
                "Parameter": "Year Of Construction"
              }
            ],
            "tableHeader": "PLC Information"
          },
          "path": "Page/LaserNotching_Templates/PopUpScreensTemplate/PopUpTemplateView"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "AlarmsTemplate"
        },
        "position": {
          "tabIndex": 2
        },
        "propConfig": {
          "props.params.tagpath": {
            "binding": {
              "config": {
                "path": "view.params.Tag_Path_0"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "Page/LaserNotching_Templates/PopUpScreensTemplate/AlarmsTemplate"
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "tabSize": {
        "width": 120
      },
      "tabs": [
        "Process Data",
        "Trends",
        "Alarms"
      ]
    },
    "type": "ia.container.tab"
  }
}