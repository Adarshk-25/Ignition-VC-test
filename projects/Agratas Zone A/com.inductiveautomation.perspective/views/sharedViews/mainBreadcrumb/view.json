{
  "custom": {},
  "params": {
    "path": "/"
  },
  "propConfig": {
    "params.path": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "type": "property"
      },
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "basis": "46px"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.params.path"
              },
              "transforms": [
                {
                  "code": "\tpath \u003d value or \"\"\n\t\n\t# Remove leading/trailing slashes\n\tpath \u003d path.strip(\"/\")\n\t\n\t# Split into parts\n\tparts \u003d path.split(\"/\") if path else []\n\t\n\titems \u003d []\n\t\n\t# Always add Home\n\titems.append({\n\t    \"label\": \"Home\",\n\t    \"target\": \"/\"\n\t})\n\t\n\t# Build progressive paths\n\tcurrent \u003d \"\"\n\t\n\tfor part in parts:\n\t    current \u003d part if current \u003d\u003d \"\" else current + \"/\" + part\n\t    \n\t    items.append({\n\t        \"label\": part,\n\t        \"target\": current\n\t    })\n\t\n\treturn items",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "elementPosition": {
            "basis": 1,
            "grow": 0,
            "shrink": 0
          },
          "path": "sharedViews/breadcrumb",
          "style": {
            "overflow": "hidden"
          },
          "useDefaultViewHeight": false
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "center",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}