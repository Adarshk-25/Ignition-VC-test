      {
        "events": {
          "component": {
            "onItemClicked": {
              "config": {
                "script": "\tselection \u003d event.itemPath\n\t\n\tif not selection:\n\t    return\n\t\n\ttree \u003d self.props.items\n\t\n\tbreadcrumb \u003d []\n\tcurrent \u003d tree\n\t\n\tfor pos, idx in enumerate(selection):\n\t\n\t    i \u003d int(idx)\n\t    node \u003d current[i]\n\t\n\t    breadcrumb.append({\n\t        \"label\": node.get(\"label\"),\n\t        \"path\": \"/\" + node.get(\"data\", {}).get(\"path\", \"\").lstrip(\"/\"),\n\t        \"forwardDisplay\": pos \u003c len(selection) - 1\n\t    })\n\t\n\t    current \u003d node.get(\"items\", [])\n\t\n\t# selected page path\n\tselectedPath \u003d breadcrumb[-1][\"path\"]\n\t\n\t# store globally in session\n\tself.session.custom.nav \u003d {\n\t    \"selection\": selection,\n\t    \"breadcrumb\": breadcrumb,\n\t    \"currentPath\": selectedPath\n\t}\n\t\n\t# navigate only if page is different\n\tif self.page.props.path !\u003d selectedPath:\n\t    system.perspective.navigate(page\u003dselectedPath)\n\t\n\t# optional\n\tif selectedPath \u003d\u003d \"/alarms-management\":\n\t    system.perspective.closeDock(\"footerDock\")"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Tree"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.selectionData[0].value.path": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "page.props.path"
              },
              "type": "property"
            }
          },
          "props.selection[0]": {
            "binding": {
              "config": {
                "path": "page.props.path"
              },
              "transforms": [
                {
                  "code": "\ttargetPath \u003d self.page.props.path.strip(\"/\")\n\t\n\tdef findPath(items, parent\u003d\"\"):\n\t    for i, item in enumerate(items):\n\t        indexPath \u003d parent + str(i)\n\t\n\t        itemPath \u003d item.get(\"data\", {}).get(\"path\", \"\").strip(\"/\")\n\t\n\t        # ✅ Match full path\n\t        if itemPath \u003d\u003d targetPath:\n\t            return indexPath\n\t\n\t        # ✅ Recursive search\n\t        if item.get(\"items\"):\n\t            result \u003d findPath(item[\"items\"], indexPath + \"/\")\n\t            if result:\n\t                return result\n\t\n\t    return None\n\t\n\t\n\ttreeItems \u003d self.props.items\n\t\n\tfound \u003d findPath(treeItems)\n\t\n\tif found:\n\t    return found\n\t\n\treturn None",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
