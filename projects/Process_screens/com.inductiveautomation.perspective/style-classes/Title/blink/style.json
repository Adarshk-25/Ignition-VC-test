{
  "base": {
    "animation": {
      "duration": "1s",
      "keyframes": {
        "0%": {
          "borderColor": "#000000",
          "borderStyle": "solid",
          "borderWidth": "5px"
        },
        "100%": {
          "borderColor": "#FFFFFF",
          "borderStyle": "solid",
          "borderWidth": "5px",
          "opacity": "1"
        }
      }
    }
  }
}