{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n\r\n<script src=\"https://cdn.jsdelivr.net/npm/apexcharts\"></script>\r\n\r\n<style>\r\n\r\nbody{\r\nmargin:0;\r\nfont-family:Segoe UI, sans-serif;\r\nbackground:transparent;\r\ncolor:#1f2937;\r\n}\r\n\r\n/* KPI CARDS */\r\n\r\n.kpiRow{\r\ndisplay:flex;\r\ngap:20px;\r\nmargin-bottom:20px;\r\n}\r\n\r\n.kpi{\r\nflex:1;\r\nbackground:white;\r\nborder-radius:10px;\r\npadding:18px;\r\nbox-shadow:0 2px 6px rgba(0,0,0,0.08);\r\nborder-left:6px solid #4f46e5;\r\n}\r\n\r\n.kpi h3{\r\nmargin:0;\r\nfont-size:14px;\r\ncolor:#6b7280;\r\n}\r\n\r\n.kpi h1{\r\nmargin:5px 0 0 0;\r\nfont-size:36px;\r\n}\r\n\r\n\r\n/* GRID */\r\n\r\n.grid{\r\ndisplay:grid;\r\ngrid-template-columns:1fr 1fr;\r\ngap:20px;\r\nmargin-bottom:20px;\r\n}\r\n\r\n\r\n/* CARD */\r\n\r\n.card{\r\nbackground:white;\r\nborder-radius:10px;\r\npadding:18px;\r\nbox-shadow:0 2px 6px rgba(0,0,0,0.08);\r\n}\r\n\r\n\r\n/* CALENDAR */\r\n\r\n.calendar{\r\ndisplay:grid;\r\ngrid-template-columns:repeat(7,1fr);\r\ngap:6px;\r\nmargin-top:10px;\r\n}\r\n\r\n.day{\r\npadding:12px;\r\ntext-align:center;\r\nborder-radius:6px;\r\nfont-weight:600;\r\n}\r\n\r\n.green{\r\nbackground:#dcfce7;\r\ncolor:#166534;\r\n}\r\n\r\n.red{\r\nbackground:#fee2e2;\r\ncolor:#991b1b;\r\n}\r\n\r\n.white{\r\nbackground:#f1f5f9;\r\n}\r\n\r\n\r\n/* TABLE */\r\n\r\ntable{\r\nwidth:100%;\r\nborder-collapse:collapse;\r\n}\r\n\r\nth{\r\nbackground:#f3f4f6;\r\npadding:12px;\r\ntext-align:left;\r\nfont-size:13px;\r\n}\r\n\r\ntd{\r\npadding:10px;\r\nborder-bottom:1px solid #e5e7eb;\r\nfont-size:13px;\r\n}\r\n\r\n.statusOpen{\r\ncolor:#ef4444;\r\nfont-weight:600;\r\n}\r\n\r\n.statusClosed{\r\ncolor:#22c55e;\r\nfont-weight:600;\r\n}\r\n\r\n</style>\r\n\r\n</head>\r\n\r\n<body>\r\n\r\n\r\n<!-- KPI ROW -->\r\n\r\n<div class=\"kpiRow\">\r\n\r\n<div class=\"kpi\">\r\n<h3>Total Incidents</h3>\r\n<h1>5</h1>\r\n</div>\r\n\r\n<div class=\"kpi\">\r\n<h3>Days Without Incident</h3>\r\n<h1>12</h1>\r\n</div>\r\n\r\n<div class=\"kpi\">\r\n<h3>Last Incident (Days)</h3>\r\n<h1>2</h1>\r\n</div>\r\n\r\n</div>\r\n\r\n\r\n\r\n<!-- CALENDAR + TREND -->\r\n\r\n<div class=\"grid\">\r\n\r\n<div class=\"card\">\r\n\r\n<h3>Safety Calendar</h3>\r\n\r\n<div id=\"calendar\" class=\"calendar\"></div>\r\n\r\n</div>\r\n\r\n\r\n<div class=\"card\">\r\n\r\n<h3>Incident Trend</h3>\r\n\r\n<div id=\"incidentChart\"></div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n\r\n\r\n<!-- INCIDENT TABLE -->\r\n\r\n<div class=\"card\">\r\n\r\n<h3>Incident Log</h3>\r\n\r\n<table>\r\n\r\n<thead>\r\n\r\n<tr>\r\n<th>Date</th>\r\n<th>Incident Type</th>\r\n<th>Area</th>\r\n<th>Severity</th>\r\n<th>Status</th>\r\n<th>Owner</th>\r\n</tr>\r\n\r\n</thead>\r\n\r\n<tbody>\r\n\r\n<tr>\r\n<td>2026-03-01</td>\r\n<td>PPE Violation</td>\r\n<td>Line A</td>\r\n<td>Low</td>\r\n<td class=\"statusClosed\">Closed</td>\r\n<td>Supervisor A</td>\r\n</tr>\r\n\r\n<tr>\r\n<td>2026-03-03</td>\r\n<td>Slip Hazard</td>\r\n<td>Warehouse</td>\r\n<td>Medium</td>\r\n<td class=\"statusOpen\">Open</td>\r\n<td>Safety Officer</td>\r\n</tr>\r\n\r\n<tr>\r\n<td>2026-03-05</td>\r\n<td>Machine Guard Missing</td>\r\n<td>Line B</td>\r\n<td>High</td>\r\n<td class=\"statusOpen\">Open</td>\r\n<td>Maintenance</td>\r\n</tr>\r\n\r\n<tr>\r\n<td>2026-03-07</td>\r\n<td>Forklift Near Miss</td>\r\n<td>Dispatch</td>\r\n<td>Medium</td>\r\n<td class=\"statusClosed\">Closed</td>\r\n<td>Safety Officer</td>\r\n</tr>\r\n\r\n<tr>\r\n<td>2026-03-10</td>\r\n<td>Oil Spill</td>\r\n<td>Line C</td>\r\n<td>Low</td>\r\n<td class=\"statusClosed\">Closed</td>\r\n<td>Maintenance</td>\r\n</tr>\r\n\r\n</tbody>\r\n\r\n</table>\r\n\r\n</div>\r\n\r\n\r\n\r\n<script>\r\n\r\n\r\n/* INCIDENT DAYS */\r\n\r\nconst incidentDays = [3,11,18]; \r\n\r\n\r\n/* CALENDAR GENERATION */\r\n\r\nconst calendar = document.getElementById(\"calendar\");\r\n\r\nfor(let i=1;i<=31;i++){\r\n\r\nlet div = document.createElement(\"div\");\r\n\r\ndiv.classList.add(\"day\");\r\n\r\nif(incidentDays.includes(i)){\r\n\r\ndiv.classList.add(\"red\");\r\n\r\n}else{\r\n\r\ndiv.classList.add(\"green\");\r\n\r\n}\r\n\r\ndiv.innerText=i;\r\n\r\ncalendar.appendChild(div);\r\n\r\n}\r\n\r\n\r\n\r\n/* INCIDENT TREND CHART */\r\n\r\nvar options = {\r\n\r\nchart:{\r\ntype:'line',\r\nheight:300,\r\ntoolbar:{show:false}\r\n},\r\n\r\nseries:[{\r\nname:'Incidents',\r\ndata:[0,1,0,2,0,1,1]\r\n}],\r\n\r\ncolors:['#4f46e5'],\r\n\r\nstroke:{\r\nwidth:3\r\n},\r\n\r\nxaxis:{\r\ncategories:['Mon','Tue','Wed','Thu','Fri','Sat','Sun']\r\n}\r\n\r\n};\r\n\r\nnew ApexCharts(document.querySelector(\"#incidentChart\"), options).render();\r\n\r\n\r\n</script>\r\n\r\n\r\n</body>\r\n</html>"
}