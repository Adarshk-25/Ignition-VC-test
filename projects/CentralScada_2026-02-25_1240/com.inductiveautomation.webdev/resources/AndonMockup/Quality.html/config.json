{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n\r\n<style>\r\n\r\nbody{\r\nmargin:0;\r\nfont-family:Segoe UI;\r\nbackground:transparent;\r\ncolor:#1f2937;\r\n}\r\n\r\n.container{\r\ndisplay:grid;\r\ngrid-template-columns:2fr 1fr;\r\ngap:25px;\r\n}\r\n\r\n/* CALENDAR */\r\n\r\n.calendar{\r\ndisplay:grid;\r\ngrid-template-columns:repeat(7,1fr);\r\ngap:10px;\r\n}\r\n\r\n.day{\r\nheight:80px;\r\ndisplay:flex;\r\nalign-items:center;\r\njustify-content:center;\r\nfont-size:20px;\r\nfont-weight:600;\r\nborder-radius:6px;\r\n}\r\n\r\n/* COLORS */\r\n\r\n.green{\r\nbackground:#bbf7d0;\r\ncolor:#166534;\r\n}\r\n\r\n.red{\r\nbackground:#fecaca;\r\ncolor:#7f1d1d;\r\n}\r\n\r\n.white{\r\nbackground:#f1f5f9;\r\ncolor:#475569;\r\n}\r\n\r\n/* KPI */\r\n\r\n.stats{\r\ndisplay:flex;\r\nflex-direction:column;\r\ngap:20px;\r\n}\r\n\r\n.card{\r\nbackground:white;\r\nborder-radius:10px;\r\npadding:25px;\r\ntext-align:center;\r\nbox-shadow:0 2px 6px rgba(0,0,0,0.08);\r\n}\r\n\r\n.card.green{\r\nborder-top:6px solid #22c55e;\r\n}\r\n\r\n.card.red{\r\nborder-top:6px solid #ef4444;\r\n}\r\n\r\n.card.gray{\r\nborder-top:6px solid #94a3b8;\r\n}\r\n\r\n.card h2{\r\nmargin:0;\r\nfont-size:18px;\r\n}\r\n\r\n.card h1{\r\nmargin:10px 0;\r\nfont-size:60px;\r\n}\r\n\r\n.subtitle{\r\nfont-size:12px;\r\ncolor:#6b7280;\r\n}\r\n\r\n.month{\r\nfont-size:30px;\r\nfont-weight:700;\r\nmargin-bottom:20px;\r\ntext-align:center;\r\n}\r\n\r\n</style>\r\n\r\n</head>\r\n\r\n<body>\r\n\r\n\r\n<div class=\"container\">\r\n\r\n<!-- CALENDAR -->\r\n\r\n<div>\r\n\r\n<div class=\"calendar\" id=\"calendar\"></div>\r\n\r\n</div>\r\n\r\n\r\n<!-- STATS -->\r\n\r\n<div>\r\n\r\n<div class=\"month\">JAN</div>\r\n\r\n<div class=\"stats\">\r\n\r\n<div class=\"card green\">\r\n<h2>Total Good Days</h2>\r\n<h1 id=\"greenCount\">0</h1>\r\n<div class=\"subtitle\">MONTH TO DATE</div>\r\n</div>\r\n\r\n<div class=\"card red\">\r\n<h2>Quality Issue Days</h2>\r\n<h1 id=\"redCount\">0</h1>\r\n<div class=\"subtitle\">MONTH TO DATE</div>\r\n</div>\r\n\r\n<div class=\"card gray\">\r\n<h2>Days Since Quality Issue</h2>\r\n<h1 id=\"safeDays\">0</h1>\r\n<div class=\"subtitle\">WITHOUT DEFECT SPIKE</div>\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n\r\n\r\n<script>\r\n\r\n/* QUALITY ISSUE DAYS */\r\n\r\nconst defectDays = [4,7,12,18,24];\r\n\r\n\r\n/* GENERATE CALENDAR */\r\n\r\nconst calendar=document.getElementById(\"calendar\");\r\n\r\nlet greenCount=0;\r\nlet redCount=0;\r\n\r\nfor(let i=1;i<=31;i++){\r\n\r\nlet div=document.createElement(\"div\");\r\n\r\ndiv.classList.add(\"day\");\r\n\r\nif(defectDays.includes(i)){\r\n\r\ndiv.classList.add(\"red\");\r\nredCount++;\r\n\r\n}else{\r\n\r\ndiv.classList.add(\"green\");\r\ngreenCount++;\r\n\r\n}\r\n\r\ndiv.innerText=i;\r\n\r\ncalendar.appendChild(div);\r\n\r\n}\r\n\r\n\r\n/* UPDATE COUNTERS */\r\n\r\ndocument.getElementById(\"greenCount\").innerText=greenCount;\r\ndocument.getElementById(\"redCount\").innerText=redCount;\r\n\r\n\r\n/* DAYS SINCE LAST QUALITY ISSUE */\r\n\r\nlet today=31;\r\n\r\nlet lastIssue=Math.max(...defectDays);\r\n\r\nlet daysSince=today-lastIssue;\r\n\r\ndocument.getElementById(\"safeDays\").innerText=daysSince;\r\n\r\n</script>\r\n\r\n\r\n</body>\r\n</html>"
}