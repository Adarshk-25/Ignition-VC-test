  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Sanand – Zone E Command Center</title>\r\n<script src=\"https://cdn.jsdelivr.net/npm/apexcharts\"></script>\r\n\r\n<style>\r\n\r\nbody{\r\nmargin:0;\r\nfont-family:\"Segoe UI\",Arial;\r\nbackground:#F4F5F7;\r\ncolor:#2F3438;\r\n}\r\n\r\n.main{\r\npadding:20px;\r\n}\r\n\r\n/* KPI STRIP */\r\n\r\n.kpi-grid{\r\ndisplay:grid;\r\ngrid-template-columns:repeat(6,1fr);\r\ngap:12px;\r\nmargin-bottom:20px;\r\n}\r\n\r\n.kpi-card{\r\nbackground:#fff;\r\npadding:12px;\r\nborder-radius:6px;\r\nborder:1px solid #E3E6EA;\r\n}\r\n\r\n.kpi-card h5{\r\nmargin:0;\r\nfont-size:10px;\r\ntext-transform:uppercase;\r\ncolor:#7A828A;\r\n}\r\n\r\n.kpi-card h2{\r\nmargin-top:4px;\r\nfont-size:18px;\r\n}\r\n\r\n/* SECTION */\r\n\r\n.section{\r\nbackground:#fff;\r\nborder:1px solid #E3E6EA;\r\nborder-radius:6px;\r\npadding:15px;\r\nmargin-bottom:18px;\r\n}\r\n\r\n.section-title{\r\nfont-size:11px;\r\nfont-weight:600;\r\nmargin-bottom:12px;\r\ntext-transform:uppercase;\r\ncolor:#7A828A;\r\n}\r\n\r\n/* MACHINE GRID */\r\n\r\n.machine-grid{\r\ndisplay:grid;\r\ngrid-template-columns:repeat(4,1fr);\r\ngap:12px;\r\n}\r\n\r\n.machine{\r\nborder:1px solid #E5E7EB;\r\nborder-radius:6px;\r\npadding:12px;\r\nfont-size:12px;\r\ntransition:.15s;\r\ncursor:pointer;\r\n}\r\n\r\n.machine:hover{\r\nbox-shadow:0 2px 6px rgba(0,0,0,.1);\r\n}\r\n\r\n/* STATES */\r\n\r\n.running{\r\nbackground:#ECFDF5;\r\nborder-left:5px solid #10B981;\r\n}\r\n\r\n.idle{\r\nbackground:#FFFBEB;\r\nborder-left:5px solid #F59E0B;\r\n}\r\n\r\n.fault{\r\nbackground:#FEF2F2;\r\nborder-left:5px solid #EF4444;\r\n}\r\n\r\n.machine-header{\r\ndisplay:flex;\r\njustify-content:space-between;\r\nfont-weight:600;\r\nmargin-bottom:6px;\r\n}\r\n\r\n.metrics{\r\ndisplay:grid;\r\ngrid-template-columns:1fr 1fr;\r\ngap:4px;\r\nfont-size:11px;\r\n}\r\n\r\n.grid-2{\r\ndisplay:grid;\r\ngrid-template-columns:1fr 1fr;\r\ngap:16px;\r\nmargin-top:20px;\r\n}\r\n\r\na{\r\ntext-decoration:none;\r\ncolor:inherit;\r\n}\r\n\r\n</style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"main\">\r\n\r\n<!-- KPI STRIP -->\r\n\r\n<div class=\"kpi-grid\">\r\n\r\n<div class=\"kpi-card\"><h5>Zone OEE</h5><h2>78%</h2></div>\r\n<div class=\"kpi-card\"><h5>Availability</h5><h2>85%</h2></div>\r\n<div class=\"kpi-card\"><h5>Performance</h5><h2>80%</h2></div>\r\n<div class=\"kpi-card\"><h5>Quality</h5><h2>96%</h2></div>\r\n<div class=\"kpi-card\"><h5>Active Machines</h5><h2>7</h2></div>\r\n<div class=\"kpi-card\"><h5>Downtime</h5><h2>12%</h2></div>\r\n\r\n</div>\r\n\r\n\r\n<!-- MIXING -->\r\n\r\n<div class=\"section\">\r\n\r\n<div class=\"section-title\">Mixing</div>\r\n\r\n<div class=\"machine-grid\">\r\n\r\n<a href=\"http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/Sanand/\">\r\n<div class=\"machine running\">\r\n<div class=\"machine-header\">Mixing Tank A <span>Running</span></div>\r\n<div class=\"metrics\">\r\n<div>RPM</div><div>1200</div>\r\n<div>Temp</div><div>32°C</div>\r\n<div>Batch</div><div>OK</div>\r\n<div>Status</div><div>Active</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"Sanand/ZoneE/Mixing/MixingTankB\">\r\n<div class=\"machine idle\">\r\n<div class=\"machine-header\">Mixing Tank B <span>Idle</span></div>\r\n<div class=\"metrics\">\r\n<div>RPM</div><div>0</div>\r\n<div>Temp</div><div>29°C</div>\r\n<div>Batch</div><div>Waiting</div>\r\n<div>Status</div><div>Idle</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"Sanand/ZoneE/Mixing/SlurryPumpA\">\r\n<div class=\"machine running\">\r\n<div class=\"machine-header\">Slurry Pump A <span>Running</span></div>\r\n<div class=\"metrics\">\r\n<div>Flow</div><div>22L</div>\r\n<div>Pressure</div><div>3.2</div>\r\n<div>Batch</div><div>Active</div>\r\n<div>Status</div><div>Normal</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"Sanand/ZoneE/Mixing/SlurryPumpB\">\r\n<div class=\"machine fault\">\r\n<div class=\"machine-header\">Slurry Pump B <span>Fault</span></div>\r\n<div class=\"metrics\">\r\n<div>Flow</div><div>0</div>\r\n<div>Pressure</div><div>0</div>\r\n<div>Alarm</div><div>Pump Fault</div>\r\n<div>Status</div><div>Stopped</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n</div>\r\n</div>\r\n\r\n\r\n<!-- CALENDARING -->\r\n\r\n<div class=\"section\">\r\n\r\n<div class=\"section-title\">Calendaring</div>\r\n\r\n<div class=\"machine-grid\">\r\n\r\n<a href=\"Sanand/ZoneE/Calendaring/Anode/ColdPress1\">\r\n<div class=\"machine running\">\r\n<div class=\"machine-header\">ColdPress1 <span>Running</span></div>\r\n<div class=\"metrics\">\r\n<div>Pressure</div><div>180</div>\r\n<div>Temp</div><div>85°C</div>\r\n<div>OEE</div><div>90%</div>\r\n<div>Status</div><div>Normal</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"Sanand/ZoneE/Calendaring/Anode/ColdPress2\">\r\n<div class=\"machine idle\">\r\n<div class=\"machine-header\">ColdPress2 <span>Idle</span></div>\r\n<div class=\"metrics\">\r\n<div>Pressure</div><div>0</div>\r\n<div>Temp</div><div>70°C</div>\r\n<div>OEE</div><div>82%</div>\r\n<div>Status</div><div>Idle</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"Sanand/ZoneE/Calendaring/Cathode/HotPress\">\r\n<div class=\"machine running\">\r\n<div class=\"machine-header\">HotPress <span>Running</span></div>\r\n<div class=\"metrics\">\r\n<div>Pressure</div><div>200</div>\r\n<div>Temp</div><div>92°C</div>\r\n<div>OEE</div><div>88%</div>\r\n<div>Status</div><div>Normal</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n</div>\r\n</div>\r\n\r\n\r\n<!-- SLITTING -->\r\n\r\n<div class=\"section\">\r\n\r\n<div class=\"section-title\">Slitting</div>\r\n\r\n<div class=\"machine-grid\">\r\n\r\n<a href=\"Sanand/ZoneE/Slitting/AnodeSlitter\">\r\n<div class=\"machine running\">\r\n<div class=\"machine-header\">Anode Slitter</div>\r\n<div class=\"metrics\">\r\n<div>Speed</div><div>120 m/min</div>\r\n<div>Output</div><div>420</div>\r\n<div>Status</div><div>Running</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"Sanand/ZoneE/Slitting/CathodeSlitter\">\r\n<div class=\"machine idle\">\r\n<div class=\"machine-header\">Cathode Slitter</div>\r\n<div class=\"metrics\">\r\n<div>Speed</div><div>0</div>\r\n<div>Output</div><div>0</div>\r\n<div>Status</div><div>Idle</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n</div>\r\n</div>\r\n\r\n\r\n<!-- NOTCHING -->\r\n\r\n<div class=\"section\">\r\n\r\n<div class=\"section-title\">Notching</div>\r\n\r\n<div class=\"machine-grid\">\r\n\r\n<a href=\"Sanand/ZoneE/Notching/Anode\">\r\n<div class=\"machine running\">\r\n<div class=\"machine-header\">Anode Notching</div>\r\n<div class=\"metrics\">\r\n<div>Speed</div><div>95</div>\r\n<div>Output</div><div>380</div>\r\n<div>Status</div><div>Running</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"Sanand/ZoneE/Notching/Cathode\">\r\n<div class=\"machine running\">\r\n<div class=\"machine-header\">Cathode Notching</div>\r\n<div class=\"metrics\">\r\n<div>Speed</div><div>102</div>\r\n<div>Output</div><div>410</div>\r\n<div>Status</div><div>Running</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n</div>\r\n</div>\r\n\r\n\r\n<!-- ANALYTICS -->\r\n\r\n<div class=\"grid-2\">\r\n\r\n<div class=\"section\">\r\n<div class=\"section-title\">Hourly OEE</div>\r\n<div id=\"oeeTrend\"></div>\r\n</div>\r\n\r\n<div class=\"section\">\r\n<div class=\"section-title\">Downtime Breakdown</div>\r\n<div id=\"downtimeChart\"></div>\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n\r\n<script>\r\n\r\nnew ApexCharts(document.querySelector(\"#oeeTrend\"),{\r\nchart:{type:'line',height:220,toolbar:{show:false}},\r\nseries:[{name:'OEE',data:[70,72,75,78,79,78]}],\r\nxaxis:{categories:['06','07','08','09','10','11']},\r\nyaxis:{max:100},\r\ncolors:['#0052CC']\r\n}).render();\r\n\r\nnew ApexCharts(document.querySelector(\"#downtimeChart\"),{\r\nchart:{type:'donut',height:220},\r\nseries:[30,25,18,15,12],\r\nlabels:['Material','Power','Sensor','Operator','Maintenance']\r\n}).render();\r\n\r\n</script>\r\n\r\n</body>\r\n</html>"
}