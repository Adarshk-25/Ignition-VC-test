                      "code": "\tdef getColor(label, value):\n\t    \n\t    # Remove % if present\n\t    try:\n\t        num \u003d float(str(value).replace(\"%\",\"\").replace(\",\",\"\"))\n\t    except:\n\t        return \"#2C2C2C\"\n\t    \n\t    if label in [\"PLANT OEE\", \"AVAILABILITY\", \"PERFORMANCE\", \"QUALITY\"]:\n\t        if num \u003e\u003d 90:\n\t            return \"#2E7D32\"   # Green\n\t        elif num \u003e\u003d 75:\n\t            return \"#F9A825\"   # Amber\n\t        else:\n\t            return \"#C62828\"   # Red\n\t    \n\t    if label \u003d\u003d \"REJECTION %\":\n\t        if num \u003c\u003d 2:\n\t            return \"#2E7D32\"\n\t        elif num \u003c\u003d 5:\n\t            return \"#F9A825\"\n\t        else:\n\t            return \"#C62828\"\n\t    \n\t    if label \u003d\u003d \"TARGET GAP\":\n\t        if num \u003e\u003d 0:\n\t            return \"#2E7D32\"\n\t        elif num \u003e\u003d -500:\n\t            return \"#F9A825\"\n\t        else:\n\t            return \"#C62828\"\n\t    \n\t    return \"#2C2C2C\"\n\t\n\t\n\tdata \u003d [\n\t    (\"PLANT OEE\", \"82%\"),\n\t    (\"AVAILABILITY\", \"88%\"),\n\t    (\"PERFORMANCE\", \"79%\"),\n\t    (\"QUALITY\", \"95%\"),\n\t    (\"PRODUCTION TODAY\", \"14,250\"),\n\t    (\"TARGET GAP\", \"-1,200\"),\n\t    (\"REJECTION %\", \"3.2%\"),\n\t    (\"ENERGY (MW)\", \"1.2\")\n\t]\n\t\n\tinstances \u003d []\n\t\n\tfor label, value in data:\n\t    instances.append({\n\t        \"instanceStyle\": {\"classes\": \"\"},\n\t        \"instancePosition\": {},\n\t        \"label\": label,\n\t        \"value\": value,\n\t        \"color\": getColor(label, value)\n\t    })\n\t\n\treturn instances",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
