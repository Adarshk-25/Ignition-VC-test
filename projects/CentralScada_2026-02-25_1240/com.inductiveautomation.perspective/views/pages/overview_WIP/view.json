                {
                  "code": "\t# Raw downtime minutes (same as your HTML)\n\trawData \u003d {\n\t    \"Zone A\": [120, 95, 60, 40, 25],\n\t    \"Zone B\": [150, 80, 75, 30, 20],\n\t    \"Zone E\": [100, 70, 55, 35, 18]\n\t}\n\t\n\treasons \u003d [\n\t    \"Material Jam\",\n\t    \"Power Trip\",\n\t    \"Sensor Fault\",\n\t    \"No Material\",\n\t    \"Maintenance\"\n\t]\n\t\n\tzones \u003d [\"Zone A\", \"Zone B\", \"Zone E\"]\n\t\n\t# Convert minutes to percentage\n\tdef convertToPercent(data):\n\t    total \u003d sum(data)\n\t    return [(v / float(total)) * 100 for v in data]\n\t\n\t# Build percent data per zone\n\tzonePercents \u003d {}\n\tfor zone in zones:\n\t    zonePercents[zone] \u003d convertToPercent(rawData[zone])\n\t\n\t# Build series structure for Apex\n\tseries \u003d []\n\t\n\tfor i in range(len(reasons)):\n\t    series.append({\n\t        \"name\": reasons[i],\n\t        \"data\": [\n\t            round(zonePercents[\"Zone A\"][i], 1),\n\t            round(zonePercents[\"Zone B\"][i], 1),\n\t            round(zonePercents[\"Zone E\"][i], 1)\n\t        ]\n\t    })\n\t\n\treturn series",
                  "type": "script"
                }
              ],
              "type": "expr"
            },
            "persistent": true
          }
