{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Cathode 1 Line – Mixing Process 3D</title>\n<style>\n  * { margin:0; padding:0; box-sizing:border-box; }\n  body { background:#040810; overflow:hidden; }\n  #container { width:100vw; height:100vh; }\n\n  .label {\n    background: rgba(5,15,35,0.88);\n    color: #99ccff;\n    padding: 2px 7px;\n    border: 1px solid #1a4a80;\n    border-radius: 2px;\n    font: 10px/1.4 'Courier New', monospace;\n    pointer-events: none;\n    white-space: nowrap;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n  .label-floor {\n    color: #33aaff;\n    font: bold 14px 'Courier New', monospace;\n    letter-spacing: 3px;\n    background: rgba(0,20,50,0.7);\n    padding: 3px 12px;\n    border-left: 3px solid #33aaff;\n    pointer-events: none;\n  }\n  .label-flow {\n    color: #dd44ff;\n    font: 10px 'Courier New', monospace;\n    background: rgba(30,0,50,0.8);\n    padding: 2px 7px;\n    border: 1px solid #880099;\n    pointer-events: none;\n  }\n\n  #hud {\n    position:absolute; top:0; left:0; right:0;\n    display:flex; align-items:center; justify-content:space-between;\n    padding:10px 20px;\n    background: linear-gradient(180deg, rgba(4,8,16,0.95) 0%, transparent 100%);\n    pointer-events:none;\n  }\n  #hud-title {\n    color:#cc55ff;\n    font: bold 15px 'Courier New', monospace;\n    letter-spacing: 4px;\n    text-shadow: 0 0 12px #aa33ff, 0 0 24px #6600cc;\n  }\n  #hud-sub { color:#3a6a9a; font:10px 'Courier New',monospace; letter-spacing:2px; margin-top:3px; }\n  #hud-right { text-align:right; }\n  #hud-status { color:#22cc66; font:10px 'Courier New',monospace; letter-spacing:1px; }\n  #hint {\n    position:absolute; bottom:12px; left:50%; transform:translateX(-50%);\n    color:#2a4a6a; font:10px 'Courier New',monospace; letter-spacing:1px;\n    pointer-events:none;\n  }\n  #legend {\n    position:absolute; bottom:12px; right:16px;\n    background:rgba(4,12,28,0.88);\n    border:1px solid #1a3050;\n    padding:8px 12px;\n    pointer-events:none;\n  }\n  .leg-row { display:flex; align-items:center; gap:8px; margin:3px 0; font:9px 'Courier New',monospace; color:#4a7aaa; }\n  .leg-dot { width:8px; height:8px; border-radius:50%; }\n</style>\n</head>\n<body>\n<div id=\"container\"></div>\n\n<div id=\"hud\">\n  <div>\n    <div id=\"hud-title\">CATHODE 1 LINE — MIXING PROCESS</div>\n    <div id=\"hud-sub\">ZONE E › MIXING › CATHODE 1 LINE</div>\n  </div>\n  <div id=\"hud-right\">\n    <div id=\"hud-status\">● PROCESS RUNNING</div>\n    <div class=\"leg-row\" style=\"color:#3a6a9a;margin-top:4px;\" id=\"hud-date\"></div>\n  </div>\n</div>\n\n<div id=\"hint\">DRAG — rotate &nbsp;|&nbsp; SCROLL — zoom &nbsp;|&nbsp; RIGHT DRAG — pan</div>\n\n<div id=\"legend\">\n  <div class=\"leg-row\"><div class=\"leg-dot\" style=\"background:#cc33ee\"></div>MATERIAL FLOW</div>\n  <div class=\"leg-row\"><div class=\"leg-dot\" style=\"background:#7a8899\"></div>EQUIPMENT</div>\n  <div class=\"leg-row\"><div class=\"leg-dot\" style=\"background:#33aaff\"></div>FLOOR LEVEL</div>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.134.0/build/three.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.134.0/examples/js/controls/OrbitControls.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.134.0/examples/js/renderers/CSS2DRenderer.js\"></script>\n<script>\ndocument.getElementById('hud-date').textContent = new Date().toLocaleString();\n\n// ─────────────────────────────────────────────────────────────────────────────\n// SCENE BOOTSTRAP\n// ─────────────────────────────────────────────────────────────────────────────\nconst W = window.innerWidth, H = window.innerHeight;\nconst container = document.getElementById('container');\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.setSize(W, H);\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\nrenderer.toneMapping = THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure = 1.1;\ncontainer.appendChild(renderer.domElement);\n\nconst labelRenderer = new THREE.CSS2DRenderer();\nlabelRenderer.setSize(W, H);\nlabelRenderer.domElement.style.cssText = 'position:absolute;top:0;pointer-events:none;';\ncontainer.appendChild(labelRenderer.domElement);\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x040810);\nscene.fog = new THREE.FogExp2(0x040810, 0.014);\n\nconst camera = new THREE.PerspectiveCamera(48, W / H, 0.1, 500);\ncamera.position.set(10, 16, 26);\ncamera.lookAt(0, 5, 0);\n\nconst controls = new THREE.OrbitControls(camera, renderer.domElement);\ncontrols.target.set(0, 5, 0);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.07;\ncontrols.minDistance = 8;\ncontrols.maxDistance = 60;\ncontrols.update();\n\n// ─────────────────────────────────────────────────────────────────────────────\n// LIGHTING\n// ─────────────────────────────────────────────────────────────────────────────\nscene.add(new THREE.AmbientLight(0x102030, 1.0));\n\nconst sun = new THREE.DirectionalLight(0xffeedd, 1.4);\nsun.position.set(12, 22, 18);\nsun.castShadow = true;\nsun.shadow.mapSize.set(2048, 2048);\nsun.shadow.camera.near = 1;\nsun.shadow.camera.far = 80;\nsun.shadow.camera.left = -20;\nsun.shadow.camera.right = 20;\nsun.shadow.camera.top = 20;\nsun.shadow.camera.bottom = -20;\nscene.add(sun);\n\nconst fillA = new THREE.PointLight(0x4488ff, 0.8, 35);\nfillA.position.set(-6, 10, 4);\nscene.add(fillA);\n\nconst fillB = new THREE.PointLight(0xcc33ff, 0.5, 28);\nfillB.position.set(6, 2, -2);\nscene.add(fillB);\n\nconst fillC = new THREE.PointLight(0x00ffcc, 0.3, 20);\nfillC.position.set(0, 14, 0);\nscene.add(fillC);\n\n// ─────────────────────────────────────────────────────────────────────────────\n// MATERIALS\n// ─────────────────────────────────────────────────────────────────────────────\nconst MAT = {\n  metal:   () => new THREE.MeshPhongMaterial({ color:0x7a8899, shininess:90, specular:0x223344 }),\n  darkMet: () => new THREE.MeshPhongMaterial({ color:0x3a4455, shininess:50 }),\n  tank:    () => new THREE.MeshPhongMaterial({ color:0x8899aa, shininess:140, specular:0x446688 }),\n  pipe:        new THREE.MeshPhongMaterial({ color:0xcc33ee, shininess:120, emissive:0x440055, specular:0xff88ff }),\n  pipeGray:    new THREE.MeshPhongMaterial({ color:0x556677, shininess:60 }),\n  floor:       new THREE.MeshPhongMaterial({ color:0x0d1e35, transparent:true, opacity:0.72, side:THREE.DoubleSide }),\n  struct:      new THREE.MeshPhongMaterial({ color:0x1a2d44 }),\n};\n\n// ─────────────────────────────────────────────────────────────────────────────\n// UTILITY\n// ─────────────────────────────────────────────────────────────────────────────\nfunction label(text, pos, cls = 'label') {\n  const div = document.createElement('div');\n  div.className = cls;\n  div.innerHTML = text;\n  const obj = new THREE.CSS2DObject(div);\n  obj.position.copy(pos);\n  scene.add(obj);\n  return obj;\n}\n\nfunction pipe(p1, p2, r = 0.09, mat = MAT.pipe) {\n  const dir = new THREE.Vector3().subVectors(p2, p1);\n  const len = dir.length();\n  if (len < 0.001) return;\n  const geo = new THREE.CylinderGeometry(r, r, len, 10);\n  const mesh = new THREE.Mesh(geo, mat);\n  mesh.position.copy(new THREE.Vector3().addVectors(p1, p2).multiplyScalar(0.5));\n  mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0), dir.normalize());\n  mesh.castShadow = true;\n  scene.add(mesh);\n  return mesh;\n}\n\nconst v3 = (x,y,z) => new THREE.Vector3(x,y,z);\n\n// ─────────────────────────────────────────────────────────────────────────────\n// STRUCTURAL SHELL\n// ─────────────────────────────────────────────────────────────────────────────\nfunction buildStructure() {\n  // Floor plates + grids\n  const floorData = [\n    { y:0,   tag:'1F' },\n    { y:4.8, tag:'2F' },\n    { y:9.6, tag:'3F' },\n  ];\n  floorData.forEach(({y, tag}) => {\n    const floorMesh = new THREE.Mesh(new THREE.PlaneGeometry(20, 13), MAT.floor.clone());\n    floorMesh.rotation.x = -Math.PI / 2;\n    floorMesh.position.set(0, y, 0);\n    floorMesh.receiveShadow = true;\n    scene.add(floorMesh);\n\n    const grid = new THREE.GridHelper(20, 10, 0x0d2840, 0x081420);\n    grid.position.set(0, y + 0.01, 0);\n    scene.add(grid);\n\n    const flDiv = document.createElement('div');\n    flDiv.className = 'label-floor';\n    flDiv.textContent = tag;\n    const flObj = new THREE.CSS2DObject(flDiv);\n    flObj.position.set(-9.5, y + 0.1, 5);\n    scene.add(flObj);\n  });\n\n  // Columns\n  [[-8.5, 5.5], [-8.5,-5.5], [8.5,5.5], [8.5,-5.5]].forEach(([x,z]) => {\n    const col = new THREE.Mesh(new THREE.BoxGeometry(0.22, 14, 0.22), MAT.struct);\n    col.position.set(x, 7, z);\n    scene.add(col);\n  });\n\n  // Beams per floor\n  [0, 4.8, 9.6].forEach(y => {\n    [-5.5, 5.5].forEach(z => {\n      const beam = new THREE.Mesh(new THREE.BoxGeometry(18, 0.18, 0.18), MAT.struct);\n      beam.position.set(0, y, z);\n      scene.add(beam);\n    });\n  });\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// EQUIPMENT BUILDERS\n// ─────────────────────────────────────────────────────────────────────────────\nfunction makeHopper(x, y, z, topR, botR, h, lbl) {\n  const g = new THREE.Group();\n  const body = new THREE.Mesh(new THREE.CylinderGeometry(botR, topR, h, 18), MAT.metal());\n  body.castShadow = true;\n  g.add(body);\n  // rim at top\n  const rim = new THREE.Mesh(new THREE.TorusGeometry(topR, 0.06, 8, 20), MAT.darkMet());\n  rim.position.y = h / 2;\n  g.add(rim);\n  // outlet stub\n  const stub = new THREE.Mesh(new THREE.CylinderGeometry(botR*0.5, botR*0.5, 0.45, 10), MAT.darkMet());\n  stub.position.y = -(h/2 + 0.22);\n  g.add(stub);\n  // legs\n  for (let i=0; i<3; i++) {\n    const a = (i/3)*Math.PI*2;\n    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.8, 0.07), MAT.darkMet());\n    leg.position.set(Math.cos(a)*topR*0.75, -(h/2 + 0.35), Math.sin(a)*topR*0.75);\n    g.add(leg);\n  }\n  g.position.set(x,y,z);\n  scene.add(g);\n  if (lbl) label(lbl, v3(x, y + h/2 + 0.8, z));\n  return g;\n}\n\nfunction makeTank(x, y, z, r, h, lbl) {\n  const g = new THREE.Group();\n  const body = new THREE.Mesh(new THREE.CylinderGeometry(r, r, h, 22), MAT.tank());\n  body.castShadow = true; g.add(body);\n  const dome = new THREE.Mesh(new THREE.SphereGeometry(r, 22, 12, 0, Math.PI*2, 0, Math.PI/2), MAT.tank());\n  dome.position.y = h/2; g.add(dome);\n  const base = new THREE.Mesh(new THREE.CircleGeometry(r, 22), MAT.tank());\n  base.rotation.x = Math.PI/2; base.position.y = -(h/2); g.add(base);\n  // band rings\n  [h*0.25, 0, -h*0.25].forEach(dy => {\n    const ring = new THREE.Mesh(new THREE.TorusGeometry(r+0.02, 0.05, 6, 22), MAT.darkMet());\n    ring.position.y = dy; g.add(ring);\n  });\n  // support legs\n  for (let i=0; i<4; i++) {\n    const a = (i/4)*Math.PI*2 + Math.PI/4;\n    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.08,0.9,0.08), MAT.darkMet());\n    leg.position.set(Math.cos(a)*r*0.85, -(h/2+0.45), Math.sin(a)*r*0.85);\n    g.add(leg);\n  }\n  // inlet pipe on top\n  const inlet = new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.1,0.5,8), MAT.darkMet());\n  inlet.position.set(r*0.4, h/2+r*0.4, 0); g.add(inlet);\n  // outlet at bottom\n  const outlet = new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.1,0.4,8), MAT.darkMet());\n  outlet.rotation.z = Math.PI/2; outlet.position.set(r+0.2, -(h/2)*0.5, 0); g.add(outlet);\n  g.position.set(x,y,z);\n  scene.add(g);\n  if (lbl) label(lbl, v3(x, y+h/2+r+0.5, z));\n  return g;\n}\n\nfunction makeScrewFeeder(x1,y1,z1, x2,y2,z2, lbl) {\n  const p1 = v3(x1,y1,z1), p2 = v3(x2,y2,z2);\n  const dir = new THREE.Vector3().subVectors(p2,p1);\n  const len = dir.length();\n  const mid = new THREE.Vector3().addVectors(p1,p2).multiplyScalar(0.5);\n  // trough\n  const trough = new THREE.Mesh(new THREE.BoxGeometry(len, 0.32, 0.44), MAT.darkMet());\n  trough.position.copy(mid);\n  trough.rotation.y = Math.atan2(dir.x, dir.z);\n  trough.castShadow = true;\n  scene.add(trough);\n  // cover plate\n  const cover = new THREE.Mesh(new THREE.BoxGeometry(len, 0.06, 0.44), MAT.metal());\n  cover.position.set(0, 0.19, 0);\n  trough.add(cover);\n  // end flanges\n  [p1, p2].forEach(pt => {\n    const fl = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.44, 0.54), MAT.metal());\n    fl.position.copy(pt);\n    scene.add(fl);\n  });\n  if (lbl) label(lbl, v3(mid.x, mid.y + 0.55, mid.z));\n}\n\nfunction makeMixer(x, y, z, lbl) {\n  const g = new THREE.Group();\n  // Main vessel body\n  const body = new THREE.Mesh(new THREE.CylinderGeometry(1.05, 0.85, 2.6, 26), MAT.metal());\n  body.castShadow = true; g.add(body);\n  // Dome top\n  const dome = new THREE.Mesh(new THREE.SphereGeometry(1.05, 26, 14, 0, Math.PI*2, 0, Math.PI/2), MAT.metal());\n  dome.position.y = 1.3; g.add(dome);\n  // Cone bottom\n  const cone = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.85, 1.1, 26), MAT.metal());\n  cone.position.y = -1.85; g.add(cone);\n  // Outlet nozzle\n  const nozzle = new THREE.Mesh(new THREE.CylinderGeometry(0.15,0.15,0.5,10), MAT.darkMet());\n  nozzle.position.y = -2.65; g.add(nozzle);\n  // Band rings\n  [0.7, 0, -0.7].forEach(dy => {\n    const ring = new THREE.Mesh(new THREE.TorusGeometry(1.07, 0.06, 8, 26), MAT.darkMet());\n    ring.position.y = dy; g.add(ring);\n  });\n  // Motor on top\n  const motor = new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.28, 0.55, 14), MAT.darkMet());\n  motor.position.y = 2.45; g.add(motor);\n  const motorCap = new THREE.Mesh(new THREE.SphereGeometry(0.28, 14, 8, 0, Math.PI*2, 0, Math.PI/2), MAT.darkMet());\n  motorCap.position.y = 2.725; g.add(motorCap);\n  // Agitator shaft\n  const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 4.2, 8), MAT.darkMet());\n  shaft.position.y = 0.3; g.add(shaft);\n  // Support legs (4)\n  for (let i=0; i<4; i++) {\n    const a = (i/4)*Math.PI*2 + Math.PI/4;\n    const leg = new THREE.Mesh(new THREE.BoxGeometry(0.1, 1.4, 0.1), MAT.darkMet());\n    leg.position.set(Math.cos(a)*0.95, -3.1, Math.sin(a)*0.95);\n    g.add(leg);\n    const foot = new THREE.Mesh(new THREE.BoxGeometry(0.25, 0.08, 0.25), MAT.darkMet());\n    foot.position.set(Math.cos(a)*0.95, -3.84, Math.sin(a)*0.95);\n    g.add(foot);\n  }\n  // Feed pipes on top dome\n  const fp = new THREE.Mesh(new THREE.CylinderGeometry(0.1,0.1,0.5,8), MAT.darkMet());\n  fp.position.set(0.55, 1.65, 0); g.add(fp);\n\n  g.position.set(x,y,z);\n  scene.add(g);\n  if (lbl) label(lbl, v3(x, y+3.6, z));\n  return g;\n}\n\nfunction makeDustCollector(x,y,z) {\n  const g = new THREE.Group();\n  const box = new THREE.Mesh(new THREE.BoxGeometry(1.6, 2.8, 1.3), MAT.metal());\n  box.castShadow = true; g.add(box);\n  const filter = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.9, 1.1), MAT.darkMet());\n  filter.position.y = 1.85; g.add(filter);\n  const hop = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.65, 1.1, 10), MAT.darkMet());\n  hop.position.y = -1.95; g.add(hop);\n  // Inlet duct (side)\n  const duct = new THREE.Mesh(new THREE.CylinderGeometry(0.18,0.18,1.2,8), MAT.darkMet());\n  duct.rotation.z = Math.PI/2;\n  duct.position.set(-1.4, 0.6, 0); g.add(duct);\n  g.position.set(x,y,z);\n  scene.add(g);\n  label('Dust Collector', v3(x, y+2.7, z));\n  return g;\n}\n\nfunction makeDiverter(x,y,z) {\n  const g = new THREE.Group();\n  const body = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.7, 0.7), MAT.pipe.clone());\n  g.add(body);\n  const arrow = new THREE.Mesh(new THREE.CylinderGeometry(0,0.2,0.4,6), MAT.pipe.clone());\n  arrow.rotation.z = -Math.PI/2;\n  arrow.position.set(0.65, 0, 0); g.add(arrow);\n  g.position.set(x,y,z);\n  scene.add(g);\n  label('Diverter', v3(x, y+0.8, z));\n  return g;\n}\n\n// ─────────────────────────────────────────────────────────────────────────────\n// BUILD ALL EQUIPMENT\n// ─────────────────────────────────────────────────────────────────────────────\nbuildStructure();\n\n// 3F ──────────────────────────────────────────────────────────────────\nmakeHopper(-3.8, 12.2, 0, 1.0, 0.4, 2.0, 'Inlet Hopper');\nmakeHopper( 0.4, 12.2, 0, 1.0, 0.4, 2.0, 'Inlet Hopper');\nmakeDustCollector(5.8, 11.5, 0);\n\n// 3F → 2F ─────────────────────────────────────────────────────────────\nmakeHopper(-3.8, 9.4, 0, 1.1, 0.45, 2.0, 'Weighing Hopper');\nmakeHopper( 0.4, 9.4, 0, 1.1, 0.45, 2.0, 'Weighing Hopper');\nmakeScrewFeeder(-3.8,7.9,0, -1.7,7.9,0, 'Screw Feeder');\nmakeScrewFeeder( 0.4,7.9,0, -1.7,7.9,0, 'Screw Feeder');\n\n// 2F ──────────────────────────────────────────────────────────────────\nmakeHopper(-1.7, 6.4, 0, 1.2, 0.5, 2.1, 'Positive Sending\\nHopper');\nmakeDiverter(-1.7, 4.6, 0);\n\n// 1F ──────────────────────────────────────────────────────────────────\nconst mixerGroup = makeMixer(-3.8, 1.5, 0, 'CM PD Mixer');\nmakeScrewFeeder(-3.8,1.8,0, -0.4,1.8,0, 'Screw Feeder');\nmakeTank(1.4, 1.9, 0, 0.95, 2.3, 'Storage Tank');\nmakeTank(4.0, 1.9, 0, 0.95, 2.3, 'Buffer Tank');\n\n// To Coater Tank label\nconst ctDiv = document.createElement('div');\nctDiv.className = 'label-flow';\nctDiv.textContent = '▶ TO COATER TANK';\nconst ctObj = new THREE.CSS2DObject(ctDiv);\nctObj.position.set(7.2, 1.9, 0);\nscene.add(ctObj);\n\n// To Line 2 label\nconst tl2Div = document.createElement('div');\ntl2Div.className = 'label-flow';\ntl2Div.textContent = '▶ TO LINE 2';\nconst tl2Obj = new THREE.CSS2DObject(tl2Div);\ntl2Obj.position.set(3.2, 4.6, 0);\nscene.add(tl2Obj);\n\n// ─────────────────────────────────────────────────────────────────────────────\n// FLOW PIPES (magenta highlighted)\n// ─────────────────────────────────────────────────────────────────────────────\n// Left: Inlet → Weighing\npipe(v3(-3.8,11.2,0), v3(-3.8,10.4,0), 0.11);\n// Left: Weighing → Screw\npipe(v3(-3.8, 8.4,0), v3(-3.8, 7.9,0), 0.11);\n// Left: screw end → center\npipe(v3(-1.7, 7.9,0), v3(-1.7, 7.3,0), 0.13);\n\n// Right: Inlet → Weighing\npipe(v3( 0.4,11.2,0), v3( 0.4,10.4,0), 0.11);\n// Right: Weighing → Screw\npipe(v3( 0.4, 8.4,0), v3( 0.4, 7.9,0), 0.11);\n// Right screw merges with center\npipe(v3(-1.7, 7.9,0), v3(-1.7, 7.3,0), 0.13);  // shared center drop\n\n// Center: → Positive Sending Hopper\npipe(v3(-1.7, 7.3,0), v3(-1.7, 5.4,0), 0.13);\n\n// Positive Sending Hopper → Diverter\npipe(v3(-1.7, 5.35,0), v3(-1.7, 4.95,0), 0.13);\n\n// Diverter → line 2 branch (gray)\npipe(v3(-1.7, 4.6,0), v3(2.5, 4.6,0), 0.09, MAT.pipeGray);\n\n// Diverter → down to 1F\npipe(v3(-1.7, 4.25,0), v3(-1.7, 3.2,0), 0.13);\npipe(v3(-1.7, 3.2,0), v3(-3.8, 3.2,0), 0.11);\npipe(v3(-3.8, 3.2,0), v3(-3.8, 2.8,0), 0.13);\n\n// Mixer outlet → Screw Feeder\npipe(v3(-3.8,-0.8,0), v3(-3.8, 1.6,0), 0.11);\n\n// Screw Feeder → Storage Tank\npipe(v3(-0.4, 1.8,0), v3( 0.45, 1.8,0), 0.11);\n\n// Storage → Buffer\npipe(v3( 2.35,1.8,0), v3( 3.05,1.8,0), 0.11);\n\n// Buffer → To Coater Tank\npipe(v3( 4.95,1.8,0), v3( 6.2, 1.8,0), 0.11);\npipe(v3( 6.2, 1.8,0), v3( 6.8, 1.8,0), 0.09, MAT.pipeGray);\n\n// ─────────────────────────────────────────────────────────────────────────────\n// ANIMATED FLOW PARTICLES\n// ─────────────────────────────────────────────────────────────────────────────\nclass FlowParticles {\n  constructor(waypoints, clr, count, spd) {\n    this.path = waypoints.map(p => v3(...p));\n    this.count = count;\n    this.speed = spd;\n    // cumulative arc-lengths\n    this.lens = [0];\n    for (let i = 1; i < this.path.length; i++)\n      this.lens.push(this.lens[i-1] + this.path[i].distanceTo(this.path[i-1]));\n    this.total = this.lens[this.lens.length - 1];\n    // BufferGeometry\n    const pos = new Float32Array(count * 3);\n    this.geo = new THREE.BufferGeometry();\n    this.geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));\n    this.pts = new THREE.Points(this.geo,\n      new THREE.PointsMaterial({ color:clr, size:0.14, sizeAttenuation:true,\n        transparent:true, opacity:0.9 }));\n    scene.add(this.pts);\n    // random start offsets\n    this.ts = Array.from({length:count}, (_,i) => (i/count)*this.total);\n  }\n  at(d) {\n    d = ((d % this.total) + this.total) % this.total;\n    for (let i = 1; i < this.lens.length; i++) {\n      if (d <= this.lens[i]) {\n        const t = (d - this.lens[i-1]) / (this.lens[i] - this.lens[i-1]);\n        return new THREE.Vector3().lerpVectors(this.path[i-1], this.path[i], t);\n      }\n    }\n    return this.path[0].clone();\n  }\n  update(dt) {\n    const arr = this.geo.attributes.position.array;\n    for (let i = 0; i < this.count; i++) {\n      this.ts[i] = (this.ts[i] + this.speed * dt) % this.total;\n      const p = this.at(this.ts[i]);\n      arr[i*3]=p.x; arr[i*3+1]=p.y; arr[i*3+2]=p.z;\n    }\n    this.geo.attributes.position.needsUpdate = true;\n  }\n}\n\n// Main flow path (left branch, full route)\nconst mainPath = [\n  [-3.8,11.2,0],[-3.8,10.4,0],[-3.8,8.4,0],[-3.8,7.9,0],\n  [-1.7,7.9,0],[-1.7,7.3,0],[-1.7,5.4,0],[-1.7,4.95,0],\n  [-1.7,4.25,0],[-1.7,3.2,0],[-3.8,3.2,0],[-3.8,2.8,0],\n  [-3.8,-0.8,0],[-3.8,1.6,0],[-0.4,1.8,0],[0.45,1.8,0],\n  [2.35,1.8,0],[3.05,1.8,0],[4.95,1.8,0],[6.2,1.8,0]\n];\n// Right branch feed path\nconst rightPath = [\n  [0.4,11.2,0],[0.4,10.4,0],[0.4,8.4,0],[0.4,7.9,0],[-1.7,7.9,0]\n];\n\nconst flows = [\n  new FlowParticles(mainPath, 0xff44ff, 24, 2.2),\n  new FlowParticles(rightPath, 0xff44ff, 10, 2.2),\n];\n\n// Secondary brighter sparkle particles\nconst sparkPath = mainPath.slice(9);\nflows.push(new FlowParticles(sparkPath, 0xffffff, 8, 1.8));\n\n// ─────────────────────────────────────────────────────────────────────────────\n// ANIMATE\n// ─────────────────────────────────────────────────────────────────────────────\nconst clock = new THREE.Clock();\n\nfunction animate() {\n  requestAnimationFrame(animate);\n  const dt = Math.min(clock.getDelta(), 0.05);\n  controls.update();\n  flows.forEach(f => f.update(dt));\n  // Rotate mixer motor (visual feedback)\n  if (mixerGroup) {\n    const motorPart = mixerGroup.children.find(c =>\n      c.geometry && c.geometry.type === 'CylinderGeometry' &&\n      Math.abs(c.position.y - 2.45) < 0.1);\n    if (motorPart) motorPart.rotation.y += dt * 1.5;\n  }\n  renderer.render(scene, camera);\n  labelRenderer.render(scene, camera);\n}\nanimate();\n\n// ─────────────────────────────────────────────────────────────────────────────\n// RESIZE\n// ─────────────────────────────────────────────────────────────────────────────\nwindow.addEventListener('resize', () => {\n  const W = window.innerWidth, H = window.innerHeight;\n  camera.aspect = W / H;\n  camera.updateProjectionMatrix();\n  renderer.setSize(W, H);\n  labelRenderer.setSize(W, H);\n});\n</script>\n</body>\n</html>\n"
}