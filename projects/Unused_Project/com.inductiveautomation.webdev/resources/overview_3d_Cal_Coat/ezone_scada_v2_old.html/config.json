{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>AGRATAS — E ZONE | SA VIEW</title>\n<style>\n/* ── Ignition default palette & font ──────────────────────────── */\n:root {\n  --bg:        #D0D0D0;\n  --srf:       #E0E0E0;\n  --srf2:      #EBEBEB;\n  --border:    #AAAAAA;\n  --b2:        #C0C0C0;\n  --text:      #1A1A1A;\n  --dim:       #555555;\n  --muted:     #777777;\n\n  /* ISA-101 states */\n  --run-fill:  #D4D4D4;\n  --run-bdr:   #888888;\n  --warn-fill: #FFEE88;\n  --warn-bdr:  #CC9900;\n  --warn-txt:  #443300;\n  --flt-fill:  #FF8888;\n  --flt-bdr:   #CC0000;\n  --flt-txt:   #440000;\n  --idle-fill: #C8C8C8;\n  --idle-bdr:  #999999;\n\n  /* line identity */\n  --e1: #3A6A90;\n  --e2: #2E7840;\n  --e3: #886020;\n  --e4: #603890;\n}\n*, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }\nhtml, body {\n  width:100%; height:100%; overflow:hidden;\n  /* Ignition default: plain system sans */\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  font-size: 11px;\n  background: var(--bg);\n  color: var(--text);\n}\n\n/* ── LAYOUT ───────────────────────────────────────────────────── */\n#layout {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  gap: 3px;\n  padding: 4px;\n}\n\n/* ── LINE ROW ────────────────────────────────────────────────── */\n.line-row {\n  flex: 1;\n  display: flex;\n  background: var(--srf2);\n  border: 1px solid var(--border);\n  border-left: 4px solid var(--run-bdr);\n  min-height: 0;\n}\n.line-row[data-l=\"E1\"] { border-left-color: var(--e1); }\n.line-row[data-l=\"E2\"] { border-left-color: var(--e2); }\n.line-row[data-l=\"E3\"] { border-left-color: var(--e3); }\n.line-row[data-l=\"E4\"] { border-left-color: var(--e4); }\n.line-row.st-warn { border-left-color: var(--warn-bdr) !important; }\n.line-row.st-fault{ border-left-color: var(--flt-bdr)  !important; }\n\n/* ── LEFT BADGE ────────────────────────────────────────────────── */\n.badge {\n  width: 88px;\n  flex-shrink: 0;\n  border-right: 1px solid var(--border);\n  background: var(--srf);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  padding: 6px 4px;\n  gap: 4px;\n}\n.badge-id {\n  font-size: 20px;\n  font-weight: 700;\n  line-height: 1;\n  color: var(--text);\n  letter-spacing: 1px;\n}\n.badge-name {\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  color: var(--dim);\n  text-align: center;\n  text-transform: uppercase;\n  line-height: 1.4;\n}\n.badge-st {\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: 1px;\n  padding: 2px 6px;\n  border: 1px solid currentColor;\n  text-transform: uppercase;\n}\n.bs-run   { color: #226622; background: #D8EED8; border-color: #4A9A4A; }\n.bs-warn  { color: #664400; background: var(--warn-fill); border-color: var(--warn-bdr); animation: bk 1.8s infinite; }\n.bs-fault { color: #660000; background: var(--flt-fill);  border-color: var(--flt-bdr);  animation: bk 0.9s infinite; }\n@keyframes bk { 0%,100%{opacity:1} 50%{opacity:0.45} }\n\n/* ── EQUIPMENT FLOW AREA ───────────────────────────────────────── */\n.eq-flow {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  overflow-x: auto;\n  overflow-y: hidden;\n  padding: 6px 8px;\n  gap: 0;\n  scrollbar-width: thin;\n  scrollbar-color: var(--border) var(--srf);\n}\n.eq-flow::-webkit-scrollbar { height: 4px; }\n.eq-flow::-webkit-scrollbar-thumb { background: var(--border); }\n\n/* flow connector arrow */\n.arrow {\n  flex-shrink: 0;\n  width: 14px;\n  text-align: center;\n  font-size: 11px;\n  color: var(--dim);\n  line-height: 1;\n  user-select: none;\n  padding-bottom: 14px; /* align with box center, accounting for label below */\n}\n\n/* ── EQUIPMENT BLOCK ──────────────────────────────────────────── */\n.eq-blk {\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  cursor: default;\n}\n.eq-box {\n  border: 2px solid var(--run-bdr);\n  background: var(--run-fill);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  position: relative;\n  transition: filter 0.1s;\n}\n.eq-blk:hover .eq-box { filter: brightness(0.92); }\n\n/* status overrides */\n.eq-box.s-warn  { border-color: var(--warn-bdr); background: var(--warn-fill); }\n.eq-box.s-fault { border-color: var(--flt-bdr);  background: var(--flt-fill);  animation: bk 0.9s infinite; }\n.eq-box.s-idle  { border-color: var(--idle-bdr); background: var(--idle-fill); }\n\n/* shape sizes */\n.sh-roll   { width:44px; height:48px; border-radius:22px; }\n.sh-oven   { width:68px; height:56px; }\n.sh-press  { width:38px; height:60px; }\n.sh-coater { width:44px; height:52px; }\n.sh-gauge  { width:34px; height:44px; }\n.sh-ccd    { width:36px; height:42px; }\n.sh-std    { width:40px; height:44px; }\n.sh-wide   { width:52px; height:50px; }\n\n/* text inside box */\n.eq-icon {\n  font-size: 14px;\n  line-height: 1;\n  color: var(--dim);\n  margin-bottom: 2px;\n}\n.eq-box.s-warn .eq-icon  { color: var(--warn-txt); }\n.eq-box.s-fault .eq-icon { color: var(--flt-txt); }\n\n.eq-tag {\n  font-size: 8.5px;\n  font-weight: 700;\n  text-align: center;\n  line-height: 1.2;\n  color: var(--text);\n  letter-spacing: 0.2px;\n  padding: 0 2px;\n  white-space: nowrap;\n}\n.eq-box.s-warn .eq-tag  { color: var(--warn-txt); }\n.eq-box.s-fault .eq-tag { color: var(--flt-txt); }\n\n/* label below box */\n.eq-lbl {\n  margin-top: 3px;\n  font-size: 8px;\n  color: var(--dim);\n  text-align: center;\n  white-space: nowrap;\n  letter-spacing: 0.3px;\n  line-height: 1.2;\n}\n\n/* alarm indicator dot top-right */\n.adot {\n  position: absolute;\n  top: 3px; right: 3px;\n  width: 7px; height: 7px;\n  border-radius: 50%;\n}\n.adot.warn  { background: var(--warn-bdr); animation: bk 1.4s infinite; }\n.adot.fault { background: var(--flt-bdr);  animation: bk 0.7s infinite; }\n\n/* ── RIGHT KPI PANEL ─────────────────────────────────────────── */\n.meta {\n  width: 110px;\n  flex-shrink: 0;\n  border-left: 1px solid var(--border);\n  background: var(--srf);\n  padding: 8px 10px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n.meta-oee-row {\n  display: flex;\n  align-items: baseline;\n  gap: 3px;\n}\n.meta-oee-val {\n  font-size: 24px;\n  font-weight: 700;\n  line-height: 1;\n  color: var(--text);\n}\n.meta-oee-unit {\n  font-size: 9px;\n  color: var(--muted);\n  font-weight: 600;\n}\n.meta-bar {\n  height: 4px;\n  background: var(--b2);\n  border: 1px solid var(--border);\n  margin: 4px 0 6px;\n}\n.meta-bar-fill {\n  height: 100%;\n  transition: width 1.2s ease;\n}\n.kv-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  margin: 2px 0;\n}\n.kv-lbl {\n  font-size: 8px;\n  color: var(--muted);\n  text-transform: uppercase;\n  letter-spacing: 0.3px;\n}\n.kv-val {\n  font-size: 10px;\n  font-weight: 700;\n  color: var(--text);\n}\n.kv-val.warn  { color: #664400; }\n.kv-val.fault { color: #880000; }\n\n/* ── BOTTOM STATUS BAR ───────────────────────────────────────── */\n#statusbar {\n  flex-shrink: 0;\n  height: 28px;\n  background: var(--srf);\n  border: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  padding: 0 10px;\n  gap: 24px;\n}\n.sb-item {\n  display: flex;\n  align-items: baseline;\n  gap: 5px;\n}\n.sb-lbl {\n  font-size: 9px;\n  color: var(--muted);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n.sb-val {\n  font-size: 11px;\n  font-weight: 700;\n  color: var(--text);\n}\n.sb-div {\n  width: 1px; height: 16px;\n  background: var(--border);\n}\n.sb-right {\n  margin-left: auto;\n  font-size: 9px;\n  color: var(--muted);\n  letter-spacing: 0.5px;\n}\n.online-dot {\n  display: inline-block;\n  width: 7px; height: 7px;\n  border-radius: 50%;\n  background: #3A8A3A;\n  margin-right: 5px;\n  animation: bk 2.5s infinite;\n}\n\n/* ── TOOLTIP ─────────────────────────────────────────────────── */\n#tt {\n  position: fixed;\n  z-index: 999;\n  pointer-events: none;\n  display: none;\n  background: #F0F0F0;\n  border: 1px solid var(--border);\n  border-left: 3px solid #888;\n  padding: 8px 12px;\n  font-size: 10px;\n  min-width: 180px;\n  box-shadow: 2px 3px 8px rgba(0,0,0,.18);\n}\n.tt-title {\n  font-size: 12px;\n  font-weight: 700;\n  color: var(--text);\n  margin-bottom: 6px;\n  letter-spacing: 0.5px;\n}\n.tt-row {\n  display: flex;\n  justify-content: space-between;\n  gap: 14px;\n  color: var(--muted);\n  margin: 2px 0;\n  font-size: 9.5px;\n}\n.tt-row em { color: var(--text); font-style: normal; font-weight: 600; }\n.tt-warn  { color: #664400; font-weight: 600; margin-top: 4px; font-size: 9px; }\n.tt-fault { color: #880000; font-weight: 600; margin-top: 4px; font-size: 9px; }\n</style>\n</head>\n<body>\n<div id=\"layout\"></div>\n<div id=\"tt\"></div>\n\n<script>\n// ── STATE ──────────────────────────────────────────────────────────────────\nconst S = {\n  E1:{ oee:84.1, status:'run', alarms:1, webSpeed:22.5, ovenTempA:128.4, avail:92.1, perf:91.2, qual:99.8,\n       machines:{ UW:'run','A-CTR':'run','OVN-A':'run','BG2':'run','CCD1':'run','B-CTR':'run','OVN-B':'run','BG5':'run','CCD3':'warn','MRK':'run','SPLT':'run','RW1':'run','RW2':'run' }},\n  E2:{ oee:81.2, status:'run', alarms:2, webSpeed:20.1, ovenTempA:125.0, avail:89.5, perf:90.8, qual:99.7,\n       machines:{ UW:'run','A-CTR':'run','OVN-A':'warn','BG2':'run','CCD1':'run','B-CTR':'run','OVN-B':'run','BG5':'run','CCD3':'run','MRK':'warn','SPLT':'run','RW1':'run','RW2':'run' }},\n  E3:{ oee:83.5, status:'run', alarms:0, pressGap:0.142, pressForce:850, avail:91.0, perf:91.8, qual:99.9,\n       machines:{ UW:'run','TEN':'run','PR1':'run','PR2':'run','TG':'run','VIS':'run','MRK':'run','RW':'run' }},\n  E4:{ oee:80.8, status:'warn', alarms:4, pressGap:0.138, calTemp:85.0, avail:87.2, perf:92.5, qual:99.6,\n       machines:{ UW:'run','TEN':'run','PHT':'fault','HPR':'warn','CLR':'run','TG':'warn','VIS':'run','RW':'run' }}\n};\n\nconst EQ_COATING = [\n  {tag:'UW',    lbl:'Unwinder',     sh:'roll'},\n  {tag:'BG-1',  lbl:'β Gauge 1',    sh:'gauge'},\n  {tag:'CPC-1', lbl:'CPC 1',        sh:'std'},\n  {tag:'A-CTR', lbl:'A Coater',     sh:'coater'},\n  {tag:'BG-2',  lbl:'β Gauge 2',    sh:'gauge'},\n  {tag:'CCD-1', lbl:'CCD #1',       sh:'ccd'},\n  {tag:'OVN-A', lbl:'Oven A',       sh:'oven'},\n  {tag:'BG-3',  lbl:'β Gauge 3',    sh:'gauge'},\n  {tag:'CPC-2', lbl:'CPC 2',        sh:'std'},\n  {tag:'B-CTR', lbl:'B Coater',     sh:'coater'},\n  {tag:'BG-4',  lbl:'β Gauge 4',    sh:'gauge'},\n  {tag:'CCD-2', lbl:'CCD #2',       sh:'ccd'},\n  {tag:'OVN-B', lbl:'Oven B',       sh:'oven'},\n  {tag:'BG-5',  lbl:'β Gauge 5',    sh:'gauge'},\n  {tag:'CCD-3', lbl:'CCD #3',       sh:'ccd'},\n  {tag:'MRK',   lbl:'NG Marker',    sh:'std'},\n  {tag:'SPLT',  lbl:'Splitter',     sh:'wide'},\n  {tag:'RW-1',  lbl:'Rewinder 1',   sh:'roll'},\n  {tag:'RW-2',  lbl:'Rewinder 2',   sh:'roll'},\n];\n// map original machine keys to display tags\nconst COAT_KEY = ['UW','A-CTR','OVN-A','BG2','CCD1','B-CTR','OVN-B','BG5','CCD3','MRK','SPLT','RW1','RW2'];\nconst EQ_COATING_KEYS = ['UW','A-CTR','OVN-A','BG2','CCD1','B-CTR','OVN-B','BG5','CCD3','MRK','SPLT','RW1','RW2'];\n\nconst EQ_CAL_ANODE = [\n  {tag:'UW',  lbl:'Unwinder',       sh:'roll',   key:'UW'},\n  {tag:'TEN', lbl:'Tension Ctrl',   sh:'std',    key:'TEN'},\n  {tag:'PR-1',lbl:'Press 1',        sh:'press',  key:'PR1'},\n  {tag:'PR-2',lbl:'Press 2',        sh:'press',  key:'PR2'},\n  {tag:'TG',  lbl:'Thickness Gauge',sh:'gauge',  key:'TG'},\n  {tag:'VIS', lbl:'Vision System',  sh:'ccd',    key:'VIS'},\n  {tag:'MRK', lbl:'NG Laser Mark',  sh:'std',    key:'MRK'},\n  {tag:'RW',  lbl:'Rewinder',       sh:'roll',   key:'RW'},\n];\nconst EQ_CAL_CATH = [\n  {tag:'UW',  lbl:'Unwinder',       sh:'roll',   key:'UW'},\n  {tag:'TEN', lbl:'Tension Ctrl',   sh:'std',    key:'TEN'},\n  {tag:'PHT', lbl:'Preheat Rolls',  sh:'coater', key:'PHT'},\n  {tag:'HPR', lbl:'Hot Press',      sh:'press',  key:'HPR'},\n  {tag:'CLR', lbl:'Cooling Rolls',  sh:'coater', key:'CLR'},\n  {tag:'TG',  lbl:'Thickness Gauge',sh:'gauge',  key:'TG'},\n  {tag:'VIS', lbl:'Vision System',  sh:'ccd',    key:'VIS'},\n  {tag:'RW',  lbl:'Rewinder',       sh:'roll',   key:'RW'},\n];\n\n// add keys to coating eq\nEQ_COATING.forEach((e,i) => {\n  const keys=['UW','A-CTR','OVN-A','BG2','CCD1','B-CTR','OVN-B','BG5','CCD3','MRK','SPLT','RW1','RW2'];\n  // map by position to machine state keys\n  const posMap = ['UW',null,null,'A-CTR',null,'CCD1','OVN-A',null,null,'B-CTR',null,null,'OVN-B','BG5','CCD3','MRK','SPLT','RW1','RW2'];\n  e.key = posMap[i];\n});\n\nconst LINE_EQ   = { E1:EQ_COATING, E2:EQ_COATING, E3:EQ_CAL_ANODE, E4:EQ_CAL_CATH };\nconst LNAMES    = { E1:'Anode Coating', E2:'Cathode Coating', E3:'Anode Calender', E4:'Cathode Calender' };\nconst LCOLORS   = { E1:'#3A6A90', E2:'#2E7840', E3:'#886020', E4:'#603890' };\nconst BAR_FILL  = { E1:'#5A8AB0', E2:'#4E9A60', E3:'#AA8040', E4:'#8058B0' };\n\nfunction getMachineStatus(lid, eq) {\n  if(!eq.key) return 'run';\n  return S[lid].machines[eq.key] || 'run';\n}\n\nfunction buildLine(lid) {\n  const s = S[lid];\n  const eq = LINE_EQ[lid];\n  const rowSt = s.status==='fault'?'st-fault':s.status==='warn'?'st-warn':'';\n  const bsSt  = s.status==='fault'?'bs-fault':s.status==='warn'?'bs-warn':'bs-run';\n  const stLbl = s.status==='fault'?'FAULT':s.status==='warn'?'WARNING':'RUNNING';\n\n  // KPI values\n  let kv1l='', kv1='', kv2l='', kv2='';\n  if(lid==='E1'||lid==='E2'){\n    kv1l='Speed'; kv1=(s.webSpeed||0).toFixed(1)+' m/min';\n    kv2l='Oven A'; kv2=(s.ovenTempA?.toFixed(0)||'--')+'°C';\n  } else {\n    kv1l='Gap'; kv1=(s.pressGap||0).toFixed(3)+' mm';\n    kv2l=lid==='E4'?'Roll Temp':'Force';\n    kv2=lid==='E4'?(s.calTemp?.toFixed(0)||'--')+'°C':(s.pressForce||'--')+' kN';\n  }\n  const almC = s.alarms>3?'fault':s.alarms>0?'warn':'';\n\n  // Equipment blocks\n  let eqHtml = '';\n  eq.forEach((e, i) => {\n    const mSt = getMachineStatus(lid, e);\n    const sc  = mSt==='fault'?'s-fault':mSt==='warn'?'s-warn':mSt==='idle'?'s-idle':'';\n    const dot = mSt==='fault'?'<div class=\"adot fault\"></div>':mSt==='warn'?'<div class=\"adot warn\"></div>':'';\n    if(i>0) eqHtml += `<div class=\"arrow\">›</div>`;\n    eqHtml += `\n      <div class=\"eq-blk\" data-lid=\"${lid}\" data-tag=\"${e.tag}\" data-lbl=\"${e.lbl}\" data-st=\"${mSt}\">\n        <div class=\"eq-box sh-${e.sh} ${sc}\">\n          ${dot}\n          <div class=\"eq-tag\">${e.tag}</div>\n        </div>\n        <div class=\"eq-lbl\">${e.lbl}</div>\n      </div>`;\n  });\n\n  return `\n  <div class=\"line-row ${rowSt}\" data-l=\"${lid}\" id=\"lr-${lid}\">\n    <div class=\"badge\">\n      <div class=\"badge-id\" style=\"color:${LCOLORS[lid]}\">${lid}</div>\n      <div class=\"badge-name\">${LNAMES[lid]}</div>\n      <div class=\"badge-st ${bsSt}\" id=\"bst-${lid}\">${stLbl}</div>\n    </div>\n    <div class=\"eq-flow\">${eqHtml}</div>\n    <div class=\"meta\" id=\"meta-${lid}\">\n      <div>\n        <div class=\"meta-oee-row\">\n          <div class=\"meta-oee-val\" id=\"ov-${lid}\">${s.oee.toFixed(1)}</div>\n          <div class=\"meta-oee-unit\">% OEE</div>\n        </div>\n        <div class=\"meta-bar\"><div class=\"meta-bar-fill\" id=\"ob-${lid}\" style=\"width:${s.oee}%;background:${BAR_FILL[lid]}\"></div></div>\n      </div>\n      <div>\n        <div class=\"kv-row\"><div class=\"kv-lbl\">Avail</div><div class=\"kv-val\" id=\"mva-${lid}\">${s.avail}%</div></div>\n        <div class=\"kv-row\"><div class=\"kv-lbl\">Perf</div><div class=\"kv-val\" id=\"mvp-${lid}\">${s.perf}%</div></div>\n        <div class=\"kv-row\"><div class=\"kv-lbl\">${kv1l}</div><div class=\"kv-val\" id=\"mv1-${lid}\">${kv1}</div></div>\n        <div class=\"kv-row\"><div class=\"kv-lbl\">${kv2l}</div><div class=\"kv-val\" id=\"mv2-${lid}\">${kv2}</div></div>\n        <div class=\"kv-row\"><div class=\"kv-lbl\">Alarms</div><div class=\"kv-val ${almC}\" id=\"mvalm-${lid}\">${s.alarms}</div></div>\n      </div>\n    </div>\n  </div>`;\n}\n\n// ── STATUS BAR ────────────────────────────────────────────────────\nfunction buildStatusBar() {\n  return `\n  <div id=\"statusbar\">\n    <div class=\"sb-item\">\n      <span class=\"online-dot\"></span>\n      <span class=\"sb-lbl\">E Zone</span>\n      <span class=\"sb-val\">ONLINE · 4/4 Lines</span>\n    </div>\n    <div class=\"sb-div\"></div>\n    <div class=\"sb-item\"><span class=\"sb-lbl\">OEE</span><span class=\"sb-val\" id=\"sb-oee\">82.4 %</span></div>\n    <div class=\"sb-div\"></div>\n    <div class=\"sb-item\"><span class=\"sb-lbl\">Alarms</span><span class=\"sb-val\" id=\"sb-alm\" style=\"color:#880000\">7</span></div>\n    <div class=\"sb-div\"></div>\n    <div class=\"sb-item\"><span class=\"sb-lbl\">E1 OEE</span><span class=\"sb-val\" id=\"sb-e1\">84.1 %</span></div>\n    <div class=\"sb-item\"><span class=\"sb-lbl\">E2 OEE</span><span class=\"sb-val\" id=\"sb-e2\">81.2 %</span></div>\n    <div class=\"sb-item\"><span class=\"sb-lbl\">E3 OEE</span><span class=\"sb-val\" id=\"sb-e3\">83.5 %</span></div>\n    <div class=\"sb-item\"><span class=\"sb-lbl\">E4 OEE</span><span class=\"sb-val\" id=\"sb-e4\" style=\"color:#664400\">80.8 %</span></div>\n    <div class=\"sb-right\" id=\"sb-dt\"></div>\n  </div>`;\n}\n\ndocument.getElementById('layout').innerHTML =\n  ['E1','E2','E3','E4'].map(buildLine).join('') + buildStatusBar();\n\n// ── TOOLTIP ───────────────────────────────────────────────────────\nconst tt = document.getElementById('tt');\nconst STLBL = {run:'Running',warn:'Warning',fault:'Fault',idle:'Idle'};\nconst STCOL  = {run:'#226622',warn:'#664400',fault:'#880000',idle:'#777'};\n\ndocument.addEventListener('mousemove', e => {\n  const blk = e.target.closest('.eq-blk');\n  if(blk) {\n    const {lid,tag,lbl,st} = blk.dataset;\n    tt.style.borderLeftColor = STCOL[st]||'#888';\n    tt.style.display = 'block';\n    tt.style.left = (e.clientX+14)+'px';\n    tt.style.top  = (Math.min(e.clientY-8, window.innerHeight-120))+'px';\n    tt.innerHTML = `\n      <div class=\"tt-title\">${tag} — ${lbl}</div>\n      <div class=\"tt-row\">Line <em style=\"color:${LCOLORS[lid]}\">${lid} · ${LNAMES[lid]}</em></div>\n      <div class=\"tt-row\">Status <em style=\"color:${STCOL[st]}\">${STLBL[st]||'—'}</em></div>\n      ${st==='fault'?'<div class=\"tt-fault\">⚠ FAULT — Immediate action required</div>':''}\n      ${st==='warn'?'<div class=\"tt-warn\">⚠ WARNING — Check required</div>':''}`;\n  } else {\n    tt.style.display = 'none';\n  }\n});\n\n// ── REFRESH ───────────────────────────────────────────────────────\nfunction refresh() {\n  let totalAlm = 0;\n  ['E1','E2','E3','E4'].forEach(l => {\n    const s = S[l];\n    totalAlm += s.alarms;\n    document.getElementById('ov-'+l).textContent = s.oee.toFixed(1);\n    document.getElementById('ob-'+l).style.width = s.oee.toFixed(1)+'%';\n    const almC = s.alarms>3?'fault':s.alarms>0?'warn':'';\n    document.getElementById('mvalm-'+l).textContent = s.alarms;\n    document.getElementById('mvalm-'+l).className = 'kv-val '+(almC||'');\n    if(l==='E1'||l==='E2'){\n      document.getElementById('mv1-'+l).textContent = (s.webSpeed||0).toFixed(1)+' m/min';\n      document.getElementById('mv2-'+l).textContent = (s.ovenTempA?.toFixed(0)||'--')+'°C';\n    } else {\n      document.getElementById('mv1-'+l).textContent = (s.pressGap||0).toFixed(3)+' mm';\n      if(l==='E4') document.getElementById('mv2-'+l).textContent = (s.calTemp?.toFixed(0)||'--')+'°C';\n    }\n    const stm={run:'bs-run',warn:'bs-warn',fault:'bs-fault'};\n    const stl={run:'RUNNING',warn:'WARNING',fault:'FAULT'};\n    const be=document.getElementById('bst-'+l);\n    be.className='badge-st '+(stm[s.status]||'bs-run');\n    be.textContent=stl[s.status]||'IDLE';\n    // status bar\n    const sv=document.getElementById('sb-'+l.toLowerCase());\n    if(sv){ sv.textContent=s.oee.toFixed(1)+' %'; sv.style.color=s.status==='warn'?'#664400':s.status==='fault'?'#880000':''; }\n  });\n  const avg=((S.E1.oee+S.E2.oee+S.E3.oee+S.E4.oee)/4).toFixed(1);\n  document.getElementById('sb-oee').textContent=avg+' %';\n  document.getElementById('sb-alm').textContent=totalAlm;\n}\n\n// ── SIMULATION ────────────────────────────────────────────────────\nconst _t={E1:84.1,E2:81.2,E3:83.5,E4:80.8};\nsetInterval(()=>{\n  ['E1','E2','E3','E4'].forEach(l=>{\n    _t[l]+=(Math.random()-.5)*.28; _t[l]=Math.max(70,Math.min(93,_t[l]));\n    S[l].oee+=(_t[l]-S[l].oee)*.2;\n    if(S[l].webSpeed) S[l].webSpeed+=((Math.random()-.5)*.12);\n    if(S[l].ovenTempA) S[l].ovenTempA+=((Math.random()-.5)*.3);\n  });\n  refresh();\n},3500);\n\nfunction tick(){\n  const dt=document.getElementById('sb-dt');\n  if(dt) dt.textContent=new Date().toLocaleString('en-IN',{hour12:false});\n}\ntick(); setInterval(tick,1000);\n</script>\n</body>\n</html>"
}