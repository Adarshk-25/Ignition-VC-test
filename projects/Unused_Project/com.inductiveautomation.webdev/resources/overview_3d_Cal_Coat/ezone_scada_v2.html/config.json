  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>AGRATAS — E ZONE | ELECTRODE</title>\n<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#2E2E2E;--dark:#1E1E1E;--border:#484848;--b2:#3C3C3C;--text:#D2D2D2;--dim:#787878;--muted:#505050;--mono:'IBM Plex Mono',monospace;--sans:'IBM Plex Sans Condensed',sans-serif;--run:#C0C0C0;--warn:#C8C000;--flt:#C82828;--idle:#505050;--e1:#7A9EBF;--e2:#7BAF72;--e3:#C8A060;--e4:#9878C0}\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\nhtml,body{width:100%;height:100%;overflow:hidden;background:var(--bg);font-family:var(--sans);color:var(--text)}\n#cw{position:fixed;top:0;left:0;right:0;bottom:130px}\n#bar{position:fixed;bottom:0;left:0;right:0;height:130px;z-index:200;display:flex;background:rgba(24,24,24,.97);border-top:1px solid var(--border)}\n.lcard{flex:1;padding:9px 13px;border-right:1px solid var(--b2);position:relative;overflow:hidden;display:flex;flex-direction:column;gap:3px}\n.lcard:last-child{border-right:none}\n.lcard[data-z=\"S\"]{flex:.6;background:rgba(16,16,16,.85)}\n.lcard::after{content:'';position:absolute;top:0;left:0;right:0;height:2px}\n.lcard[data-l=\"E1\"]::after{background:var(--e1)}\n.lcard[data-l=\"E2\"]::after{background:var(--e2)}\n.lcard[data-l=\"E3\"]::after{background:var(--e3)}\n.lcard[data-l=\"E4\"]::after{background:var(--e4)}\n.r1{display:flex;justify-content:space-between;align-items:flex-start;margin-top:4px}\n.nm{font-weight:600;font-size:11px;letter-spacing:3px;color:var(--text)}\n.pr{font-family:var(--mono);font-size:7px;color:var(--muted);margin-top:1px}\n.st{font-family:var(--mono);font-size:8px;letter-spacing:1px;padding:1px 5px;border:1px solid currentColor}\n.s-run{color:var(--run);border-color:rgba(192,192,192,.28);background:rgba(192,192,192,.06)}\n.s-warn{color:var(--warn);border-color:rgba(200,192,0,.38);background:rgba(200,192,0,.07);animation:bk 1.8s infinite}\n.s-flt{color:var(--flt);border-color:rgba(200,40,40,.45);background:rgba(200,40,40,.09);animation:bk .9s infinite}\n.s-idle{color:var(--idle);border-color:rgba(80,80,80,.3)}\n@keyframes bk{0%,100%{opacity:1}50%{opacity:.38}}\n.ov{font-weight:600;font-size:25px;line-height:1;color:var(--text)}\n.un{font-family:var(--mono);font-size:8px;color:var(--dim)}\n.btr{height:2px;background:rgba(255,255,255,.07)}\n.bfl{height:100%;background:var(--dim);transition:width 1.2s ease}\n.sbs{display:flex;gap:10px}\n.sv{font-family:var(--mono);font-size:9px;color:var(--text)}\n.sl{font-family:var(--mono);font-size:7px;color:var(--muted)}\n/* 3D Labels */\n.line-hdr{font-family:'IBM Plex Sans Condensed',sans-serif;font-weight:600;font-size:11px;letter-spacing:2px;color:#A0A0A0;background:rgba(22,22,22,.92);border-left:2px solid currentColor;padding:3px 10px 3px 7px;pointer-events:auto;white-space:nowrap;cursor:pointer;border-bottom:1px solid #3C3C3C;transition:color .15s,background .15s}\n.line-hdr:hover{background:rgba(40,40,40,.98);color:#D0D0D0}\n.eq-label{font-family:var(--mono);font-size:7px;color:#808080;background:rgba(20,20,20,.9);border:1px solid #383838;padding:1px 4px;pointer-events:none;white-space:nowrap}\n.eq-label.warn{color:#C8C000;border-color:rgba(200,192,0,.4)}\n.eq-label.flt{color:#C82828;border-color:rgba(200,40,40,.4)}\n.eq-label.alm{color:#C82828;border-color:rgba(200,40,40,.45);animation:bk .9s infinite}\n/* Machine hover tooltip */\n#tt{position:fixed;z-index:500;pointer-events:none;display:none;background:#1A1A1A;border:1px solid #484848;border-left:2px solid #787878;padding:10px 14px;font-family:var(--mono);font-size:10px;min-width:210px}\n.tt-t{font-family:var(--sans);font-weight:600;font-size:13px;letter-spacing:2px;color:#D2D2D2;margin-bottom:6px}\n.tt-r{display:flex;justify-content:space-between;gap:18px;color:#686868;margin:2px 0}\n.tt-r em{color:#C0C0C0;font-style:normal}\n.tt-h{margin-top:6px;font-size:8px;color:#444;letter-spacing:1px}\n#flash{position:fixed;inset:0;background:rgba(200,200,200,.05);opacity:0;pointer-events:none;transition:opacity .12s;z-index:9999}\n</style>\n</head>\n<body>\n<div id=\"cw\"></div>\n<div id=\"bar\">\n  <div class=\"lcard\" data-z=\"S\">\n  <div class=\"r1\" style=\"margin-top:4px\"><div class=\"nm\" style=\"font-size:9px;letter-spacing:1.5px\">E ZONE</div><div class=\"st s-run\">ONLINE</div></div>\n  <div style=\"display:flex;align-items:baseline;gap:3px;margin-top:2px\"><div style=\"font-weight:600;font-size:20px;color:var(--text)\" id=\"oee-S\">82.4</div><div class=\"un\">% OEE</div></div>\n  <div class=\"btr\"><div class=\"bfl\" id=\"bar-S\" style=\"width:82.4%\"></div></div>\n  <div class=\"sbs\" style=\"margin-top:4px\"><div><div class=\"sv\" style=\"color:var(--run)\">4/4</div><div class=\"sl\">LINES</div></div><div><div class=\"sv\" id=\"alm-S\">7</div><div class=\"sl\">TOTAL ALM</div></div></div>\n  </div>\n  <div class=\"lcard\" data-l=\"E1\">\n    <div class=\"r1\"><div><div class=\"nm\">E1 — ANODE COATING</div><div class=\"pr\">UNWINDER · A-COATER · OVEN-A · B-COATER · OVEN-B · SPLITTER · RW1+RW2</div></div><div class=\"st s-run\" id=\"st-E1\">RUNNING</div></div>\n    <div style=\"display:flex;align-items:baseline;gap:3px\"><div class=\"ov\" id=\"oee-E1\">84.1</div><div class=\"un\">% OEE</div></div>\n    <div class=\"btr\"><div class=\"bfl\" id=\"bar-E1\" style=\"width:84.1%\"></div></div>\n    <div class=\"sbs\"><div><div class=\"sv\" id=\"spd-E1\">22.5</div><div class=\"sl\">WEB m/min</div></div><div><div class=\"sv\" id=\"tmp-E1\">128°C</div><div class=\"sl\">OVEN-A</div></div><div><div class=\"sv\" id=\"alm-E1\">1</div><div class=\"sl\">ALARMS</div></div></div>\n  </div>\n  <div class=\"lcard\" data-l=\"E2\">\n    <div class=\"r1\"><div><div class=\"nm\">E2 — CATHODE COATING</div><div class=\"pr\">UNWINDER · A-COATER · OVEN-A · B-COATER · OVEN-B · SPLITTER · RW1+RW2</div></div><div class=\"st s-run\" id=\"st-E2\">RUNNING</div></div>\n    <div style=\"display:flex;align-items:baseline;gap:3px\"><div class=\"ov\" id=\"oee-E2\">81.2</div><div class=\"un\">% OEE</div></div>\n    <div class=\"btr\"><div class=\"bfl\" id=\"bar-E2\" style=\"width:81.2%\"></div></div>\n    <div class=\"sbs\"><div><div class=\"sv\" id=\"spd-E2\">20.1</div><div class=\"sl\">WEB m/min</div></div><div><div class=\"sv\" id=\"tmp-E2\">125°C</div><div class=\"sl\">OVEN-A</div></div><div><div class=\"sv\" id=\"alm-E2\">2</div><div class=\"sl\">ALARMS</div></div></div>\n  </div>\n  <div class=\"lcard\" data-l=\"E3\">\n    <div class=\"r1\"><div><div class=\"nm\">E3 — ANODE CALENDER</div><div class=\"pr\">UNWINDER · PRESS 1 · PRESS 2 · THICKNESS GAUGE · VISION · REWINDER</div></div><div class=\"st s-run\" id=\"st-E3\">RUNNING</div></div>\n    <div style=\"display:flex;align-items:baseline;gap:3px\"><div class=\"ov\" id=\"oee-E3\">83.5</div><div class=\"un\">% OEE</div></div>\n    <div class=\"btr\"><div class=\"bfl\" id=\"bar-E3\" style=\"width:83.5%\"></div></div>\n    <div class=\"sbs\"><div><div class=\"sv\" id=\"gap-E3\">0.142</div><div class=\"sl\">GAP mm</div></div><div><div class=\"sv\" id=\"frc-E3\">850</div><div class=\"sl\">FORCE kN</div></div><div><div class=\"sv\" id=\"alm-E3\">0</div><div class=\"sl\">ALARMS</div></div></div>\n  </div>\n  <div class=\"lcard\" data-l=\"E4\">\n    <div class=\"r1\"><div><div class=\"nm\">E4 — CATHODE CALENDER</div><div class=\"pr\">UNWINDER · PREHEAT · HOT PRESS · COOLING · THICKNESS GAUGE · REWINDER</div></div><div class=\"st s-warn\" id=\"st-E4\">WARNING</div></div>\n    <div style=\"display:flex;align-items:baseline;gap:3px\"><div class=\"ov\" id=\"oee-E4\">80.8</div><div class=\"un\">% OEE</div></div>\n    <div class=\"btr\"><div class=\"bfl\" id=\"bar-E4\" style=\"width:80.8%\"></div></div>\n    <div class=\"sbs\"><div><div class=\"sv\" id=\"ctmp-E4\" style=\"color:var(--warn)\">85°C</div><div class=\"sl\">ROLL TEMP</div></div><div><div class=\"sv\" id=\"gap-E4\">0.138</div><div class=\"sl\">GAP mm</div></div><div><div class=\"sv\" id=\"alm-E4\" style=\"color:var(--warn)\">4</div><div class=\"sl\">ALARMS</div></div></div>\n  </div>\n</div>\n<div id=\"tt\"></div><div id=\"flash\"></div>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/renderers/CSS2DRenderer.js\"></script>\n<script>\n// ── CONFIG ────────────────────────────────────────────────────────────────\nconst LINE_URLS={E1:'http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/line/E1',E2:'http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/line/E2',E3:'http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/line/E3',E4:'http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/line/E4'};\nconst WEBDEV_URL='';\n\n// ── STATE — per-line AND per-machine alarm/status ─────────────────────────\n// machine status: 'run'|'warn'|'fault'|'idle'\nconst S={\n  E1:{oee:84.1,status:'run',alarms:1,webSpeed:22.5,ovenTempA:128.4,ovenTempB:132.7,avail:92.1,perf:91.2,qual:99.8,\n      machines:{UW:'run','A-CTR':'run','OVN-A':'run',BG2:'run',CCD1:'run','B-CTR':'run','OVN-B':'run',BG5:'run',CCD3:'warn',MRK:'run',SPLT:'run',RW1:'run',RW2:'run'}},\n  E2:{oee:81.2,status:'run',alarms:2,webSpeed:20.1,ovenTempA:125.0,ovenTempB:130.5,avail:89.5,perf:90.8,qual:99.7,\n      machines:{UW:'run','A-CTR':'run','OVN-A':'warn',BG2:'run',CCD1:'run','B-CTR':'run','OVN-B':'run',BG5:'run',CCD3:'run',MRK:'warn',SPLT:'run',RW1:'run',RW2:'run'}},\n  E3:{oee:83.5,status:'run',alarms:0,pressGap:0.142,pressForce:850,avail:91.0,perf:91.8,qual:99.9,\n      machines:{UW:'run',PR1:'run',PR2:'run',TG:'run',VIS:'run',MRK:'run',RW:'run'}},\n  E4:{oee:80.8,status:'warn',alarms:4,pressGap:0.138,calTemp:85.0,avail:87.2,perf:92.5,qual:99.6,\n      machines:{UW:'run',PHT:'fault',HPR:'warn',CLR:'run',TG:'warn',VIS:'run',RW:'run'}}\n};\n\n// ── ISA-101 COLORS ────────────────────────────────────────────────────────\nconst ISA={\n  bg:0x2E2E2E, floor:0x2A2A2A, slab:0x363636, slab2:0x404040,\n  struct:0x323232, roof:0x383838, conv:0x464646,\n  // equipment states (ISA: gray=normal, color=abnormal)\n  run:0xAAAAAA, idle:0x3C3C3C, warn:0x9A8800, flt:0x8A1818,\n  // machine type base tones (all still gray-family)\n  oven:0x525252, press:0x4E4E4E, roll:0x686868, gauge:0x485060,\n  ccd:0x404858, coater:0x545454, frame:0x2E2E2E, accent:0x606060\n};\n\nfunction mCol(type, status){\n  if(status==='fault') return ISA.flt;\n  if(status==='warn')  return ISA.warn;\n  if(status==='idle')  return ISA.idle;\n  switch(type){\n    case 'oven':    return ISA.oven;\n    case 'press':   return ISA.press;\n    case 'roll':    return ISA.roll;\n    case 'gauge':   return ISA.gauge;\n    case 'ccd':     return ISA.ccd;\n    case 'coater':  return ISA.coater;\n    default:        return ISA.run;\n  }\n}\nfunction emCol(status){ return status==='fault'?0x8A1818:status==='warn'?0x9A8800:0x000000; }\nfunction emInt(status){ return status==='fault'?0.35:status==='warn'?0.25:0; }\n\n// ── THREE SETUP ───────────────────────────────────────────────────────────\nconst W0=window.innerWidth, H0=window.innerHeight-130;\nconst scene=new THREE.Scene();\nscene.background=new THREE.Color(ISA.bg);\nscene.fog=new THREE.Fog(ISA.bg,95,220);\nconst camera=new THREE.PerspectiveCamera(40,W0/H0,0.1,500);\ncamera.position.set(0,58,80);camera.lookAt(0,2,-8);\nconst renderer=new THREE.WebGLRenderer({antialias:true});\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio,2));\nrenderer.setSize(W0,H0);renderer.shadowMap.enabled=true;renderer.shadowMap.type=THREE.PCFSoftShadowMap;\ndocument.getElementById('cw').appendChild(renderer.domElement);\nconst labelR=new THREE.CSS2DRenderer();\nlabelR.setSize(W0,H0);labelR.domElement.style.cssText='position:fixed;top:0;pointer-events:none;z-index:50;';\ndocument.body.appendChild(labelR.domElement);\nconst ctrl=new THREE.OrbitControls(camera,renderer.domElement);\nctrl.target.set(0,2,-8);ctrl.enableDamping=true;ctrl.dampingFactor=0.06;ctrl.minDistance=18;ctrl.maxDistance=140;ctrl.maxPolarAngle=Math.PI/2.05;\nscene.add(new THREE.AmbientLight(0xC0C0C0,0.65));\nconst sun=new THREE.DirectionalLight(0xFFFFFF,0.6);sun.position.set(25,55,35);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-95;sun.shadow.camera.right=95;sun.shadow.camera.top=55;sun.shadow.camera.bottom=-55;scene.add(sun);\nconst fl2=new THREE.DirectionalLight(0xD0D8E0,0.22);fl2.position.set(-30,20,-20);scene.add(fl2);\n\n// ── MATERIAL FACTORY ──────────────────────────────────────────────────────\nfunction matP(color,emissive=0x000000,emissiveIntensity=0,opts={}){\n  return new THREE.MeshPhongMaterial({color,emissive,emissiveIntensity,shininess:20,...opts});\n}\nfunction mkB(w,h,d,col,em=0x000000,ei=0){\n  const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),matP(col,em,ei));\n  m.castShadow=true;m.receiveShadow=true;return m;\n}\nfunction mkC(rt,rb,h,col,em=0x000000,ei=0,seg=12){\n  const m=new THREE.Mesh(new THREE.CylinderGeometry(rt,rb,h,seg),matP(col,em,ei));\n  m.castShadow=true;m.receiveShadow=true;return m;\n}\nfunction addTo(parent,mesh,x,y,z){mesh.position.set(x,y,z);parent.add(mesh);return mesh}\n\n// ── MACHINE SHAPE BUILDERS ────────────────────────────────────────────────\n// Each returns a THREE.Group placed at (0,0,0), caller positions it\n\nfunction mkUnwinder(status){\n  const g=new THREE.Group();const s=mCol('roll',status),em=emCol(status),ei=emInt(status);\n  // two side plates\n  addTo(g,mkB(0.5,7,7,ISA.frame),  -1.8,3.5,0);\n  addTo(g,mkB(0.5,7,7,ISA.frame),   1.8,3.5,0);\n  // main roll (cylinder along X)\n  const roll=mkC(2.2,2.2,3.2,s,em,ei,16);roll.rotation.z=Math.PI/2;\n  addTo(g,roll,0,4,0);\n  // axle\n  const ax=mkC(0.3,0.3,4,0x303030);ax.rotation.z=Math.PI/2;addTo(g,ax,0,4,0);\n  // base\n  addTo(g,mkB(4,0.5,5,ISA.struct),0,0.25,0);\n  return g;\n}\n\nfunction mkRewinder(status){return mkUnwinder(status);}// same shape\n\nfunction mkCoater(status){\n  const g=new THREE.Group();const s=mCol('coater',status),em=emCol(status),ei=emInt(status);\n  // main body\n  addTo(g,mkB(5,5,7,s,em,ei),0,2.5,0);\n  // slot die head (distinctive flat protrusion)\n  addTo(g,mkB(1.2,0.6,5.5,mCol('press',status),em,ei*0.5),2.6,3.8,0);\n  // coating roll (cylinder)\n  const cr=mkC(1.5,1.5,5.5,ISA.roll,em,ei*0.3,14);cr.rotation.x=Math.PI/2;\n  addTo(g,cr,0,5.5,0);\n  // pump body on side\n  addTo(g,mkB(1,2.5,1.5,0x3A3A3A),-3,1.5,-1.5);\n  addTo(g,mkC(0.5,0.5,2.5,0x323232),-3,1.5,-1.5);\n  // base\n  addTo(g,mkB(5.5,0.5,7.5,ISA.struct),0,0.25,0);\n  return g;\n}\n\nfunction mkOven(length,status){\n  const g=new THREE.Group();const s=mCol('oven',status),em=emCol(status),ei=emInt(status);\n  const L=length,H=10,D=8.5;\n  // main shell\n  addTo(g,mkB(L,H,D,s,em,ei),0,H/2,0);\n  // inner dark cavity\n  const cav=mkB(L-1.5,H-2,D-1.5,0x252525);\n  cav.material.transparent=true;cav.material.opacity=0.8;\n  addTo(g,cav,0,H/2,0);\n  // heating elements (visible through sides)\n  const hc=status==='run'?0x7A5020:0x2E2E2E;\n  for(let i=0;i<4;i++){\n    const el=mkB(L-2,0.22,0.35,hc);addTo(g,el,0,2.5+i*2,0);\n    const elz=mkB(0.35,0.22,D-2,hc);addTo(g,elz,0,2.5+i*2,0);\n  }\n  // inspection windows (slightly lighter panels on face)\n  for(let i=0;i<3;i++){\n    const win=mkB(0.12,2.5,1.8,0x404855);addTo(g,win,L/2+0.01,H/2,-(D/2-2)+i*2.5);\n  }\n  // exhaust stack on top\n  addTo(g,mkB(1.2,2.5,1.2,0x3C3C3C),L/2-2,H+1.25,D/4);\n  addTo(g,mkC(0.5,0.5,3,0x323232),L/2-2,H+2.5,D/4);\n  // base feet\n  [-L/2+1,L/2-1].forEach(fx=>[-D/2+1,D/2-1].forEach(fz=>{addTo(g,mkB(0.8,0.6,0.8,ISA.struct),fx,0.3,fz)}));\n  return g;\n}\n\nfunction mkPress(status){\n  const g=new THREE.Group();const s=mCol('press',status),em=emCol(status),ei=emInt(status);\n  const W=8,H=13,D=9;\n  // heavy C-frame sides\n  addTo(g,mkB(1.2,H,D,ISA.frame,em,ei*0.3),-W/2+0.6,H/2,0);\n  addTo(g,mkB(1.2,H,D,ISA.frame,em,ei*0.3), W/2-0.6,H/2,0);\n  // top beam\n  addTo(g,mkB(W,1.5,D,0x303030,em,ei*0.3),0,H-0.75,0);\n  // bottom bed\n  addTo(g,mkB(W,2,D,0x2E2E2E),0,1,0);\n  // top work roll (driven)\n  const wr1=mkC(1.6,1.6,D-1,s,em,ei,14);wr1.rotation.x=Math.PI/2;addTo(g,wr1,0,H*0.62,0);\n  // bottom work roll\n  const wr2=mkC(1.6,1.6,D-1,s,em,ei,14);wr2.rotation.x=Math.PI/2;addTo(g,wr2,0,H*0.62-3.4,0);\n  // backing rolls (larger, behind)\n  const br1=mkC(2.2,2.2,D-1,0x484848);br1.rotation.x=Math.PI/2;addTo(g,br1,0,H*0.62+3.5,0);\n  const br2=mkC(2.2,2.2,D-1,0x484848);br2.rotation.x=Math.PI/2;addTo(g,br2,0,H*0.62-6.5,0);\n  // hydraulic cylinders\n  [-2.5,2.5].forEach(cx=>{addTo(g,mkC(0.5,0.5,4,0x3A3A3A),cx,H-2.5,D/2-1);addTo(g,mkC(0.3,0.3,2,0x585858),cx,H-0.5,D/2-1)});\n  // gap indicator LED strip\n  const led=mkB(W-2,0.15,0.15,status==='run'?0x404840:0x2A2A2A);addTo(g,led,0,H*0.62-1.6,-D/2+0.1);\n  return g;\n}\n\nfunction mkPreheatRolls(status){\n  const g=new THREE.Group();const s=mCol('roll',status),em=emCol(status),ei=emInt(status);\n  // heated roll pair with housing\n  addTo(g,mkB(5.5,6.5,7.5,0x454035,em,ei),0,3.25,0);// warm-tinted housing\n  const r1=mkC(1.8,1.8,6,s,em,ei,14);r1.rotation.x=Math.PI/2;addTo(g,r1,0,5,0);\n  const r2=mkC(1.8,1.8,6,s,em,ei,14);r2.rotation.x=Math.PI/2;addTo(g,r2,0,2.2,0);\n  // temp sensor ports\n  [-2,2].forEach(zz=>{addTo(g,mkC(0.2,0.2,1,0x585858),2.8,5,zz)});\n  addTo(g,mkB(5.5,0.4,7.5,ISA.struct),0,0.2,0);\n  return g;\n}\n\nfunction mkCoolingRolls(status){\n  const g=new THREE.Group();const s=mCol('roll',status),em=emCol(status),ei=emInt(status);\n  // cool-tinted housing\n  addTo(g,mkB(5.5,6,7.5,0x354045,em,ei),0,3,0);\n  const r1=mkC(1.7,1.7,6,s,em,ei,14);r1.rotation.x=Math.PI/2;addTo(g,r1,0,4.6,0);\n  const r2=mkC(1.7,1.7,6,s,em,ei,14);r2.rotation.x=Math.PI/2;addTo(g,r2,0,2.0,0);\n  // cooling water pipes\n  addTo(g,mkC(0.25,0.25,5,0x3A5060),-3,3.5,0);\n  addTo(g,mkB(5.5,0.4,7.5,ISA.struct),0,0.2,0);\n  return g;\n}\n\nfunction mkBetaGauge(status){\n  const g=new THREE.Group();const s=mCol('gauge',status),em=emCol(status),ei=emInt(status);\n  // frame arch\n  addTo(g,mkB(0.35,5,0.35,s,em,ei),0.5,2.5,2.5);\n  addTo(g,mkB(0.35,5,0.35,s,em,ei),0.5,2.5,-2.5);\n  addTo(g,mkB(0.35,0.35,5,s,em,ei),0.5,5,0);\n  // sensor heads (top & bottom, source+detector)\n  addTo(g,mkB(1,0.6,1,status==='run'?0x405080:0x2E2E2E,em,ei),0.5,5.8,0);\n  addTo(g,mkB(1,0.6,1,status==='run'?0x405080:0x2E2E2E,em,ei),0.5,4.2,0);\n  // cabinet\n  addTo(g,mkB(1.5,3,2,0x3A3A3A),-1.2,1.5,0);\n  return g;\n}\n\nfunction mkCPC(status){\n  const g=new THREE.Group();const s=mCol('gauge',status),em=emCol(status),ei=emInt(status);\n  // guide rail\n  addTo(g,mkB(0.3,4,6,s,em,ei),0,2,0);\n  // actuator\n  addTo(g,mkB(1.5,1.5,1.5,0x3A3A3A),-1,3,0);\n  addTo(g,mkC(0.3,0.3,2,0x505050),0,1,0);\n  return g;\n}\n\nfunction mkCCD(status){\n  const g=new THREE.Group();const s=mCol('ccd',status),em=emCol(status),ei=emInt(status);\n  // camera arch (gantry)\n  addTo(g,mkB(0.3,5,0.3,ISA.struct),0.5,2.5,3);\n  addTo(g,mkB(0.3,5,0.3,ISA.struct),0.5,2.5,-3);\n  addTo(g,mkB(0.3,0.35,6.5,ISA.struct),0.5,5.2,0);\n  // camera bodies (top array)\n  [-1.5,0,1.5].forEach(zz=>{\n    addTo(g,mkB(1.2,0.8,0.9,s,em,ei),0.5,4.9,zz);\n    // lens\n    addTo(g,mkC(0.3,0.3,0.5,status==='run'?0x304050:0x252525),1.1,4.9,zz);\n  });\n  // controller box\n  addTo(g,mkB(1.5,2.5,2,0x3A3A3A),-1.2,1.5,0);\n  return g;\n}\n\nfunction mkHalfSplitter(status){\n  const g=new THREE.Group();const s=mCol('run',status),em=emCol(status),ei=emInt(status);\n  // main body\n  addTo(g,mkB(4,5.5,7,s,em,ei),0,2.75,0);\n  // slitter shaft\n  const sh=mkC(0.25,0.25,6.5,0x484848);sh.rotation.x=Math.PI/2;addTo(g,sh,0,3.5,0);\n  // two blade discs\n  [-0.5,0.5].forEach(xo=>{const bd=mkC(1.2,1.2,0.22,0x505060);bd.rotation.x=Math.PI/2;addTo(g,bd,xo,3.5,0)});\n  // output guides (two small rolls diverging)\n  const o1=mkC(0.5,0.5,2.5,ISA.roll);o1.rotation.x=Math.PI/2;addTo(g,o1,-1.2,1.5,0);\n  const o2=mkC(0.5,0.5,2.5,ISA.roll);o2.rotation.x=Math.PI/2;addTo(g,o2, 1.2,1.5,0);\n  addTo(g,mkB(4.5,0.4,7.5,ISA.struct),0,0.2,0);\n  return g;\n}\n\nfunction mkNGMarker(status){\n  const g=new THREE.Group();const s=mCol('gauge',status),em=emCol(status),ei=emInt(status);\n  addTo(g,mkB(2,4.5,4,s,em,ei),0,2.25,0);\n  // laser head\n  addTo(g,mkB(0.6,0.6,3.5,status==='run'?0x604040:0x2E2E2E,em,ei),1.1,4.5,0);\n  // beam (thin line)\n  if(status==='run'){const bm=mkB(0.05,0.05,3.5,0x802020);addTo(g,bm,1.1,4.5,0)}\n  return g;\n}\n\nfunction mkTensionCtrl(status){\n  const g=new THREE.Group();const s=mCol('gauge',status),em=emCol(status),ei=emInt(status);\n  // dancer roll\n  const dr=mkC(0.7,0.7,6,s,em,ei,12);dr.rotation.x=Math.PI/2;addTo(g,dr,0,4,0);\n  // arm\n  addTo(g,mkB(0.3,3,0.3,s,em,ei),-1.5,2.5,2.5);\n  addTo(g,mkB(0.3,3,0.3,s,em,ei),-1.5,2.5,-2.5);\n  // controller\n  addTo(g,mkB(1.5,3,2,0x3A3A3A),-2.5,1.5,0);\n  return g;\n}\n\n// ── EQUIPMENT LISTS (tag, shape-builder fn, x position, label) ────────────\nconst COAT_EQ=[\n  {tag:'UW',    fn:()=>mkUnwinder,     x:-38,   lbl:'UNWINDER',      zo:0},\n  {tag:'BG1',   fn:()=>mkBetaGauge,   x:-31.5, lbl:'β-GAUGE 1',     zo:0},\n  {tag:'CPC1',  fn:()=>mkCPC,         x:-27.5, lbl:'CPC 1',         zo:0},\n  {tag:'A-CTR', fn:()=>mkCoater,      x:-20,   lbl:'A-COATER',      zo:0},\n  {tag:'BG2',   fn:()=>mkBetaGauge,   x:-13.5, lbl:'β-GAUGE 2',     zo:0},\n  {tag:'CCD1',  fn:()=>mkCCD,         x:-10.5, lbl:'CCD #1',        zo:0},\n  {tag:'OVN-A', fn:(st)=>()=>mkOven(16,st), x:-0.5, lbl:'OVEN A-SIDE', zo:0},\n  {tag:'BG3',   fn:()=>mkBetaGauge,   x:8.5,   lbl:'β-GAUGE 3',     zo:0},\n  {tag:'CPC2',  fn:()=>mkCPC,         x:12,    lbl:'CPC 2',         zo:0},\n  {tag:'B-CTR', fn:()=>mkCoater,      x:19,    lbl:'B-COATER',      zo:0},\n  {tag:'BG4',   fn:()=>mkBetaGauge,   x:26,    lbl:'β-GAUGE 4',     zo:0},\n  {tag:'CCD2',  fn:()=>mkCCD,         x:29.5,  lbl:'CCD #2',        zo:0},\n  {tag:'OVN-B', fn:(st)=>()=>mkOven(16,st), x:39.5, lbl:'OVEN B-SIDE', zo:0},\n  {tag:'BG5',   fn:()=>mkBetaGauge,   x:49,    lbl:'β-GAUGE 5',     zo:0},\n  {tag:'CCD3',  fn:()=>mkCCD,         x:52.5,  lbl:'CCD #3 A+B',    zo:0},\n  {tag:'MRK',   fn:()=>mkNGMarker,    x:57,    lbl:'NG MARKER',     zo:0},\n  {tag:'SPLT',  fn:()=>mkHalfSplitter,x:62,    lbl:'HALF SPLITTER', zo:0},\n  {tag:'CCD4',  fn:()=>mkCCD,         x:68,    lbl:'CCD #4',        zo:0},\n  {tag:'RW1',   fn:()=>mkRewinder,    x:74,    lbl:'REWINDER 1',    zo:-2.5},\n  {tag:'RW2',   fn:()=>mkRewinder,    x:74,    lbl:'REWINDER 2',    zo:2.5}\n];\nconst CAL_ANODE_EQ=[\n  {tag:'UW',  fn:()=>mkUnwinder,       x:-35,  lbl:'UNWINDER',        zo:0},\n  {tag:'TEN', fn:()=>mkTensionCtrl,    x:-27,  lbl:'TENSION CTRL',    zo:0},\n  {tag:'PR1', fn:()=>mkPress,          x:-17,  lbl:'PRESS 1',         zo:0},\n  {tag:'PR2', fn:()=>mkPress,          x:-4,   lbl:'PRESS 2',         zo:0},\n  {tag:'TG',  fn:()=>mkBetaGauge,      x:7,    lbl:'THICKNESS GAUGE', zo:0},\n  {tag:'VIS', fn:()=>mkCCD,            x:12,   lbl:'VISION SYSTEM',   zo:0},\n  {tag:'MRK', fn:()=>mkNGMarker,       x:17,   lbl:'NG LASER MARK',   zo:0},\n  {tag:'RW',  fn:()=>mkRewinder,       x:27,   lbl:'REWINDER',        zo:0}\n];\nconst CAL_CATH_EQ=[\n  {tag:'UW',  fn:()=>mkUnwinder,       x:-35,  lbl:'UNWINDER',        zo:0},\n  {tag:'TEN', fn:()=>mkTensionCtrl,    x:-27,  lbl:'TENSION CTRL',    zo:0},\n  {tag:'PHT', fn:()=>mkPreheatRolls,   x:-20,  lbl:'PREHEAT ROLLS',   zo:0},\n  {tag:'HPR', fn:()=>mkPress,          x:-8,   lbl:'HOT PRESS',       zo:0},\n  {tag:'CLR', fn:()=>mkCoolingRolls,   x:4,    lbl:'COOLING ROLLS',   zo:0},\n  {tag:'TG',  fn:()=>mkBetaGauge,      x:12,   lbl:'THICKNESS GAUGE', zo:0},\n  {tag:'VIS', fn:()=>mkCCD,            x:17,   lbl:'VISION SYSTEM',   zo:0},\n  {tag:'RW',  fn:()=>mkRewinder,       x:27,   lbl:'REWINDER',        zo:0}\n];\nconst LINE_EQ={E1:COAT_EQ,E2:COAT_EQ,E3:CAL_ANODE_EQ,E4:CAL_CATH_EQ};\nconst LINE_LEN=88, LINE_W=9, LINE_H=12;\nconst LINES_Z=[-24,-13,-2,9];\nconst LINE_IDS=['E1','E2','E3','E4'];\nconst LINE_ACCS=[0x7A9EBF,0x7BAF72,0xC8A060,0x9878C0];\nconst LINE_ACC_HEX={E1:'#7A9EBF',E2:'#7BAF72',E3:'#C8A060',E4:'#9878C0'};\nconst LNAMES={E1:'ANODE COATING',E2:'CATHODE COATING',E3:'ANODE CALENDER',E4:'CATHODE CALENDER'};\n\n// ── SCENE STORAGE ─────────────────────────────────────────────────────────\nconst hoverHighlights={};   // lineId -> highlight mesh\nconst clickProxies=[];       // for hover detection only\nconst beacons={};\nconst machineMeshes={};     // lineId -> [{tag, group, labelDiv}]\nconst lineMeshGroups={};    // lineId -> all meshes for highlight\n\n// ── FLOOR & GRID ──────────────────────────────────────────────────────────\nconst flr=new THREE.Mesh(new THREE.PlaneGeometry(240,120),new THREE.MeshLambertMaterial({color:ISA.floor}));\nflr.rotation.x=-Math.PI/2;flr.receiveShadow=true;scene.add(flr);\nscene.add(new THREE.GridHelper(240,60,0x393939,0x353535));\n\n// ── ZONE SHELL ────────────────────────────────────────────────────────────\n(function(){\n  const cz=(LINES_Z[0]+LINES_Z[3])/2,sw=LINE_LEN+12,sd=(LINES_Z[3]-LINES_Z[0])+LINE_W+8;\n  // floor slab\n  const sl=mkB(sw,0.2,sd,0x2A2A2A);sl.position.set(0,0.1,cz);scene.add(sl);\n  // columns\n  [[  -sw/2,LINES_Z[0]-LINE_W/2-1],[sw/2,LINES_Z[0]-LINE_W/2-1],\n   [-sw/2,LINES_Z[3]+LINE_W/2+1], [sw/2,LINES_Z[3]+LINE_W/2+1],\n   [-sw/2,cz],[sw/2,cz]\n  ].forEach(([x,z])=>{const c=mkB(0.8,LINE_H+4,0.8,ISA.struct);c.position.set(x,(LINE_H+4)/2,z);scene.add(c)});\n  // roof trusses\n  for(let xi=-sw/2+10;xi<=sw/2;xi+=18){const t=mkB(0.35,0.45,sd,0x3C3C3C);t.position.set(xi,LINE_H+2.5,cz);scene.add(t)}\n  [LINES_Z[0]-LINE_W/2-1,LINES_Z[3]+LINE_W/2+1].forEach(tz=>{const t=mkB(sw,0.35,0.45,0x3C3C3C);t.position.set(0,LINE_H+2.2,tz);scene.add(t)});\n  const rp=mkB(sw,0.18,sd,0x363636);rp.material.opacity=0.38;rp.material.transparent=true;rp.position.set(0,LINE_H+2.6,cz);scene.add(rp);\n  // zone title\n  const d=document.createElement('div');\n  d.style.cssText=\"font-family:'IBM Plex Sans Condensed',sans-serif;font-weight:600;font-size:12px;letter-spacing:4px;color:#585858;pointer-events:none;white-space:nowrap;\";\n  d.textContent='E ZONE — ELECTRODE  |  AGRATAS GIGAFACTORY SANAND';\n  const lobj=new THREE.CSS2DObject(d);lobj.position.set(0,0.1,LINES_Z[3]+LINE_W/2+6);scene.add(lobj);\n})();\n\n// ── BUILD LINE ─────────────────────────────────────────────────────────────\nfunction buildLine(lid,lz,acc){\n  const s=S[lid];\n  lineMeshGroups[lid]=[];\n  machineMeshes[lid]=[];\n\n  // slab\n  const sl=mkB(LINE_LEN,0.25,LINE_W-0.4,ISA.slab);sl.position.set(0,0.12,lz);scene.add(sl);lineMeshGroups[lid].push(sl);\n  // accent stripe\n  const str=mkB(LINE_LEN,0.07,LINE_W-0.4,acc);str.material.transparent=true;str.material.opacity=0.28;str.position.set(0,0.27,lz);scene.add(str);lineMeshGroups[lid].push(str);\n  // conveyor web belt\n  const cv=mkB(LINE_LEN-4,0.14,0.85,ISA.conv);cv.material.transparent=true;cv.material.opacity=0.55;cv.position.set(0,0.33,lz);scene.add(cv);\n\n  // ── MACHINES ──────────────────────────────────────────────────────────\n  LINE_EQ[lid].forEach(eq=>{\n    const mStatus=s.machines[eq.tag]||s.status;\n    // build shape\n    let builderFn;\n    if(eq.tag==='OVN-A'||eq.tag==='OVN-B'){builderFn=()=>mkOven(16,mStatus);}\n    else{builderFn=eq.fn(mStatus);}\n    const grp=builderFn(mStatus);\n    grp.position.set(eq.x, 0.25, lz+(eq.zo||0));\n    scene.add(grp);\n    grp.userData={lineId:lid,tag:eq.tag,label:eq.lbl,status:mStatus};\n    lineMeshGroups[lid].push(grp);\n\n    // traverse all children and tag them\n    grp.traverse(m=>{if(m.isMesh){m.userData={lineId:lid,tag:eq.tag,label:eq.lbl,status:mStatus};clickProxies.push(m)}});\n\n    // CSS2D tag label\n    const lDiv=document.createElement('div');\n    lDiv.className='eq-label'+(mStatus==='fault'?' flt':mStatus==='warn'?' warn':'');\n    lDiv.textContent=eq.tag;\n    if(mStatus==='fault'||mStatus==='warn') lDiv.classList.add(mStatus==='fault'?'flt':'warn');\n    const lObj=new THREE.CSS2DObject(lDiv);\n    lObj.position.set(0,13,0);grp.add(lObj);\n    machineMeshes[lid].push({tag:eq.tag,label:eq.lbl,grp,lDiv,status:mStatus});\n  });\n\n  // ── HOVER HIGHLIGHT BOX (invisible by default) ─────────────────────────\n  const hlGeo=new THREE.BoxGeometry(LINE_LEN+1,LINE_H+3,LINE_W+2);\n  const hlMat=new THREE.MeshBasicMaterial({color:acc,transparent:true,opacity:0,wireframe:false,side:THREE.BackSide});\n  const hl=new THREE.Mesh(hlGeo,hlMat);\n  hl.position.set(0,(LINE_H+3)/2,lz);scene.add(hl);\n  hoverHighlights[lid]=hl;\n\n  // ── BEACON ────────────────────────────────────────────────────────────\n  const bH=LINE_H+1;\n  const post=mkB(0.2,bH,0.2,0x303030);post.position.set(-LINE_LEN/2+2.5,bH/2,lz-LINE_W/2+0.8);scene.add(post);\n  const bCol=s.status==='warn'?ISA.warn:s.status==='fault'?ISA.flt:0x3C3C3C;\n  const bcn=new THREE.Mesh(new THREE.SphereGeometry(0.5,8,8),\n    new THREE.MeshPhongMaterial({color:bCol,emissive:s.status!=='run'?bCol:0x000000,emissiveIntensity:s.status!=='run'?0.5:0}));\n  bcn.position.set(-LINE_LEN/2+2.5,bH+0.5,lz-LINE_W/2+0.8);scene.add(bcn);beacons[lid]=bcn;\n\n  // ── LINE HEADER LABEL (click = navigate) ─────────────────────────────\n  const hDiv=document.createElement('div');hDiv.className='line-hdr';\n  hDiv.style.color='#'+acc.toString(16).padStart(6,'0');\n  hDiv.style.borderLeftColor='#'+acc.toString(16).padStart(6,'0');\n  hDiv.innerHTML=`${lid} &nbsp;·&nbsp; ${LNAMES[lid]}`;\n  hDiv.title='Click to open '+lid+' SCADA';\n  hDiv.addEventListener('click',e=>{e.stopPropagation();navLine(lid);});\n  const hLbl=new THREE.CSS2DObject(hDiv);\n  hLbl.position.set(-LINE_LEN/2+6,LINE_H+1.5,lz);scene.add(hLbl);\n\n  // OEE at end\n  const oDiv=document.createElement('div');oDiv.className='eq-label';oDiv.id='l3d-'+lid;\n  oDiv.innerHTML='OEE&nbsp;'+s.oee.toFixed(1)+'%';\n  const oLbl=new THREE.CSS2DObject(oDiv);oLbl.position.set(LINE_LEN/2-4,8,lz);scene.add(oLbl);\n\n  // Large invisible proxy per line (hover detection only, NOT click nav)\n  const px=mkB(LINE_LEN,LINE_H+3,LINE_W+1,0xFFFFFF);\n  px.material.transparent=true;px.material.opacity=0;\n  px.position.set(0,(LINE_H+3)/2,lz);\n  px.userData={lineId:lid,isProxy:true};\n  scene.add(px);\n}\nLINE_IDS.forEach((id,i)=>buildLine(id,LINES_Z[i],LINE_ACCS[i]));\n\n// ── PRODUCT FLOW PARTICLES ─────────────────────────────────────────────────\nconst particles=[];\nLINES_Z.forEach((lz,li)=>{\n  const lid=LINE_IDS[li];\n  for(let i=0;i<14;i++){\n    const col=lid==='E2'||lid==='E4'?0x9A9870:0xA0A0A0;\n    const m=new THREE.Mesh(new THREE.SphereGeometry(0.2,5,5),\n      new THREE.MeshPhongMaterial({color:col,emissive:col,emissiveIntensity:0.12}));\n    m.userData={lz,t:i/14,lid};scene.add(m);particles.push(m);\n  }\n});\nfunction tickParticles(dt){\n  particles.forEach(p=>{\n    const s=S[p.userData.lid];if(s.status==='idle'){p.visible=false;return}p.visible=true;\n    const spd=(s.webSpeed||20)/22.5*0.17;\n    p.userData.t=(p.userData.t+spd*dt)%1;\n    p.position.set(-LINE_LEN/2+2+p.userData.t*(LINE_LEN-4),0.52,p.userData.lz);\n  });\n}\n\n// ── RAYCASTER — hover only, no click nav ──────────────────────────────────\nconst rc=new THREE.Raycaster(),mv=new THREE.Vector2();\nconst tt=document.getElementById('tt');\nlet hovL=null, hovMachine=null;\n\n// Collect all line proxy objects (not machine meshes) for line hover\nconst lineProxies=[];\nscene.traverse(obj=>{if(obj.isMesh&&obj.userData.isProxy&&obj.userData.lineId)lineProxies.push(obj)});\n\nrenderer.domElement.addEventListener('mousemove',e=>{\n  mv.x=(e.clientX/window.innerWidth)*2-1;\n  mv.y=-((e.clientY/(window.innerHeight-130))*2-1);\n  rc.setFromCamera(mv,camera);\n\n  // Check machine meshes first (fine-grained)\n  const mHits=rc.intersectObjects(clickProxies.filter(m=>!m.userData.isProxy));\n  // Then line proxy\n  const lHits=rc.intersectObjects(lineProxies);\n\n  let newL=null, newM=null;\n  if(lHits.length) newL=lHits[0].object.userData.lineId;\n  if(mHits.length&&mHits[0].object.userData.tag){\n    newM=mHits[0].object.userData;\n    newL=newM.lineId;\n  }\n\n  // Update line highlight\n  if(newL!==hovL){\n    if(hovL) hoverHighlights[hovL].material.opacity=0;\n    hovL=newL;\n    if(hovL){\n      hoverHighlights[hovL].material.opacity=0.055;\n      hoverHighlights[hovL].material.color.set(LINE_ACCS[LINE_IDS.indexOf(hovL)]);\n    }\n  }\n\n  if(newM&&newM.tag){\n    // Machine tooltip\n    renderer.domElement.style.cursor='crosshair';\n    const mSt=S[newM.lineId].machines[newM.tag]||S[newM.lineId].status;\n    const sc=mSt==='fault'?'#C82828':mSt==='warn'?'#C8C000':'#C0C0C0';\n    const ac=LINE_ACC_HEX[newM.lineId];\n    tt.style.borderLeftColor=sc;tt.style.display='block';\n    tt.style.left=(e.clientX+14)+'px';tt.style.top=(e.clientY-10)+'px';\n    tt.innerHTML=`<div class=\"tt-t\">${newM.tag} — ${newM.label}</div>\n<div class=\"tt-r\">LINE <em style=\"color:${ac}\">${newM.lineId}</em></div>\n<div class=\"tt-r\">STATUS <em style=\"color:${sc}\">${mSt.toUpperCase()}</em></div>\n${mSt==='fault'?'<div class=\"tt-r\">⚠ FAULT — IMMEDIATE ACTION REQUIRED <em></em></div>':''}\n${mSt==='warn'?'<div class=\"tt-r\">⚠ WARNING — CHECK REQUIRED <em></em></div>':''}\n<div class=\"tt-h\">Machine-level status from OPC tag</div>`;\n    hovMachine=newM;\n  } else if(newL&&!newM){\n    // Line tooltip\n    renderer.domElement.style.cursor='default';\n    const s=S[newL];const ac=LINE_ACC_HEX[newL];\n    const sc=s.status==='warn'?'#C8C000':s.status==='fault'?'#C82828':'#C0C0C0';\n    tt.style.borderLeftColor=ac;tt.style.display='block';\n    tt.style.left=(e.clientX+14)+'px';tt.style.top=(e.clientY-10)+'px';\n    let ex='';\n    if(newL==='E1'||newL==='E2')ex=`<div class=\"tt-r\">WEB SPEED <em>${s.webSpeed?.toFixed(1)} m/min</em></div><div class=\"tt-r\">OVEN-A <em>${s.ovenTempA?.toFixed(1)}°C</em></div><div class=\"tt-r\">OVEN-B <em>${s.ovenTempB?.toFixed(1)}°C</em></div>`;\n    else ex=`<div class=\"tt-r\">PRESS GAP <em>${s.pressGap} mm</em></div><div class=\"tt-r\">${newL==='E4'?'ROLL TEMP':'PRESS FORCE'} <em>${newL==='E4'?s.calTemp+'°C':s.pressForce+' kN'}</em></div>`;\n    tt.innerHTML=`<div class=\"tt-t\">${newL} — ${LNAMES[newL]}</div>\n<div class=\"tt-r\">STATUS <em style=\"color:${sc}\">${s.status.toUpperCase()}</em></div>\n<div class=\"tt-r\">OEE <em>${s.oee.toFixed(1)}%</em></div>\n<div class=\"tt-r\">AVAILABILITY <em>${s.avail}%</em></div>\n<div class=\"tt-r\">PERFORMANCE <em>${s.perf}%</em></div>\n<div class=\"tt-r\">QUALITY <em>${s.qual}%</em></div>\n${ex}\n<div class=\"tt-r\">ACTIVE ALARMS <em style=\"color:${s.alarms>3?'#C82828':s.alarms>0?'#C8C000':'#C0C0C0'}\">${s.alarms}</em></div>\n<div class=\"tt-h\">▸ Click line name label to open SCADA</div>`;\n    hovMachine=null;\n  } else {\n    tt.style.display='none';hovMachine=null;\n    renderer.domElement.style.cursor='default';\n  }\n});\nrenderer.domElement.addEventListener('mouseleave',()=>{\n  tt.style.display='none';hovMachine=null;\n  if(hovL){hoverHighlights[hovL].material.opacity=0;hovL=null;}\n});\n\n// ── IGNITION LISTENERS ────────────────────────────────────────────────────\nwindow.addEventListener('message',e=>{\n  try{const d=typeof e.data==='string'?JSON.parse(e.data):e.data;\n    if(d&&d.type==='EZONE_UPDATE')applyData(d);\n    if(d&&d.type==='MACHINE_UPDATE')applyMachineData(d);\n  }catch(_){}\n});\n(function(){const p=new URLSearchParams(window.location.search);if(!p.has('oeeE1'))return;\n  applyData({oeeE1:p.get('oeeE1'),oeeE2:p.get('oeeE2'),oeeE3:p.get('oeeE3'),oeeE4:p.get('oeeE4'),statusE1:p.get('statusE1'),statusE2:p.get('statusE2'),statusE3:p.get('statusE3'),statusE4:p.get('statusE4'),alarmsE1:p.get('alarmsE1')||0,alarmsE2:p.get('alarmsE2')||0,alarmsE3:p.get('alarmsE3')||0,alarmsE4:p.get('alarmsE4')||0})\n})();\nif(WEBDEV_URL)setInterval(()=>fetch(WEBDEV_URL).then(r=>r.json()).then(applyData).catch(()=>{}),5000);\n\n// ── MACHINE-LEVEL UPDATE (separate payload from Ignition) ─────────────────\n// {type:\"MACHINE_UPDATE\", E1_OVN-A:\"warn\", E4_HPR:\"fault\", E1_CCD3:\"run\", ...}\nfunction applyMachineData(d){\n  ['E1','E2','E3','E4'].forEach(lid=>{\n    Object.keys(d).forEach(k=>{\n      if(k.startsWith(lid+'_')){\n        const tag=k.replace(lid+'_','');\n        const newSt=d[k];\n        if(S[lid].machines[tag]!==undefined){\n          S[lid].machines[tag]=newSt;\n          // update 3D mesh colors\n          const entry=machineMeshes[lid].find(m=>m.tag===tag);\n          if(entry){\n            entry.grp.traverse(m=>{\n              if(m.isMesh&&m.material){\n                m.material.emissive&&m.material.emissive.set(emCol(newSt));\n                if(m.material.emissiveIntensity!==undefined) m.material.emissiveIntensity=emInt(newSt);\n              }\n            });\n            entry.lDiv.className='eq-label'+(newSt==='fault'?' flt':newSt==='warn'?' warn':'');\n            entry.status=newSt;\n          }\n        }\n      }\n    });\n  });\n}\n\nfunction applyData(d){\n  ['E1','E2','E3','E4'].forEach(l=>{\n    if(d['oee'+l]!=null)S[l].oee=parseFloat(d['oee'+l]);\n    if(d['status'+l]!=null)S[l].status=d['status'+l];\n    if(d['alarms'+l]!=null)S[l].alarms=parseInt(d['alarms'+l]);\n    if(d['webSpeed'+l]!=null)S[l].webSpeed=parseFloat(d['webSpeed'+l]);\n    if(d['ovenTempA'+l]!=null)S[l].ovenTempA=parseFloat(d['ovenTempA'+l]);\n    if(d['ovenTempB'+l]!=null)S[l].ovenTempB=parseFloat(d['ovenTempB'+l]);\n    if(d['pressGap'+l]!=null)S[l].pressGap=parseFloat(d['pressGap'+l]);\n    if(d['calTemp'+l]!=null)S[l].calTemp=parseFloat(d['calTemp'+l]);\n  });\n  refreshCards();\n}\nfunction refreshCards(){\n  const SLBL={run:'RUNNING',warn:'WARNING',fault:'FAULT',idle:'IDLE'};\n  ['E1','E2','E3','E4'].forEach(l=>{\n    const s=S[l];\n    document.getElementById('oee-'+l).textContent=s.oee.toFixed(1);\n    document.getElementById('bar-'+l).style.width=s.oee+'%';\n    const se=document.getElementById('st-'+l);se.textContent=SLBL[s.status]||'IDLE';se.className='st s-'+(s.status==='fault'?'flt':s.status||'idle');\n    const ae=document.getElementById('alm-'+l);ae.textContent=s.alarms;ae.style.color=s.alarms>3?'#C82828':s.alarms>0?'#C8C000':'#C0C0C0';\n    if(l==='E1'||l==='E2'){document.getElementById('spd-'+l).textContent=(s.webSpeed||0).toFixed(1);document.getElementById('tmp-'+l).textContent=(s.ovenTempA?.toFixed(0)||'--')+'°C'}\n    else{document.getElementById('gap-'+l).textContent=(s.pressGap||0).toFixed(3);if(l==='E4'&&s.calTemp)document.getElementById('ctmp-E4').textContent=s.calTemp.toFixed(0)+'°C';if(l==='E3'&&s.pressForce)document.getElementById('frc-E3').textContent=s.pressForce.toFixed(0)}\n    const l3=document.getElementById('l3d-'+l);if(l3)l3.innerHTML='OEE&nbsp;'+s.oee.toFixed(1)+'%';\n  });\n  const sm=((S.E1.oee+S.E2.oee+S.E3.oee+S.E4.oee)/4).toFixed(1);\n  document.getElementById('oee-S').textContent=sm;document.getElementById('bar-S').style.width=sm+'%';\n  document.getElementById('alm-S').textContent=S.E1.alarms+S.E2.alarms+S.E3.alarms+S.E4.alarms;\n}\n\nfunction navLine(l){const f=document.getElementById('flash');f.style.opacity='1';setTimeout(()=>{f.style.opacity='0';if(LINE_URLS[l])window.open(LINE_URLS[l],'_blank')},160)}\n\n// ── SIMULATION ────────────────────────────────────────────────────────────\nconst _t={E1:84.1,E2:81.2,E3:83.5,E4:80.8};let bPh=0;\nsetInterval(()=>{\n  ['E1','E2','E3','E4'].forEach(l=>{\n    _t[l]+=(Math.random()-.5)*.35;_t[l]=Math.max(65,Math.min(96,_t[l]));\n    S[l].oee+=(_t[l]-S[l].oee)*.25;\n    if(S[l].webSpeed)S[l].webSpeed+=(Math.random()-.5)*.2;\n    if(S[l].ovenTempA)S[l].ovenTempA+=(Math.random()-.5)*.5;\n  });\n  refreshCards();\n},3500);\n\n// ── RENDER ────────────────────────────────────────────────────────────────\nlet last=0;\nfunction animate(ts){\n  requestAnimationFrame(animate);const dt=Math.min((ts-last)/1000,.05);last=ts;bPh+=dt*2.2;\n  ['E1','E2','E3','E4'].forEach(l=>{\n    const b=beacons[l],s=S[l];\n    if(s.status==='warn')b.material.emissiveIntensity=0.3+0.3*Math.sin(bPh);\n    else if(s.status==='fault')b.material.emissiveIntensity=0.5+0.45*Math.sin(bPh*3);\n    else b.material.emissiveIntensity=0;\n    // per-machine fault blink on label\n    machineMeshes[l].forEach(mc=>{\n      if(mc.status==='fault'){\n        mc.grp.traverse(m=>{if(m.isMesh&&m.material&&m.material.emissiveIntensity!==undefined)m.material.emissiveIntensity=0.25+0.25*Math.sin(bPh*3)});\n      } else if(mc.status==='warn'){\n        mc.grp.traverse(m=>{if(m.isMesh&&m.material&&m.material.emissiveIntensity!==undefined)m.material.emissiveIntensity=0.15+0.15*Math.sin(bPh*1.5)});\n      }\n    });\n  });\n  tickParticles(dt);ctrl.update();renderer.render(scene,camera);labelR.render(scene,camera);\n}\nanimate(0);\nwindow.addEventListener('resize',()=>{const w=window.innerWidth,h=window.innerHeight-130;camera.aspect=w/h;camera.updateProjectionMatrix();renderer.setSize(w,h);labelR.setSize(w,h)});\n</script>\n</body>\n</html>\n"
}