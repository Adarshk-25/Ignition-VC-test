{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>AGRATAS — GIGAFACTORY SANAND</title>\n<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n\n<style>\n* { margin:0; padding:0; box-sizing:border-box; }\nhtml, body { width:100%; height:100%; overflow:hidden;\n  background:#2E2E2E; font-family:'IBM Plex Sans Condensed',sans-serif; }\n\n#three-canvas { position:fixed; inset:0; }\n\n/* ── BOTTOM STATUS BAR ── */\n#statusbar {\n  position:fixed; bottom:0; left:0; right:0; height:110px; z-index:100;\n  display:flex;\n  background:rgba(38,38,38,0.97);\n  border-top:1px solid #4A4A4A;\n}\n.scard {\n  flex:1; padding:9px 14px; border-right:1px solid #3E3E3E;\n  cursor:pointer; position:relative; overflow:hidden;\n  display:flex; flex-direction:column; gap:3px;\n  transition:background .15s;\n}\n.scard:last-child { border-right:none; }\n.scard[data-z=\"C\"] { flex:.6; cursor:default; background:#242424; }\n.scard:not([data-z=\"C\"]):hover { background:rgba(255,255,255,.04); }\n.scard::after { content:''; position:absolute; top:0; left:0; right:0; height:2px; }\n.scard[data-z=\"E\"]::after { background:#8AAAD0; }\n.scard[data-z=\"A\"]::after { background:#88A870; }\n.scard[data-z=\"B\"]::after { background:#C89060; }\n\n.sc-r1 { display:flex; justify-content:space-between; align-items:flex-start; margin-top:3px; }\n.sc-name { font-weight:600; font-size:11px; letter-spacing:3px; color:#D2D2D2; }\n.sc-proc { font-family:'IBM Plex Mono',monospace; font-size:7px; color:#686868; letter-spacing:.3px; margin-top:1px; }\n.sc-stat {\n  font-family:'IBM Plex Mono',monospace; font-size:8px; letter-spacing:1px;\n  padding:1px 5px; border:1px solid currentColor;\n}\n.s-run   { color:#A8A8A8; border-color:rgba(168,168,168,.3); background:rgba(168,168,168,.06); }\n.s-warn  { color:#C8C000; border-color:rgba(200,192,0,.4);   background:rgba(200,192,0,.08); animation:bk 1.8s infinite; }\n.s-fault { color:#C82828; border-color:rgba(200,40,40,.5);   background:rgba(200,40,40,.1);  animation:bk 1s infinite; }\n.s-idle  { color:#606060; border-color:rgba(96,96,96,.25); }\n@keyframes bk { 0%,100%{opacity:1} 50%{opacity:.4} }\n\n.sc-oee  { font-weight:600; font-size:28px; line-height:1; color:#D2D2D2; }\n.sc-unit { font-family:'IBM Plex Mono',monospace; font-size:8px; color:#686868; }\n.sc-bar  { height:2px; background:rgba(255,255,255,.07); }\n.sc-fill { height:100%; background:#787878; transition:width 1.2s ease; }\n.sc-subs { display:flex; gap:10px; }\n.sv { font-family:'IBM Plex Mono',monospace; font-size:10px; color:#C0C0C0; }\n.sl { font-family:'IBM Plex Mono',monospace; font-size:7px; color:#585858; letter-spacing:.3px; }\n\n/* ── ZONE LABELS in 3D (CSS2D) ── */\n.label3d {\n  font-family:'IBM Plex Mono',monospace;\n  background:rgba(36,36,36,0.92);\n  border:1px solid #505050;\n  padding:4px 8px; pointer-events:none;\n  white-space:nowrap;\n}\n.label3d .lname { font-family:'IBM Plex Sans Condensed',sans-serif; font-weight:600; font-size:12px; letter-spacing:2px; color:#D2D2D2; }\n.label3d .loee  { font-size:10px; color:#A0A0A0; margin-top:2px; }\n.label3d .lalm  { font-size:9px; margin-top:1px; }\n\n/* ── LINE LABELS ── */\n.linelabel {\n  font-family:'IBM Plex Mono',monospace; font-size:8px;\n  color:#909090; background:rgba(36,36,36,0.85);\n  border:1px solid #404040; padding:2px 5px;\n  pointer-events:none; white-space:nowrap;\n}\n\n/* ── TOOLTIP ── */\n#tt {\n  position:fixed; z-index:500; pointer-events:none; display:none;\n  background:#262626; border:1px solid #4A4A4A; border-left:2px solid #787878;\n  padding:10px 14px; font-family:'IBM Plex Mono',monospace; font-size:10px;\n}\n.tt-title { font-family:'IBM Plex Sans Condensed',sans-serif; font-weight:600;\n  font-size:13px; letter-spacing:2px; color:#D2D2D2; margin-bottom:6px; }\n.tt-row { display:flex; justify-content:space-between; gap:18px; color:#686868; margin:2px 0; }\n.tt-row em { color:#C0C0C0; font-style:normal; }\n.tt-hint { margin-top:7px; font-size:8px; color:#505050; letter-spacing:1px; }\n\n/* ── NAV FLASH ── */\n#flash { position:fixed; inset:0; background:rgba(200,200,200,.06);\n  opacity:0; pointer-events:none; transition:opacity .12s; z-index:9999; }\n</style>\n</head>\n<body>\n\n<div id=\"three-canvas\"></div>\n\n<div id=\"statusbar\">\n\n  <div class=\"scard\" data-z=\"C\">\n  <div class=\"sc-r1\">\n    <div class=\"sc-name\" style=\"font-size:9px;letter-spacing:1.5px\">CENTRAL SCADA</div>\n    <div class=\"sc-stat s-run\">ONLINE</div>\n  </div>\n  <div style=\"display:flex;align-items:baseline;gap:3px;margin-top:2px\">\n    <div style=\"font-weight:600;font-size:22px;color:#D2D2D2\" id=\"oee-C\">75.6</div>\n    <div class=\"sc-unit\">% PLANT</div>\n  </div>\n  <div class=\"sc-bar\"><div class=\"sc-fill\" id=\"bar-C\" style=\"width:75.6%\"></div></div>\n  <div class=\"sc-subs\" style=\"margin-top:4px\">\n    <div><div class=\"sv\" style=\"color:#A8A8A8\">3/3</div><div class=\"sl\">GW ONLINE</div></div>\n    <div><div class=\"sv\" id=\"alm-C\">11</div><div class=\"sl\">TOTAL ALM</div></div>\n  </div>\n</div>\n\n  <div class=\"scard\" data-z=\"E\" onclick=\"navZone('E')\">\n    <div class=\"sc-r1\">\n      <div><div class=\"sc-name\">E — ELECTRODE</div>\n        <div class=\"sc-proc\">LINE E1 · E2 · E3 · E4&nbsp;&nbsp;MIXING · COATING · CALENDERING</div></div>\n      <div class=\"sc-stat s-run\" id=\"st-E\">RUNNING</div>\n    </div>\n    <div style=\"display:flex;align-items:baseline;gap:3px\">\n      <div class=\"sc-oee\" id=\"oee-E\">82.4</div><div class=\"sc-unit\">% OEE</div>\n    </div>\n    <div class=\"sc-bar\"><div class=\"sc-fill\" id=\"bar-E\" style=\"width:82.4%\"></div></div>\n    <div class=\"sc-subs\">\n      <div><div class=\"sv\" id=\"cells-E\">2,840</div><div class=\"sl\">CELLS/HR</div></div>\n      <div><div class=\"sv\" id=\"alm-E\">3</div><div class=\"sl\">ALARMS</div></div>\n      <div><div class=\"sv\">4 LINES</div><div class=\"sl\">ACTIVE</div></div>\n    </div>\n  </div>\n\n  <div class=\"scard\" data-z=\"A\" onclick=\"navZone('A')\">\n    <div class=\"sc-r1\">\n      <div><div class=\"sc-name\">A — ASSEMBLY</div>\n        <div class=\"sc-proc\">LINE A1 · A2 · A3&nbsp;&nbsp;STACKING · FILLING · SEALING</div></div>\n      <div class=\"sc-stat s-warn\" id=\"st-A\">WARNING</div>\n    </div>\n    <div style=\"display:flex;align-items:baseline;gap:3px\">\n      <div class=\"sc-oee\" id=\"oee-A\">71.8</div><div class=\"sc-unit\">% OEE</div>\n    </div>\n    <div class=\"sc-bar\"><div class=\"sc-fill\" id=\"bar-A\" style=\"width:71.8%\"></div></div>\n    <div class=\"sc-subs\">\n      <div><div class=\"sv\" id=\"cells-A\">2,210</div><div class=\"sl\">CELLS/HR</div></div>\n      <div><div class=\"sv\" id=\"alm-A\" style=\"color:#C8C000\">7</div><div class=\"sl\">ALARMS</div></div>\n      <div><div class=\"sv\">3 LINES</div><div class=\"sl\">ACTIVE</div></div>\n    </div>\n  </div>\n\n  <div class=\"scard\" data-z=\"B\" onclick=\"navZone('B')\">\n    <div class=\"sc-r1\">\n      <div><div class=\"sc-name\">B — BAKING</div>\n        <div class=\"sc-proc\">LINE B1 · B2 · B3 · B4&nbsp;&nbsp;FORMATION · AGING · EOL TEST</div></div>\n      <div class=\"sc-stat s-run\" id=\"st-B\">RUNNING</div>\n    </div>\n    <div style=\"display:flex;align-items:baseline;gap:3px\">\n      <div class=\"sc-oee\" id=\"oee-B\">88.1</div><div class=\"sc-unit\">% OEE</div>\n    </div>\n    <div class=\"sc-bar\"><div class=\"sc-fill\" id=\"bar-B\" style=\"width:88.1%\"></div></div>\n    <div class=\"sc-subs\">\n      <div><div class=\"sv\" id=\"cells-B\">3,120</div><div class=\"sl\">CELLS/HR</div></div>\n      <div><div class=\"sv\" id=\"alm-B\">1</div><div class=\"sl\">ALARMS</div></div>\n      <div><div class=\"sv\">4 LINES</div><div class=\"sl\">ACTIVE</div></div>\n    </div>\n  </div>\n\n</div>\n\n<div id=\"tt\"></div>\n<div id=\"flash\"></div>\n\n<!-- THREE.JS -->\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/renderers/CSS2DRenderer.js\"></script>\n\n<script>\n// ── CONFIG ─────────────────────────────────────────────────────────────────\nconst URLS = {\n  E:'http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA',\n  A:'http://10.34.26.4:8088/data/perspective/client/Zone_A_SCADA',\n  B:'http://10.34.26.4:8088/data/perspective/client/Zone_B_SCADA',\n};\nconst WEBDEV_URL = '';\n\n// ── STATE ──────────────────────────────────────────────────────────────────\nconst S = {\n  E:{ oee:82.4, cells:2840, alarms:3,  status:'run',  avail:91.2, perf:90.4, qual:99.8,\n      lines:[ {id:'E1',oee:84.1,status:'run'}, {id:'E2',oee:81.2,status:'run'},\n               {id:'E3',oee:83.5,status:'run'}, {id:'E4',oee:80.8,status:'run'} ] },\n  A:{ oee:71.8, cells:2210, alarms:7,  status:'warn', avail:84.1, perf:85.5, qual:99.7,\n      lines:[ {id:'A1',oee:74.2,status:'run'}, {id:'A2',oee:58.4,status:'warn'},\n               {id:'A3',oee:82.8,status:'run'} ] },\n  B:{ oee:88.1, cells:3120, alarms:1,  status:'run',  avail:93.5, perf:94.3, qual:99.8,\n      lines:[ {id:'B1',oee:89.2,status:'run'}, {id:'B2',oee:87.5,status:'run'},\n               {id:'B3',oee:90.1,status:'run'}, {id:'B4',oee:85.6,status:'run'} ] },\n};\n\n// ISA-101 colors\nconst ISA = {\n  bg:       0x2E2E2E,\n  floor:    0x383838,\n  floor2:   0x323232,\n  wall_run: 0xC0C0C0,\n  wall_idle:0x4A4A4A,\n  wall_warn:0xB0A000,\n  wall_flt: 0xA02020,\n  roof:     0x9A9A9A,\n  roof_drk: 0x505050,\n  struct:   0x3A3A3A,\n  glass:    0x606878,\n  acc_E:    0x8AAAD0,\n  acc_A:    0x88A870,\n  acc_B:    0xC89060,\n  line_run: 0xA0A0A0,\n  line_warn:0xC8C000,\n  line_flt: 0xC82828,\n  line_idle:0x505050,\n  conveyor: 0x686868,\n};\n\nfunction statusColor(st) {\n  if (st==='warn')  return ISA.wall_warn;\n  if (st==='fault') return ISA.wall_flt;\n  if (st==='idle')  return ISA.wall_idle;\n  return ISA.wall_run;\n}\nfunction lineStatusColor(st) {\n  if (st==='warn')  return ISA.line_warn;\n  if (st==='fault') return ISA.line_flt;\n  if (st==='idle')  return ISA.line_idle;\n  return ISA.line_run;\n}\n\n// ── THREE.JS SETUP ─────────────────────────────────────────────────────────\nconst W0 = window.innerWidth, H0 = window.innerHeight - 110;\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(ISA.bg);\nscene.fog = new THREE.Fog(ISA.bg, 60, 160);\n\nconst camera = new THREE.PerspectiveCamera(42, W0/H0, 0.1, 500);\ncamera.position.set(0, 52, 72);\ncamera.lookAt(0, 0, 0);\n\nconst renderer = new THREE.WebGLRenderer({ antialias:true });\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio,2));\nrenderer.setSize(W0, H0);\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\ndocument.getElementById('three-canvas').appendChild(renderer.domElement);\n\n// CSS2D for labels\nconst labelRenderer = new THREE.CSS2DRenderer();\nlabelRenderer.setSize(W0, H0);\nlabelRenderer.domElement.style.position='fixed';\nlabelRenderer.domElement.style.top='0';\nlabelRenderer.domElement.style.pointerEvents='none';\nlabelRenderer.domElement.style.zIndex='50';\ndocument.body.appendChild(labelRenderer.domElement);\n\n// Controls\nconst controls = new THREE.OrbitControls(camera, renderer.domElement);\ncontrols.target.set(0, 0, 0);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.07;\ncontrols.minDistance = 20;\ncontrols.maxDistance = 120;\ncontrols.maxPolarAngle = Math.PI/2.05;\n\n// ── LIGHTING (ISA-101: neutral, even, no drama) ─────────────────────────────\nconst ambLight = new THREE.AmbientLight(0xD0D0D0, 0.55);\nscene.add(ambLight);\n\nconst sunLight = new THREE.DirectionalLight(0xFFFFFF, 0.7);\nsunLight.position.set(30, 60, 20);\nsunLight.castShadow = true;\nsunLight.shadow.mapSize.set(2048,2048);\nsunLight.shadow.camera.left=-60; sunLight.shadow.camera.right=60;\nsunLight.shadow.camera.top=60;  sunLight.shadow.camera.bottom=-60;\nscene.add(sunLight);\n\nconst fillLight = new THREE.DirectionalLight(0xD0D8E0, 0.3);\nfillLight.position.set(-20, 20, -20);\nscene.add(fillLight);\n\n// ── HELPERS ────────────────────────────────────────────────────────────────\nfunction mat(color, opts={}) {\n  return new THREE.MeshLambertMaterial({ color, ...opts });\n}\nfunction box(w,h,d, color, opts={}) {\n  const g = new THREE.BoxGeometry(w,h,d);\n  return new THREE.Mesh(g, mat(color, opts));\n}\nfunction addLabel(parent, html, y) {\n  const div = document.createElement('div');\n  div.innerHTML = html;\n  const obj = new THREE.CSS2DObject(div);\n  obj.position.y = y;\n  parent.add(obj);\n  return obj;\n}\n\n// ── FLOOR ─────────────────────────────────────────────────────────────────\nconst floorGeo = new THREE.PlaneGeometry(200, 200, 40, 40);\nconst floorMat = new THREE.MeshLambertMaterial({ color:ISA.floor });\nconst floor = new THREE.Mesh(floorGeo, floorMat);\nfloor.rotation.x = -Math.PI/2;\nfloor.receiveShadow = true;\nscene.add(floor);\n\n// Floor grid lines\nconst gridHelper = new THREE.GridHelper(200, 50, 0x404040, 0x3A3A3A);\nscene.add(gridHelper);\n\n// ── ROAD / FLOW CORRIDOR ────────────────────────────────────────────────────\nfunction addCorridor(x,z,w,d) {\n  const m = box(w, 0.05, d, 0x353535);\n  m.position.set(x, 0.02, z);\n  scene.add(m);\n  // Dashed center line\n  const pts = [new THREE.Vector3(-w/2+1,0.05,0), new THREE.Vector3(w/2-1,0.05,0)];\n  const lg = new THREE.BufferGeometry().setFromPoints(pts);\n  const lm = new THREE.LineBasicMaterial({ color:0x606060 });\n  const line = new THREE.Line(lg, lm);\n  line.position.set(x,0,z);\n  scene.add(line);\n}\n\n// ── ZONE BUILDING ─────────────────────────────────────────────────────────\n/*\n  LAYOUT (top view):\n  \n      [  E ZONE  ]    [  A ZONE  ]    [  B ZONE  ]\n         E1 E2 E3 E4     A1 A2 A3       B1 B2 B3 B4\n      \n      ————————— MAIN FLOW CORRIDOR (E → A → B) —————————\n      \n                  [ CENTRAL HUB ]\n*/\n\nconst zoneGroups = {};\nconst lineMeshes = {};\nconst zoneBuildings = {};\n\nfunction buildZone(zoneId, cx, cz, lineCount, acc) {\n  const group = new THREE.Group();\n  group.position.set(cx, 0, cz);\n  scene.add(group);\n  zoneGroups[zoneId] = group;\n  lineMeshes[zoneId] = [];\n\n  const s = S[zoneId];\n  const lineW = 7.5, lineD = 22, lineH = 6.5;\n  const gap = 1.4;\n  const totalW = lineCount * (lineW + gap) - gap;\n\n  // ── ZONE SHELL ─────────────────────────────────────────────────────────\n  const shellW = totalW + 6, shellD = lineD + 10, shellH = 1.2;\n  const floor = box(shellW, shellH, shellD, ISA.floor2);\n  floor.position.y = -0.5;\n  floor.receiveShadow = true;\n  group.add(floor);\n\n  // Zone identification stripe on floor (ISA: subtle area tint)\n  const stripe = box(shellW, 0.08, shellD, acc);\n  stripe.material.opacity = 0.25; stripe.material.transparent = true;\n  stripe.position.y = 0.05;\n  group.add(stripe);\n\n  // Perimeter walls (low, open-top industrial building)\n  const wallMat = mat(0x444444);\n  const wT = 0.4, wallH2 = 8;\n  // Front wall\n  const wf = box(shellW, wallH2, wT, 0x3E3E3E);\n  wf.position.set(0, wallH2/2, shellD/2); group.add(wf);\n  // Back wall\n  const wb = box(shellW, wallH2, wT, 0x3E3E3E);\n  wb.position.set(0, wallH2/2, -shellD/2); group.add(wb);\n  // Side walls\n  const ws1 = box(wT, wallH2, shellD, 0x3E3E3E);\n  ws1.position.set(-shellW/2, wallH2/2, 0); group.add(ws1);\n  const ws2 = box(wT, wallH2, shellD, 0x3E3E3E);\n  ws2.position.set(shellW/2, wallH2/2, 0); group.add(ws2);\n\n  // Roof trusses\n  for (let i=0; i<5; i++) {\n    const truss = box(shellW, 0.3, 0.25, 0x4A4A4A);\n    truss.position.set(0, wallH2+0.15, -shellD/2+shellD/4*i);\n    group.add(truss);\n  }\n  // Roof panels\n  const roof = box(shellW, 0.2, shellD, ISA.roof_drk);\n  roof.material.opacity=0.5; roof.material.transparent=true;\n  roof.position.set(0, wallH2+0.3, 0); group.add(roof);\n\n  // Zone label (P&ID area tag — mounted on building)\n  const zDiv = document.createElement('div');\n  zDiv.className = 'label3d';\n  zDiv.innerHTML = `\n    <div class=\"lname\">${zoneId} — ${{E:'ELECTRODE',A:'ASSEMBLY',B:'BAKING'}[zoneId]}</div>\n    <div class=\"loee\" id=\"l3d-oee-${zoneId}\">OEE ${s.oee.toFixed(1)}%</div>\n    <div class=\"lalm\" id=\"l3d-alm-${zoneId}\" style=\"color:${s.alarms>5?'#C82828':s.alarms>0?'#C8C000':'#686868'}\">\n      ${s.alarms>0?'⚠ '+s.alarms+' ALARMS':'✓ NO ALARMS'}\n    </div>`;\n  const zLabel = new THREE.CSS2DObject(zDiv);\n  zLabel.position.set(0, wallH2+2, -shellD/2-1);\n  group.add(zLabel);\n  zDiv.id = 'zl-'+zoneId;\n\n  // ── PRODUCTION LINES ────────────────────────────────────────────────────\n  for (let i=0; i<lineCount; i++) {\n    const line = s.lines[i] || {id:zoneId+(i+1),oee:80,status:'run'};\n    const lx = -totalW/2 + i*(lineW+gap) + lineW/2;\n    const lGroup = new THREE.Group();\n    lGroup.position.set(lx, 0, 0);\n    group.add(lGroup);\n\n    const lc = lineStatusColor(line.status);\n\n    // Line base slab\n    const slab = box(lineW-0.2, 0.3, lineD-1, 0x3A3A3A);\n    slab.position.y = 0.15; slab.receiveShadow = true;\n    lGroup.add(slab);\n\n    // Equipment blocks along the line (ISA color = status)\n    const equipH = lineH * 0.7;\n    const eqPositions = [-lineD/2+3, -lineD/6, lineD/6, lineD/2-3];\n    eqPositions.forEach((ez, ei) => {\n      const eqH = equipH * (0.7 + ei*0.05);\n      const eq = box(lineW-1.2, eqH, 2.8, lc);\n      eq.position.set(0, eqH/2+0.3, ez);\n      eq.castShadow = true;\n      lGroup.add(eq);\n      // Equipment top cap\n      const cap = box(lineW-1.0, 0.2, 2.6, lc*0.7);\n      cap.position.set(0, eqH+0.4, ez);\n      lGroup.add(cap);\n    });\n\n    // Conveyor belt (connecting equipment)\n    const conv = box(lineW-2, 0.18, lineD-3, ISA.conveyor);\n    conv.material.opacity=0.6; conv.material.transparent=true;\n    conv.position.set(0, 0.42, 0);\n    lGroup.add(conv);\n\n    // Status beacon on top (ISA: colored light = abnormal only)\n    const beaconH = lineH + 3.5;\n    const post = box(0.15, beaconH, 0.15, 0x404040);\n    post.position.set(lineW/2-0.6, beaconH/2, -lineD/2+2);\n    lGroup.add(post);\n\n    const beaconColor = line.status==='warn'?ISA.line_warn:\n                        line.status==='fault'?ISA.line_flt:0x505050;\n    const beacon = new THREE.Mesh(\n      new THREE.SphereGeometry(0.35, 8, 8),\n      new THREE.MeshLambertMaterial({ color:beaconColor,\n        emissive: line.status!=='run'?beaconColor:0x000000,\n        emissiveIntensity: line.status!=='run'?0.5:0 })\n    );\n    beacon.position.set(lineW/2-0.6, beaconH+0.35, -lineD/2+2);\n    lGroup.add(beacon);\n\n    // Line ID label\n    const lDiv = document.createElement('div');\n    lDiv.className = 'linelabel';\n    lDiv.innerHTML = `${line.id}&nbsp;&nbsp;${line.oee.toFixed(0)}%`;\n    lDiv.style.color = line.status==='warn'?'#C8C000':\n                       line.status==='fault'?'#C82828':'#909090';\n    const lLabel = new THREE.CSS2DObject(lDiv);\n    lLabel.position.set(0, lineH+2, 0);\n    lGroup.add(lLabel);\n\n    lineMeshes[zoneId].push({ group:lGroup, beacon, line });\n  }\n\n  // Animated conveyor dots — product flow particles stored per zone\n  group.userData = { flowParticles: [], lineCount, lineW, lineD, gap, totalW, shellD };\n\n  // Zone clickable proxy (invisible box)\n  const proxy = box(shellW+2, wallH2+4, shellD+2, 0xFFFFFF);\n  proxy.material.transparent=true; proxy.material.opacity=0;\n  proxy.position.y=wallH2/2;\n  proxy.userData = { zoneId };\n  group.add(proxy);\n  zoneBuildings[zoneId] = proxy;\n}\n\n// ── CENTRAL HUB ────────────────────────────────────────────────────────────\nfunction buildCentralHub() {\n  const g = new THREE.Group();\n  g.position.set(0, 0, 12);\n  scene.add(g);\n\n  // Base\n  const base = box(18, 0.5, 14, 0x323232);\n  base.position.y = 0.25; g.add(base);\n\n  // Main server building\n  const hub = box(14, 5, 10, 0x3C3C3C);\n  hub.position.y = 3; hub.castShadow=true; g.add(hub);\n\n  // Server rack windows\n  for (let i=0; i<3; i++) {\n    const rack = box(2.5, 3, 0.1, 0x505060);\n    rack.position.set(-4+i*4, 3.2, 5.1); g.add(rack);\n    // LED strip on rack\n    const led = box(2.3, 0.15, 0.12, 0x7090A0);\n    for (let j=0;j<4;j++) { const l=led.clone(); l.position.set(-4+i*4,1.8+j*0.7,5.15); g.add(l); }\n  }\n\n  // Antenna\n  const ant = box(0.12, 4, 0.12, 0x505050);\n  ant.position.set(0, 7.5, 0); g.add(ant);\n  const dish = new THREE.Mesh(\n    new THREE.CylinderGeometry(1,0.3,0.5,8),\n    mat(0x606060)\n  );\n  dish.position.set(0, 10, 0); g.add(dish);\n\n  // Label\n  const div = document.createElement('div');\n  div.className = 'label3d';\n  div.innerHTML = `<div class=\"lname\" style=\"font-size:10px;letter-spacing:1.5px\">CENTRAL SCADA</div>\n<div class=\"loee\" style=\"font-size:9px\">IGNITION GATEWAY NETWORK</div>\n<div class=\"lalm\" id=\"hub-plant-oee\" style=\"color:#C0C0C0;font-size:10px\">PLANT OEE —.—%</div>`;\n  const lbl = new THREE.CSS2DObject(div);\n  lbl.position.set(0, 10, 0); g.add(lbl);\n}\n\n// ── INTER-ZONE CONVEYORS ────────────────────────────────────────────────────\nfunction buildConveyors() {\n  // E → A\n  const ea = box(14, 0.6, 2, 0x3C3C3C);\n  ea.position.set(-14, 0.4, -2);\n  scene.add(ea);\n  const eaArrow = box(0.2, 0.5, 0.2, 0x686868);\n  eaArrow.position.set(-7, 0.5, -2); scene.add(eaArrow);\n\n  // A → B\n  const ab = box(14, 0.6, 2, 0x3C3C3C);\n  ab.position.set(14, 0.4, -2);\n  scene.add(ab);\n}\n\n// ── FLOW PARTICLES SYSTEM ──────────────────────────────────────────────────\nconst allParticles = [];\n\nfunction createFlowParticles() {\n  // E → A flow\n  const eaPath = [\n    new THREE.Vector3(-24, 1, -2),\n    new THREE.Vector3(-7,  1, -2),\n    new THREE.Vector3(0,   1, -2),\n  ];\n  // A → B flow\n  const abPath = [\n    new THREE.Vector3(0,  1, -2),\n    new THREE.Vector3(7,  1, -2),\n    new THREE.Vector3(24, 1, -2),\n  ];\n\n  [eaPath, abPath].forEach((path, pi) => {\n    for (let i=0; i<8; i++) {\n      const geo = new THREE.SphereGeometry(0.22, 6, 6);\n      const m = new THREE.MeshLambertMaterial({ color:0xA0A0A0, emissive:0x404040, emissiveIntensity:0.3 });\n      const mesh = new THREE.Mesh(geo, m);\n      mesh.userData = { path, t:(i/8), spd:0.12+Math.random()*0.04 };\n      scene.add(mesh);\n      allParticles.push(mesh);\n    }\n  });\n}\n\nfunction updateParticles(dt) {\n  allParticles.forEach(p => {\n    p.userData.t = (p.userData.t + p.userData.spd * dt) % 1;\n    const path = p.userData.path;\n    const t = p.userData.t * (path.length-1);\n    const idx = Math.floor(t), frac = t - idx;\n    const a = path[Math.min(idx, path.length-2)];\n    const b = path[Math.min(idx+1, path.length-1)];\n    p.position.lerpVectors(a, b, frac);\n  });\n}\n\n// ── STRUCTURAL COLUMNS ─────────────────────────────────────────────────────\nfunction addColumns() {\n  const positions = [\n    [-46,8],[-24,8],[0,8],[24,8],[46,8],\n    [-46,-10],[-24,-10],[0,-10],[24,-10],[46,-10],\n  ];\n  positions.forEach(([x,z]) => {\n    const col = box(0.6, 0.4, 0.6, 0x404040);\n    col.position.set(x, 0.2, z);\n    scene.add(col);\n  });\n}\n\n// ── COMPANY SIGN / TITLE ───────────────────────────────────────────────────\nfunction addTitle() {\n  const div = document.createElement('div');\n  div.style.cssText=`\n    font-family:'IBM Plex Sans Condensed',sans-serif;\n    font-weight:600; font-size:13px; letter-spacing:5px;\n    color:#787878; background:rgba(36,36,36,0.0);\n    pointer-events:none; white-space:nowrap; text-align:center;`;\n  div.innerHTML = 'AGRATAS GIGAFACTORY — SANAND &nbsp;|&nbsp; CENTRAL OVERVIEW';\n  const lbl = new THREE.CSS2DObject(div);\n  lbl.position.set(0, 0.1, -42);\n  scene.add(lbl);\n}\n\n// ── BUILD SCENE ────────────────────────────────────────────────────────────\nbuildZone('E', -27, -6, 4, ISA.acc_E);  // E: 4 lines, left\nbuildZone('A',   0, -6, 3, ISA.acc_A);  // A: 3 lines, center\nbuildZone('B',  27, -6, 4, ISA.acc_B);  // B: 4 lines, right\nbuildCentralHub();\nbuildConveyors();\ncreateFlowParticles();\naddColumns();\naddTitle();\n\n// ── RAYCASTER (click zones) ────────────────────────────────────────────────\nconst raycaster = new THREE.Raycaster();\nconst mouse = new THREE.Vector2();\nconst tt = document.getElementById('tt');\nlet hovZone = null;\n\nrenderer.domElement.addEventListener('mousemove', e => {\n  mouse.x = (e.clientX/window.innerWidth)*2 - 1;\n  mouse.y = -((e.clientY/(window.innerHeight-110))*2 - 1);\n  raycaster.setFromCamera(mouse, camera);\n  const hits = raycaster.intersectObjects(Object.values(zoneBuildings));\n  if (hits.length) {\n    const z = hits[0].object.userData.zoneId;\n    if (z !== hovZone) {\n      hovZone = z;\n      const s = S[z];\n      const names = {E:'ELECTRODE',A:'ASSEMBLY',B:'BAKING'};\n      const ac = {E:'#8AAAD0',A:'#88A870',B:'#C89060'}[z];\n      tt.style.display='block'; tt.style.borderLeftColor=ac;\n      tt.style.left=(e.clientX+14)+'px'; tt.style.top=(e.clientY-10)+'px';\n      tt.innerHTML=`<div class=\"tt-title\">${z} — ${names[z]}</div>\n<div class=\"tt-row\">STATUS <em style=\"color:${s.status==='warn'?'#C8C000':s.status==='fault'?'#C82828':'#A8A8A8'}\">${s.status.toUpperCase()}</em></div>\n<div class=\"tt-row\">OEE <em>${s.oee.toFixed(1)}%</em></div>\n<div class=\"tt-row\">AVAILABILITY <em>${s.avail}%</em></div>\n<div class=\"tt-row\">PERFORMANCE <em>${s.perf}%</em></div>\n<div class=\"tt-row\">QUALITY <em>${s.qual}%</em></div>\n<div class=\"tt-row\">THROUGHPUT <em>${s.cells.toLocaleString()} cells/hr</em></div>\n<div class=\"tt-row\">ACTIVE ALARMS <em style=\"color:${s.alarms>5?'#C82828':'#C8C000'}\">${s.alarms}</em></div>\n<div class=\"tt-row\">PRODUCTION LINES <em>${s.lines.length} LINES</em></div>\n<div class=\"tt-hint\">▸ CLICK TO OPEN ZONE SCADA</div>`;\n    }\n    renderer.domElement.style.cursor='pointer';\n  } else {\n    hovZone=null; tt.style.display='none';\n    renderer.domElement.style.cursor='default';\n  }\n});\n\n// ── TAG DATA LISTENERS ─────────────────────────────────────────────────────\nwindow.addEventListener('message', e => {\n  try {\n    const d = typeof e.data==='string'?JSON.parse(e.data):e.data;\n    if (d && d.type==='SCADA_UPDATE') applyData(d);\n  } catch(_) {}\n});\n(function() {\n  const p=new URLSearchParams(window.location.search);\n  if (!p.has('oeeE')) return;\n  applyData({ oeeE:p.get('oeeE'), oeeA:p.get('oeeA'), oeeB:p.get('oeeB'),\n    statusE:p.get('statusE'), statusA:p.get('statusA'), statusB:p.get('statusB'),\n    alarmsE:p.get('alarmsE')||0, alarmsA:p.get('alarmsA')||0, alarmsB:p.get('alarmsB')||0 });\n})();\nif (WEBDEV_URL) setInterval(()=>fetch(WEBDEV_URL).then(r=>r.json()).then(applyData).catch(()=>{}),5000);\n\nfunction applyData(d) {\n  ['E','A','B'].forEach(z => {\n    if (d['oee'+z]    != null) S[z].oee    = parseFloat(d['oee'+z]);\n    if (d['cells'+z]  != null) S[z].cells  = parseInt(d['cells'+z]);\n    if (d['alarms'+z] != null) S[z].alarms = parseInt(d['alarms'+z]);\n    if (d['status'+z] != null) S[z].status = d['status'+z];\n  });\n  refreshAll();\n}\n\nfunction refreshAll() {\n  const SLBL={run:'RUNNING',warn:'WARNING',fault:'FAULT',idle:'IDLE'};\n  ['E','A','B'].forEach(z => {\n    const s=S[z];\n    document.getElementById('oee-'+z).textContent=s.oee.toFixed(1);\n    document.getElementById('bar-'+z).style.width=s.oee+'%';\n    document.getElementById('cells-'+z).textContent=s.cells.toLocaleString();\n    const ae=document.getElementById('alm-'+z);\n    ae.textContent=s.alarms;\n    ae.style.color=s.alarms>5?'#C82828':s.alarms>0?'#C8C000':'#A8A8A8';\n    const se=document.getElementById('st-'+z);\n    se.textContent=SLBL[s.status]||'IDLE';\n    se.className='sc-stat s-'+(s.status||'idle');\n    // 3D label\n    const lo=document.getElementById('l3d-oee-'+z);\n    if(lo) lo.textContent='OEE '+s.oee.toFixed(1)+'%';\n    const la=document.getElementById('l3d-alm-'+z);\n    if(la){\n      la.style.color=s.alarms>5?'#C82828':s.alarms>0?'#C8C000':'#686868';\n      la.textContent=s.alarms>0?'⚠ '+s.alarms+' ALARMS':'✓ NO ALARMS';\n    }\n  });\n  const pl=((S.E.oee+S.A.oee+S.B.oee)/3).toFixed(1);\n  document.getElementById('oee-C').textContent=pl;\n  document.getElementById('bar-C').style.width=pl+'%';\n  document.getElementById('alm-C').textContent=S.E.alarms+S.A.alarms+S.B.alarms;\n  const hoee=document.getElementById('hub-plant-oee');\n  if(hoee) hoee.textContent='PLANT OEE  '+pl+'%';\n}\nrefreshAll();\n\n// ── SIMULATION (remove when live) ─────────────────────────────────────────\nconst _t={E:82.4,A:71.8,B:88.1};\nlet beaconPhase=0;\nsetInterval(()=>{\n  ['E','A','B'].forEach(z=>{\n    _t[z]+=(Math.random()-.5)*.4;\n    _t[z]=Math.max(60,Math.min(97,_t[z]));\n    S[z].oee+=(_t[z]-S[z].oee)*.25;\n  });\n  refreshAll();\n},3500);\n\n// ── NAVIGATION ────────────────────────────────────────────────────────────\nfunction navZone(z) {\n  const f=document.getElementById('flash');\n  f.style.opacity='1';\n  setTimeout(()=>{ f.style.opacity='0'; if(URLS[z]) window.open(URLS[z],'_blank'); },160);\n}\n\n// ── RESIZE ────────────────────────────────────────────────────────────────\nwindow.addEventListener('resize', () => {\n  const w=window.innerWidth, h=window.innerHeight-110;\n  camera.aspect=w/h; camera.updateProjectionMatrix();\n  renderer.setSize(w,h); labelRenderer.setSize(w,h);\n});\n\n// ── RENDER LOOP ───────────────────────────────────────────────────────────\nlet last=0;\nfunction animate(ts) {\n  requestAnimationFrame(animate);\n  const dt=Math.min((ts-last)/1000,.05); last=ts;\n  beaconPhase+=dt*2.5;\n\n  // Pulse warning beacons\n  ['E','A','B'].forEach(zid => {\n    lineMeshes[zid].forEach(({beacon,line}) => {\n      if(line.status==='warn') {\n        beacon.material.emissiveIntensity=0.4+0.4*Math.sin(beaconPhase);\n      } else if(line.status==='fault') {\n        beacon.material.emissiveIntensity=0.6+0.4*Math.sin(beaconPhase*3);\n      }\n    });\n  });\n\n  updateParticles(dt);\n  controls.update();\n  renderer.render(scene, camera);\n  labelRenderer.render(scene, camera);\n}\nanimate(0);\n</script>\n</body>\n</html>\n"
}