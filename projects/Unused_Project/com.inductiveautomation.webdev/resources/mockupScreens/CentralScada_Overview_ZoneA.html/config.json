  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Zone A - Central SCADA</title>\r\n<script src=\"https://cdn.jsdelivr.net/npm/apexcharts\"></script>\r\n<style>\r\nbody{margin:0;font-family:\"Segoe UI\",Arial;background:#F2F3F5;color:#2B2F33}\r\n.main{padding:25px;overflow-y:auto}\r\n.kpi-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:15px;margin-bottom:25px}\r\n.kpi-card{background:#fff;padding:15px;border:1px solid #E0E3E7;border-radius:6px}\r\n.kpi-card h5{margin:0;font-size:11px;color:#6B7280;text-transform:uppercase}\r\n.kpi-card h2{margin:6px 0 0;font-size:20px;font-weight:600}\r\n.card{background:#fff;border:1px solid #E0E3E7;border-radius:6px;padding:20px;margin-bottom:20px}\r\n.section-title{font-size:13px;font-weight:600;margin-bottom:12px;color:#6B7280;text-transform:uppercase}\r\n.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px}\r\n.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}\r\n.line-table{width:100%;border-collapse:collapse;font-size:13px}\r\n.line-table th,.line-table td{padding:8px;border-bottom:1px solid #E5E7EB;text-align:left}\r\n.progress{height:8px;background:#E5E7EB;border-radius:6px;overflow:hidden}\r\n.progress-bar{height:100%;background:#0052CC}\r\n.status-tile{padding:10px;border-radius:6px;text-align:center;font-size:12px;font-weight:600}\r\n.running{background:#D1FAE5;color:#065F46}\r\n.idle{background:#FEF3C7;color:#92400E}\r\n.fault{background:#FEE2E2;color:#991B1B}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"main\">\r\n\r\n<!-- KPI STRIP -->\r\n<div class=\"kpi-grid\">\r\n<div class=\"kpi-card\"><h5>OEE</h5><h2>85%</h2></div>\r\n<div class=\"kpi-card\"><h5>Availability</h5><h2>90%</h2></div>\r\n<div class=\"kpi-card\"><h5>Performance</h5><h2>82%</h2></div>\r\n<div class=\"kpi-card\"><h5>Quality</h5><h2>96%</h2></div>\r\n<div class=\"kpi-card\"><h5>Production Today</h5><h2>5,400</h2></div>\r\n<div class=\"kpi-card\"><h5>Target</h5><h2>6,000</h2></div>\r\n<div class=\"kpi-card\"><h5>Rejection %</h5><h2>3.1%</h2></div>\r\n<div class=\"kpi-card\"><h5>Energy (kWh)</h5><h2>4200</h2></div>\r\n</div>\r\n\r\n<!-- LINE STATUS -->\r\n<div class=\"card\">\r\n<div class=\"section-title\">Line Status Overview</div>\r\n<div class=\"grid-3\">\r\n<div class=\"status-tile running\">Line 1 – Running</div>\r\n<div class=\"status-tile idle\">Line 2 – Idle</div>\r\n<div class=\"status-tile fault\">Line 3 – Faulted</div>\r\n<div class=\"status-tile running\">Line 4 – Running</div>\r\n<div class=\"status-tile running\">Line 5 – Running</div>\r\n<div class=\"status-tile running\">Line 6 – Running</div>\r\n</div>\r\n</div>\r\n\r\n<!-- WORK ORDERS -->\r\n<div class=\"card\">\r\n<div class=\"section-title\">Active Work Orders</div>\r\n<table class=\"line-table\">\r\n<thead>\r\n<tr><th>Line</th><th>WO</th><th>Product</th><th>Planned</th><th>Produced</th><th>Progress</th><th>Line OEE</th></tr>\r\n</thead>\r\n<tbody>\r\n<tr><td>Line 1</td><td>WO-45821</td><td>AXLE-204</td><td>3000</td><td>2150</td><td><div class='progress'><div class='progress-bar' style='width:71%'></div></div></td><td>88%</td></tr>\r\n<tr><td>Line 2</td><td>WO-45825</td><td>AXLE-210</td><td>2500</td><td>1500</td><td><div class='progress'><div class='progress-bar' style='width:60%'></div></div></td><td>75%</td></tr>\r\n<tr><td>Line 3</td><td>WO-45830</td><td>AXLE-198</td><td>2000</td><td>900</td><td><div class='progress'><div class='progress-bar' style='width:45%'></div></div></td><td>68%</td></tr>\r\n</tbody>\r\n</table>\r\n</div>\r\n\r\n<!-- ANALYTICS -->\r\n<div class=\"grid-2\">\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Downtime Contribution (%)</div>\r\n<div id=\"downtimeChart\"></div>\r\n</div>\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Shift OEE Trend</div>\r\n<div id=\"trendChart\"></div>\r\n</div>\r\n\r\n</div>\r\n\r\n<!-- QUALITY & ENERGY -->\r\n<div class=\"grid-2\">\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Top Defect Categories</div>\r\n<div id=\"qualityChart\"></div>\r\n</div>\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Energy Consumption (Hourly)</div>\r\n<div id=\"energyChart\"></div>\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<script>\r\nnew ApexCharts(document.querySelector(\"#downtimeChart\"),{\r\nchart:{type:'bar',height:320,stacked:true,toolbar:{show:false}},\r\nplotOptions:{bar:{horizontal:true}},\r\nseries:[\r\n{ name:'Material Jam', data:[30,25,40,35,20,28]},\r\n{ name:'Power Trip', data:[20,15,18,22,25,19]},\r\n{ name:'Sensor Fault', data:[15,20,12,18,10,14]},\r\n{ name:'No Material', data:[10,12,8,9,15,11]},\r\n{ name:'Maintenance', data:[5,8,6,7,9,6]}\r\n],\r\nxaxis:{categories:['Line 1','Line 2','Line 3','Line 4','Line 5','Line 6'],max:100},\r\ncolors:['#DC2626','#F59E0B','#0052CC','#7C3AED','#1F9D55'],\r\nlegend:{position:'top'},\r\ndataLabels:{enabled:false}\r\n}).render();\r\n\r\nvar lineShiftOEE = [88,75,68,84,86,83];\r\n\r\nfunction calculateZoneAvg(values){\r\n  var total = values.reduce((a,b)=>a+b,0);\r\n  return (total/values.length).toFixed(1);\r\n}\r\n\r\nvar zoneShiftAvg = calculateZoneAvg(lineShiftOEE);\r\n\r\nnew ApexCharts(document.querySelector(\"#trendChart\"),{\r\nchart:{height:320,type:'line',toolbar:{show:false}},\r\nseries:[\r\n{ name:'Line OEE', type:'column', data: lineShiftOEE },\r\n{ name:'Zone Avg OEE', type:'line', data: new Array(lineShiftOEE.length).fill(zoneShiftAvg) }\r\n],\r\nxaxis:{ categories:['Line 1','Line 2','Line 3','Line 4','Line 5','Line 6'] },\r\nyaxis:{ min:0, max:100, title:{ text:'OEE %'} },\r\nplotOptions:{ bar:{ columnWidth:'55%'}},\r\nstroke:{ width:[0,3] },\r\ncolors:['#60A5FA','#111827'],\r\ndataLabels:{enabled:false},\r\nlegend:{position:'top'}\r\n}).render();\r\n\r\nnew ApexCharts(document.querySelector(\"#qualityChart\"),{\r\nchart:{type:'donut',height:280},\r\nseries:[45,25,15,10,5],\r\nlabels:['Surface Defect','Dimensional','Crack','Burr','Other']\r\n}).render();\r\n\r\nnew ApexCharts(document.querySelector(\"#energyChart\"),{\r\nchart:{type:'area',height:280},\r\nseries:[{name:'kWh',data:[500,620,580,640,700,720,680]}],\r\nxaxis:{categories:['06','07','08','09','10','11','12']},\r\ncolors:['#0052CC']\r\n}).render();\r\n</script>\r\n\r\n</body>\r\n</html>"
}