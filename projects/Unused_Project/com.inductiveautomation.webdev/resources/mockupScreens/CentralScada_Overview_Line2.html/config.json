{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Zone E – Line Command Center</title>\r\n<script src=\"https://cdn.jsdelivr.net/npm/apexcharts\"></script>\r\n\r\n<style>\r\n\r\nbody{\r\nmargin:0;\r\nfont-family:\"Segoe UI\",Arial;\r\nbackground:#F4F5F7;\r\ncolor:#2F3438;\r\n}\r\n\r\n.main{\r\npadding:20px;\r\noverflow-y:auto;\r\n}\r\n\r\n/* KPI STRIP */\r\n\r\n.kpi-grid{\r\ndisplay:grid;\r\ngrid-template-columns:repeat(8,1fr);\r\ngap:12px;\r\nmargin-bottom:20px;\r\n}\r\n\r\n.kpi-card{\r\nbackground:#FFFFFF;\r\npadding:12px;\r\nborder-radius:6px;\r\nborder:1px solid #E3E6EA;\r\n}\r\n\r\n.kpi-card h5{\r\nmargin:0;\r\nfont-size:10px;\r\ncolor:#7A828A;\r\ntext-transform:uppercase;\r\nletter-spacing:.5px;\r\n}\r\n\r\n.kpi-card h2{\r\nmargin-top:4px;\r\nfont-size:18px;\r\nfont-weight:600;\r\n}\r\n\r\n/* CARD */\r\n\r\n.card{\r\nbackground:#FFFFFF;\r\nborder:1px solid #E3E6EA;\r\nborder-radius:6px;\r\npadding:16px;\r\nmargin-bottom:18px;\r\n}\r\n\r\n.section-title{\r\nfont-size:11px;\r\nfont-weight:600;\r\nmargin-bottom:12px;\r\ncolor:#7A828A;\r\ntext-transform:uppercase;\r\nletter-spacing:.6px;\r\n}\r\n\r\n/* MACHINE GRID */\r\n\r\n.machine-grid{\r\ndisplay:grid;\r\ngrid-template-columns:repeat(3,1fr);\r\ngap:12px;\r\n}\r\n\r\n.machine-card{\r\nborder-radius:6px;\r\npadding:12px;\r\nfont-size:12px;\r\nborder:1px solid #E5E7EB;\r\ntransition:.15s;\r\ncursor:pointer;\r\n}\r\n\r\n.machine-card:hover{\r\nbox-shadow:0 2px 6px rgba(0,0,0,.08);\r\ntransform:translateY(-1px);\r\n}\r\n\r\n/* MACHINE STATUS COLORS */\r\n\r\n.running{\r\nbackground:#ECFDF5;\r\nborder-left:5px solid #10B981;\r\n}\r\n\r\n.idle{\r\nbackground:#FFFBEB;\r\nborder-left:5px solid #F59E0B;\r\n}\r\n\r\n.fault{\r\nbackground:#FEF2F2;\r\nborder-left:5px solid #EF4444;\r\n}\r\n\r\n.machine-header{\r\ndisplay:flex;\r\njustify-content:space-between;\r\nfont-weight:600;\r\nmargin-bottom:6px;\r\n}\r\n\r\n.machine-metrics{\r\ndisplay:grid;\r\ngrid-template-columns:1fr 1fr;\r\ngap:4px;\r\nfont-size:11px;\r\n}\r\n\r\n.status-tag{\r\nfont-size:10px;\r\nfont-weight:600;\r\n}\r\n\r\n/* WORK ORDER */\r\n\r\n.progress{\r\nheight:7px;\r\nbackground:#E5E7EB;\r\nborder-radius:8px;\r\noverflow:hidden;\r\nmargin-top:6px;\r\n}\r\n\r\n.progress-bar{\r\nheight:100%;\r\nbackground:#0052CC;\r\n}\r\n\r\n/* ANALYTICS */\r\n\r\n.grid-2{\r\ndisplay:grid;\r\ngrid-template-columns:1fr 1fr;\r\ngap:16px;\r\n}\r\n\r\na{\r\ntext-decoration:none;\r\ncolor:inherit;\r\n}\r\n\r\n</style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"main\">\r\n\r\n<!-- KPI STRIP -->\r\n\r\n<div class=\"kpi-grid\">\r\n\r\n<div class=\"kpi-card\"><h5>OEE</h5><h2>75%</h2></div>\r\n<div class=\"kpi-card\"><h5>Availability</h5><h2>82%</h2></div>\r\n<div class=\"kpi-card\"><h5>Performance</h5><h2>73%</h2></div>\r\n<div class=\"kpi-card\"><h5>Quality</h5><h2>95%</h2></div>\r\n<div class=\"kpi-card\"><h5>Planned Qty</h5><h2>2500</h2></div>\r\n<div class=\"kpi-card\"><h5>Produced</h5><h2>1500</h2></div>\r\n<div class=\"kpi-card\"><h5>Rejection %</h5><h2>3.8%</h2></div>\r\n<div class=\"kpi-card\"><h5>Cycle Time</h5><h2>42s</h2></div>\r\n\r\n</div>\r\n\r\n\r\n<!-- MACHINE STATUS -->\r\n\r\n<div class=\"card\">\r\n\r\n<div class=\"section-title\">Machine Status</div>\r\n\r\n<div class=\"machine-grid\">\r\n\r\n<a href=\"http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/Sanand/zoneE/Line1/machine1\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n<div class=\"machine-card running\">\r\n<div class=\"machine-header\">M1 <span class=\"status-tag\">Running</span></div>\r\n<div class=\"machine-metrics\">\r\n<div>Runtime</div><div>92%</div>\r\n<div>OEE</div><div>88%</div>\r\n<div>Output</div><div>320</div>\r\n<div>CT</div><div>40s</div>\r\n<div>Alarm</div><div>None</div>\r\n<div>Downtime</div><div>8%</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/Sanand/zoneE/Line1/machine2\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n<div class=\"machine-card idle\">\r\n<div class=\"machine-header\">M2 <span class=\"status-tag\">Idle</span></div>\r\n<div class=\"machine-metrics\">\r\n<div>Runtime</div><div>89%</div>\r\n<div>OEE</div><div>84%</div>\r\n<div>Output</div><div>295</div>\r\n<div>CT</div><div>41s</div>\r\n<div>Alarm</div><div>None</div>\r\n<div>Downtime</div><div>11%</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<a href=\"http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/Sanand/zoneE/Line1/machine3\" target=\"_blank\" rel=\"noopener noreferrer\">\r\n<div class=\"machine-card fault\">\r\n<div class=\"machine-header\">M3 <span class=\"status-tag\">Fault</span></div>\r\n<div class=\"machine-metrics\">\r\n<div>Runtime</div><div>61%</div>\r\n<div>OEE</div><div>68%</div>\r\n<div>Output</div><div>180</div>\r\n<div>CT</div><div>45s</div>\r\n<div>Alarm</div><div>Sensor Fault</div>\r\n<div>Downtime</div><div>39%</div>\r\n</div>\r\n</div>\r\n</a>\r\n\r\n<div class=\"machine-card idle\">\r\n<div class=\"machine-header\">M4 <span class=\"status-tag\">Idle</span></div>\r\n<div class=\"machine-metrics\">\r\n<div>Runtime</div><div>70%</div>\r\n<div>OEE</div><div>72%</div>\r\n<div>Output</div><div>210</div>\r\n<div>CT</div><div>43s</div>\r\n<div>Alarm</div><div>No Material</div>\r\n<div>Downtime</div><div>30%</div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"machine-card running\">\r\n<div class=\"machine-header\">M5 <span class=\"status-tag\">Running</span></div>\r\n<div class=\"machine-metrics\">\r\n<div>Runtime</div><div>94%</div>\r\n<div>OEE</div><div>90%</div>\r\n<div>Output</div><div>330</div>\r\n<div>CT</div><div>39s</div>\r\n<div>Alarm</div><div>None</div>\r\n<div>Downtime</div><div>6%</div>\r\n</div>\r\n</div>\r\n\r\n<div class=\"machine-card running\">\r\n<div class=\"machine-header\">M6 <span class=\"status-tag\">Running</span></div>\r\n<div class=\"machine-metrics\">\r\n<div>Runtime</div><div>91%</div>\r\n<div>OEE</div><div>86%</div>\r\n<div>Output</div><div>310</div>\r\n<div>CT</div><div>40s</div>\r\n<div>Alarm</div><div>None</div>\r\n<div>Downtime</div><div>9%</div>\r\n</div>\r\n</div>\r\n\r\n</div>\r\n</div>\r\n\r\n\r\n<!-- WORK ORDER -->\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Active Work Order</div>\r\n<div>WO-45825 | Product: AXLE-210</div>\r\n<div style=\"margin-top:8px\">Progress</div>\r\n<div class=\"progress\">\r\n<div class=\"progress-bar\" style=\"width:60%\"></div>\r\n</div>\r\n</div>\r\n\r\n\r\n<!-- ANALYTICS -->\r\n\r\n<div class=\"grid-2\">\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Hourly OEE</div>\r\n<div id=\"lineTrend\"></div>\r\n</div>\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Downtime %</div>\r\n<div id=\"lineDowntime\"></div>\r\n</div>\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Defects</div>\r\n<div id=\"lineQuality\"></div>\r\n</div>\r\n\r\n<div class=\"card\">\r\n<div class=\"section-title\">Energy</div>\r\n<div id=\"lineEnergy\"></div>\r\n</div>\r\n\r\n</div>\r\n\r\n</div>\r\n\r\n<script>\r\n\r\nnew ApexCharts(document.querySelector(\"#lineTrend\"),{\r\nchart:{type:'line',height:220,toolbar:{show:false}},\r\nseries:[{name:'OEE %',data:[70,72,74,75,76,75,75]}],\r\nxaxis:{categories:['06','07','08','09','10','11','12']},\r\nyaxis:{min:0,max:100},\r\ncolors:['#0052CC'],\r\nstroke:{width:2}\r\n}).render();\r\n\r\nnew ApexCharts(document.querySelector(\"#lineDowntime\"),{\r\nchart:{type:'bar',height:220,stacked:true,toolbar:{show:false}},\r\nplotOptions:{bar:{horizontal:true}},\r\nseries:[\r\n{name:'Material Jam',data:[20,15,30,10,18,22]},\r\n{name:'Power Trip',data:[15,10,12,8,14,11]},\r\n{name:'Sensor Fault',data:[10,12,18,6,9,13]},\r\n{name:'No Material',data:[8,6,10,5,7,9]},\r\n{name:'Maintenance',data:[5,4,6,3,5,6]}\r\n],\r\nxaxis:{categories:['M1','M2','M3','M4','M5','M6'],max:100},\r\nlegend:{position:'top'},\r\ndataLabels:{enabled:false}\r\n}).render();\r\n\r\nnew ApexCharts(document.querySelector(\"#lineQuality\"),{\r\nchart:{type:'donut',height:220},\r\nseries:[50,20,15,10,5],\r\nlabels:['Surface','Dimensional','Crack','Burr','Other']\r\n}).render();\r\n\r\nnew ApexCharts(document.querySelector(\"#lineEnergy\"),{\r\nchart:{type:'area',height:220,toolbar:{show:false}},\r\nseries:[{name:'kWh',data:[90,110,105,120,130,125,118]}],\r\nxaxis:{categories:['06','07','08','09','10','11','12']},\r\ncolors:['#0052CC']\r\n}).render();\r\n\r\n</script>\r\n\r\n</body>\r\n</html>"
}