{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<title>Sanand – Zone E Command Center</title>\r\n<script src=\"https://cdn.jsdelivr.net/npm/apexcharts\"></script>\r\n<style>\r\nbody { margin:0; font-family:\"Segoe UI\",Arial; background:#F4F5F7; color:#2F3438; }\r\n.main { padding:20px; }\r\n\r\n/* KPI STRIP */\r\n.kpi-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:20px; }\r\n.kpi-card { background:#fff; padding:12px; border-radius:6px; border:1px solid #E3E6EA; }\r\n.kpi-card h5 { margin:0; font-size:10px; text-transform:uppercase; color:#7A828A; }\r\n.kpi-card h2 { margin-top:4px; font-size:18px; }\r\n\r\n/* SECTION */\r\n.section { background:#fff; border:1px solid #E3E6EA; border-radius:6px; padding:15px; margin-bottom:18px; }\r\n.section-title { font-size:11px; font-weight:600; margin-bottom:12px; text-transform:uppercase; color:#7A828A; }\r\n\r\n/* MACHINE GRID */\r\n.machine-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }\r\n.machine-grid.col3 { grid-template-columns:repeat(3,1fr); }\r\n.machine-grid.col2 { grid-template-columns:repeat(2,1fr); }\r\n\r\n.machine { border:1px solid #E5E7EB; border-radius:6px; padding:12px; font-size:12px; transition:.15s; cursor:pointer; text-decoration:none; display:block; color:inherit; }\r\n.machine:hover { box-shadow:0 2px 6px rgba(0,0,0,.1); }\r\n\r\n.running { background:#ECFDF5; border-left:5px solid #10B981; }\r\n.idle    { background:#FFFBEB; border-left:5px solid #F59E0B; }\r\n.fault   { background:#FEF2F2; border-left:5px solid #EF4444; }\r\n\r\n.machine-header { display:flex; justify-content:space-between; font-weight:600; margin-bottom:6px; align-items:center; }\r\n.machine-header span { font-size:8.5px; font-weight:700; padding:1px 6px; border-radius:3px; text-transform:uppercase; }\r\n.running .machine-header span { background:#D1FAE5; color:#065F46; }\r\n.idle    .machine-header span { background:#FDE68A; color:#78350F; }\r\n.fault   .machine-header span { background:#FCA5A5; color:#7F1D1D; animation:bk .9s infinite; }\r\n\r\n.metrics { display:grid; grid-template-columns:1fr 1fr; gap:4px; font-size:11px; }\r\n.metrics .mk { color:#7A828A; }\r\n.metrics .mv { font-weight:600; text-align:right; }\r\n\r\n.grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:20px; }\r\n\r\na { text-decoration:none; color:inherit; }\r\n\r\n@keyframes bk { 0%,100%{opacity:1} 50%{opacity:.4} }\r\n\r\n/* Sub-section label for coating lines */\r\n.sub-label {\r\n  font-size:10px; font-weight:600; color:#5A6270;\r\n  letter-spacing:1px; text-transform:uppercase;\r\n  margin:14px 0 8px; padding-left:2px;\r\n  border-left:3px solid #E3E6EA; padding-left:8px;\r\n}\r\n.sub-label.e1 { border-left-color:#3A6A90; color:#3A6A90; }\r\n.sub-label.e2 { border-left-color:#2E7840; color:#2E7840; }\r\n</style>\r\n</head>\r\n<body>\r\n<div class=\"main\">\r\n\r\n<!-- KPI STRIP -->\r\n<div class=\"kpi-grid\">\r\n  <div class=\"kpi-card\"><h5>Zone OEE</h5><h2>78%</h2></div>\r\n  <div class=\"kpi-card\"><h5>Availability</h5><h2>85%</h2></div>\r\n  <div class=\"kpi-card\"><h5>Performance</h5><h2>80%</h2></div>\r\n  <div class=\"kpi-card\"><h5>Quality</h5><h2>96%</h2></div>\r\n  <div class=\"kpi-card\"><h5>Active Machines</h5><h2>7</h2></div>\r\n  <div class=\"kpi-card\"><h5>Downtime</h5><h2>12%</h2></div>\r\n</div>\r\n\r\n<!-- COATING LINES -->\r\n<div class=\"section\">\r\n  <div class=\"section-title\">Coating Lines</div>\r\n\r\n  <!-- E1 Anode Coating -->\r\n  <div class=\"sub-label e1\">E1 — Anode Coating</div>\r\n  <div class=\"machine-grid\">\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Unwinder <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Web Speed</div><div class=\"mv\">22.5 m/min</div>\r\n        <div class=\"mk\">Tension</div><div class=\"mv\">45 N</div>\r\n        <div class=\"mk\">Roll Dia</div><div class=\"mv\">620 mm</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">A Coater <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Coat Wt</div><div class=\"mv\">182 g/m²</div>\r\n        <div class=\"mk\">Gap</div><div class=\"mv\">0.24 mm</div>\r\n        <div class=\"mk\">Pump RPM</div><div class=\"mv\">1140</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Oven A <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Temp Zone 1</div><div class=\"mv\">128°C</div>\r\n        <div class=\"mk\">Temp Zone 2</div><div class=\"mv\">132°C</div>\r\n        <div class=\"mk\">Air Flow</div><div class=\"mv\">Normal</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">B Coater <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Coat Wt</div><div class=\"mv\">180 g/m²</div>\r\n        <div class=\"mk\">Gap</div><div class=\"mv\">0.24 mm</div>\r\n        <div class=\"mk\">Pump RPM</div><div class=\"mv\">1130</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Oven B <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Temp Zone 1</div><div class=\"mv\">130°C</div>\r\n        <div class=\"mk\">Temp Zone 2</div><div class=\"mv\">135°C</div>\r\n        <div class=\"mk\">Air Flow</div><div class=\"mv\">Normal</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">CCD #3 <span>Warning</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Defects</div><div class=\"mv\" style=\"color:#D97706\">3 flagged</div>\r\n        <div class=\"mk\">Coverage</div><div class=\"mv\">100%</div>\r\n        <div class=\"mk\">FPS</div><div class=\"mv\">120</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\" style=\"color:#D97706\">Check</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Splitter <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Width</div><div class=\"mv\">650 mm</div>\r\n        <div class=\"mk\">Trim</div><div class=\"mv\">2 mm</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Rewinder 1+2 <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Roll Dia</div><div class=\"mv\">480 mm</div>\r\n        <div class=\"mk\">Tension</div><div class=\"mv\">52 N</div>\r\n        <div class=\"mk\">OEE</div><div class=\"mv\">84.1%</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n  </div>\r\n\r\n  <!-- E2 Cathode Coating -->\r\n  <div class=\"sub-label e2\" style=\"margin-top:18px\">E2 — Cathode Coating</div>\r\n  <div class=\"machine-grid\">\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Unwinder <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Web Speed</div><div class=\"mv\">20.1 m/min</div>\r\n        <div class=\"mk\">Tension</div><div class=\"mv\">42 N</div>\r\n        <div class=\"mk\">Roll Dia</div><div class=\"mv\">580 mm</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">A Coater <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Coat Wt</div><div class=\"mv\">310 g/m²</div>\r\n        <div class=\"mk\">Gap</div><div class=\"mv\">0.38 mm</div>\r\n        <div class=\"mk\">Pump RPM</div><div class=\"mv\">980</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine idle\" href=\"#\">\r\n      <div class=\"machine-header\">Oven A <span>Warning</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Temp Zone 1</div><div class=\"mv\" style=\"color:#D97706\">125°C</div>\r\n        <div class=\"mk\">Temp Zone 2</div><div class=\"mv\" style=\"color:#D97706\">118°C</div>\r\n        <div class=\"mk\">Air Flow</div><div class=\"mv\" style=\"color:#D97706\">Low</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\" style=\"color:#D97706\">Warning</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">B Coater <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Coat Wt</div><div class=\"mv\">308 g/m²</div>\r\n        <div class=\"mk\">Gap</div><div class=\"mv\">0.38 mm</div>\r\n        <div class=\"mk\">Pump RPM</div><div class=\"mv\">970</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Oven B <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Temp Zone 1</div><div class=\"mv\">130°C</div>\r\n        <div class=\"mk\">Temp Zone 2</div><div class=\"mv\">133°C</div>\r\n        <div class=\"mk\">Air Flow</div><div class=\"mv\">Normal</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">CCD #3 <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Defects</div><div class=\"mv\">0 flagged</div>\r\n        <div class=\"mk\">Coverage</div><div class=\"mv\">100%</div>\r\n        <div class=\"mk\">FPS</div><div class=\"mv\">120</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine idle\" href=\"#\">\r\n      <div class=\"machine-header\">NG Marker <span>Warning</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Marks</div><div class=\"mv\" style=\"color:#D97706\">2 pcs</div>\r\n        <div class=\"mk\">Laser</div><div class=\"mv\" style=\"color:#D97706\">Check</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\" style=\"color:#D97706\">Warning</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"#\">\r\n      <div class=\"machine-header\">Rewinder 1+2 <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Roll Dia</div><div class=\"mv\">460 mm</div>\r\n        <div class=\"mk\">Tension</div><div class=\"mv\">48 N</div>\r\n        <div class=\"mk\">OEE</div><div class=\"mv\">81.2%</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n  </div>\r\n</div>\r\n\r\n<!-- MIXING -->\r\n<div class=\"section\">\r\n  <div class=\"section-title\">Mixing</div>\r\n  <div class=\"machine-grid\">\r\n    <a class=\"machine running\" href=\"http://10.34.26.4:8088/data/perspective/client/Zone_E_SCADA/Sanand/\">\r\n      <div class=\"machine-header\">Mixing Tank A <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">RPM</div><div class=\"mv\">1200</div>\r\n        <div class=\"mk\">Temp</div><div class=\"mv\">32°C</div>\r\n        <div class=\"mk\">Batch</div><div class=\"mv\">OK</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Active</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine idle\" href=\"Sanand/ZoneE/Mixing/MixingTankB\">\r\n      <div class=\"machine-header\">Mixing Tank B <span>Idle</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">RPM</div><div class=\"mv\">0</div>\r\n        <div class=\"mk\">Temp</div><div class=\"mv\">29°C</div>\r\n        <div class=\"mk\">Batch</div><div class=\"mv\">Waiting</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Idle</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"Sanand/ZoneE/Mixing/SlurryPumpA\">\r\n      <div class=\"machine-header\">Slurry Pump A <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Flow</div><div class=\"mv\">22L</div>\r\n        <div class=\"mk\">Pressure</div><div class=\"mv\">3.2</div>\r\n        <div class=\"mk\">Batch</div><div class=\"mv\">Active</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine fault\" href=\"Sanand/ZoneE/Mixing/SlurryPumpB\">\r\n      <div class=\"machine-header\">Slurry Pump B <span>Fault</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Flow</div><div class=\"mv\">0</div>\r\n        <div class=\"mk\">Pressure</div><div class=\"mv\">0</div>\r\n        <div class=\"mk\">Alarm</div><div class=\"mv\">Pump Fault</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Stopped</div>\r\n      </div>\r\n    </a>\r\n  </div>\r\n</div>\r\n\r\n<!-- CALENDARING -->\r\n<div class=\"section\">\r\n  <div class=\"section-title\">Calendaring</div>\r\n  <div class=\"machine-grid\">\r\n    <a class=\"machine running\" href=\"Sanand/ZoneE/Calendaring/Anode/ColdPress1\">\r\n      <div class=\"machine-header\">ColdPress1 <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Pressure</div><div class=\"mv\">180</div>\r\n        <div class=\"mk\">Temp</div><div class=\"mv\">85°C</div>\r\n        <div class=\"mk\">OEE</div><div class=\"mv\">90%</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine idle\" href=\"Sanand/ZoneE/Calendaring/Anode/ColdPress2\">\r\n      <div class=\"machine-header\">ColdPress2 <span>Idle</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Pressure</div><div class=\"mv\">0</div>\r\n        <div class=\"mk\">Temp</div><div class=\"mv\">70°C</div>\r\n        <div class=\"mk\">OEE</div><div class=\"mv\">82%</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Idle</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"Sanand/ZoneE/Calendaring/Cathode/HotPress\">\r\n      <div class=\"machine-header\">HotPress <span>Running</span></div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Pressure</div><div class=\"mv\">200</div>\r\n        <div class=\"mk\">Temp</div><div class=\"mv\">92°C</div>\r\n        <div class=\"mk\">OEE</div><div class=\"mv\">88%</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Normal</div>\r\n      </div>\r\n    </a>\r\n  </div>\r\n</div>\r\n\r\n<!-- SLITTING -->\r\n<div class=\"section\">\r\n  <div class=\"section-title\">Slitting</div>\r\n  <div class=\"machine-grid\">\r\n    <a class=\"machine running\" href=\"Sanand/ZoneE/Slitting/AnodeSlitter\">\r\n      <div class=\"machine-header\">Anode Slitter</div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Speed</div><div class=\"mv\">120 m/min</div>\r\n        <div class=\"mk\">Output</div><div class=\"mv\">420</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Running</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine idle\" href=\"Sanand/ZoneE/Slitting/CathodeSlitter\">\r\n      <div class=\"machine-header\">Cathode Slitter</div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Speed</div><div class=\"mv\">0</div>\r\n        <div class=\"mk\">Output</div><div class=\"mv\">0</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Idle</div>\r\n      </div>\r\n    </a>\r\n  </div>\r\n</div>\r\n\r\n<!-- NOTCHING -->\r\n<div class=\"section\">\r\n  <div class=\"section-title\">Notching</div>\r\n  <div class=\"machine-grid\">\r\n    <a class=\"machine running\" href=\"Sanand/ZoneE/Notching/Anode\">\r\n      <div class=\"machine-header\">Anode Notching</div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Speed</div><div class=\"mv\">95</div>\r\n        <div class=\"mk\">Output</div><div class=\"mv\">380</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Running</div>\r\n      </div>\r\n    </a>\r\n    <a class=\"machine running\" href=\"Sanand/ZoneE/Notching/Cathode\">\r\n      <div class=\"machine-header\">Cathode Notching</div>\r\n      <div class=\"metrics\">\r\n        <div class=\"mk\">Speed</div><div class=\"mv\">102</div>\r\n        <div class=\"mk\">Output</div><div class=\"mv\">410</div>\r\n        <div class=\"mk\">Status</div><div class=\"mv\">Running</div>\r\n      </div>\r\n    </a>\r\n  </div>\r\n</div>\r\n\r\n<!-- ANALYTICS -->\r\n<div class=\"grid-2\">\r\n  <div class=\"section\">\r\n    <div class=\"section-title\">Hourly OEE</div>\r\n    <div id=\"oeeTrend\"></div>\r\n  </div>\r\n  <div class=\"section\">\r\n    <div class=\"section-title\">Downtime Breakdown</div>\r\n    <div id=\"downtimeChart\"></div>\r\n  </div>\r\n</div>\r\n\r\n</div>\r\n\r\n<script>\r\nnew ApexCharts(document.querySelector(\"#oeeTrend\"),{\r\n  chart:{type:'line',height:220,toolbar:{show:false},fontFamily:'\"Segoe UI\",Arial'},\r\n  series:[{name:'OEE',data:[70,72,75,78,79,78]}],\r\n  xaxis:{categories:['06','07','08','09','10','11']},\r\n  yaxis:{max:100},\r\n  colors:['#0052CC']\r\n}).render();\r\n\r\nnew ApexCharts(document.querySelector(\"#downtimeChart\"),{\r\n  chart:{type:'donut',height:220,fontFamily:'\"Segoe UI\",Arial'},\r\n  series:[30,25,18,15,12],\r\n  labels:['Material','Power','Sensor','Operator','Maintenance']\r\n}).render();\r\n</script>\r\n</body>\r\n</html>"
}