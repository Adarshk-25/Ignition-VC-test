{
  "custom": {},
  "params": {
    "tagpath": "[default]agratas/sanand/zoneE/line1/mixing/Diaphragm Pump/electrical"
  },
  "propConfig": {
    "params.tagpath": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.data": {
      "binding": {
        "config": {
          "path": "view.params.tagpath"
        },
        "transforms": [
          {
            "code": "\ttagPath \u003d \"[default]agratas/sanand/zoneE/line1/mixing/Diaphragm Pump/electrical\"\n\t\n\tresults \u003d []\n\t\n\tbrowse \u003d system.tag.browse(tagPath, {\"recursive\": False})\n\t\n\ttagPaths \u003d []\n\ttagMeta \u003d []\n\t\n\t# Collect paths\n\tfor tag in browse.getResults():\n\t    fullPath \u003d str(tag[\u0027fullPath\u0027])\n\t    name \u003d tag[\u0027name\u0027]\n\t    \n\t    tagPaths.extend([\n\t        fullPath,\n\t        fullPath + \".EngUnit\",\n\t        fullPath + \".EngHigh\",\n\t        fullPath + \".EngLow\"\n\t    ])\n\t    \n\t    tagMeta.append({\n\t        \"name\": name,\n\t        \"path\": fullPath\n\t    })\n\t\n\t# Batch read\n\tvalues \u003d system.tag.readBlocking(tagPaths)\n\t\n\t# 🔥 IMPORTANT: detect if first tag is JSON blob containing ALL params\n\tfirstRaw \u003d values[0].value\n\tglobalDict \u003d firstRaw if isinstance(firstRaw, dict) else None\n\t\n\t# Process\n\tfor i, meta in enumerate(tagMeta):\n\t    \n\t    baseIndex \u003d i * 4\n\t    \n\t    raw \u003d values[baseIndex].value\n\t    unit \u003d values[baseIndex + 1].value\n\t    high \u003d values[baseIndex + 2].value\n\t    low \u003d values[baseIndex + 3].value\n\t    \n\t    fullPath \u003d meta[\"path\"]\n\t    paramName \u003d meta[\"name\"]  # e.g., \"current\", \"power\", etc.\n\t    \n\t    # ✅ FIXED LOGIC\n\t    if globalDict:\n\t        # First tag had the full JSON blob - extract THIS parameter\u0027s value\n\t        actual \u003d globalDict.get(paramName, None)\n\t    elif isinstance(raw, dict):\n\t        # This individual tag is a dict (edge case)\n\t        actual \u003d raw.get(paramName, None)\n\t    else:\n\t        # Normal atomic tag\n\t        actual \u003d raw\n\t    \n\t    # Alarm\n\t    alarmState \u003d \"Inactive\"\n\t    alarmStyle \u003d \"alarm/Inactive\"\n\t    \n\t    try:\n\t        alarmQuery \u003d system.alarm.queryStatus(source\u003d[fullPath])\n\t        if len(alarmQuery) \u003e 0:\n\t            alarmState \u003d \"Active\"\n\t            alarmStyle \u003d \"alarm/Active\"\n\t    except:\n\t        pass\n\t    \n\t    results.append({\n\t        \"Parameter\": paramName,\n\t        \"Actual_Value\": actual,\n\t        \"Unit\": unit,\n\t        \"Upper_Limit\": high,\n\t        \"Lower_Limit\": low,\n\t        \"Alarm\": {\n\t            \"value\": alarmState,\n\t            \"style\": {\n\t                \"classes\": alarmStyle\n\t            }\n\t        }\n\t    })\n\t\n\treturn results",
            "type": "script"
          }
        ],
        "type": "property"
      }
    }
  },
