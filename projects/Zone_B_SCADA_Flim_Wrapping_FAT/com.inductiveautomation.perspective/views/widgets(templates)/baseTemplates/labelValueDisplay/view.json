            "fontSize": "75%",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Label_displayValue"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "path": "view.params.color"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
