      "paramDirection": "input",
      "persistent": true
    },
    "params.displayName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.displayValue": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label_displayName"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.displayName"
              },
              "type": "property"
            }
          }
        },
        "props": {
