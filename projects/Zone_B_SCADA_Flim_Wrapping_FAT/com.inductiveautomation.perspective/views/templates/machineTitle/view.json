{
  "custom": {},
  "params": {
    "machineName": "value",
    "machineSpeed": "value",
    "productId": "value",
    "speedpercent": "value"
  },
  "propConfig": {
    "params.machineName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.machineSpeed": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.productId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.speedpercent": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 116,
      "width": 630
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tsystem.perspective.openPopup(\n    id\u003d\"machineDetails\",\n    view\u003d\"equipment_view_details\",   # your popup view name\n    params\u003d{\"machineName\": \"ColdPress1\"},\n    modal\u003dTrue,\n    draggable\u003dTrue,\n    resizable\u003dFalse,\n    position\u003d{\"top\": 100, \"left\": 200}\n)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Title"
            },
            "position": {
              "basis": "32.5px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.machineName"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "alignVertical": "top",
              "style": {
                "color": "#111827",
                "fontSize": "22px",
                "fontWeight": "600"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "productId"
            },
            "position": {
              "basis": "9px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"product Id: \" + {view.params.productId}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "color": "#152734",
                "fontSize": "13px",
                "fontWeight": "400",
                "marginBottom": "10px",
                "marginLeft": "20px",
                "marginTop": "-5px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "machine speed"
            },
            "position": {
              "basis": "16px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "\"Machine Speed: \" + {view.params.machineSpeed} + \" m/min\""
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "color": "#3E3E3E",
                "fontSize": "13px",
                "fontWeight": "500",
                "height": "20px",
                "letterSpacing": "0.5px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Progress"
            },
            "position": {
              "basis": "12px",
              "shrink": 0
            },
            "propConfig": {
              "props.bar.color": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.machineSpeed} \u003c 20, \"#16A34A\",\r\n    if({view.params.machineSpeed} \u003c 40, \"#F59E0B\",\r\n        \"#DC2626\"))"
                  },
                  "type": "expr"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "path": "view.params.speedpercent"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "bar": {},
              "style": {
                "borderRadius": "8px",
                "color": "#D5D5D5",
                "fontWeight": "500",
                "height": "10px",
                "width": "150px"
              },
              "track": {
                "backgroundColor": "",
                "style": {
                  "backgroundColor": "#E2E8F0",
                  "borderRadius": "8px"
                }
              },
              "valueDisplay": {
                "format": "0,0"
              }
            },
            "type": "ia.display.progress"
          }
        ],
        "meta": {
          "name": "HeaderContainer"
        },
        "position": {
          "basis": "106px"
        },
        "props": {
          "alignContent": "flex-start",
          "alignItems": "flex-start",
          "direction": "column",
          "justify": "space-between",
          "style": {
            "marginBottom": "20px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}