            "meta": {
              "name": "alarmStatusDropDownEName"
            },
            "position": {
              "basis": "177px"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "expression": "{../alarmStatusDropDownPLine.props.value}"
                  },
                  "transforms": [
                    {
                      "code": "\tnames\u003d[]\n\tresults\u003dsystem.tag.browse(value)\n\tfor result in results.getResults():\n\t\t#print(result[\u0027fullPath\u0027])\n\t\tresult[\u0027fullPath\u0027]\u003dstr(result[\u0027fullPath\u0027]).replace(\"[default]\",\"\")\n\t\tnames.append({\"value\":\"*\"+result[\u0027fullPath\u0027]+\"*\",\"label\":result[\u0027name\u0027]})\n\treturn names",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "placeholder": {
                "color": "#000000",
                "text": "Select Production Line"
