{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 58,
      "width": 1200
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Image"
            },
            "position": {
              "basis": "214px"
            },
            "props": {
              "fit": {
                "mode": "percent"
              },
              "source": "/system/images/image.jpg"
            },
            "type": "ia.display.image"
          },
          {
            "meta": {
              "name": "Icon_0"
            },
            "position": {
              "basis": "25px"
            },
            "props": {
              "path": "material/featured_video"
            },
            "type": "ia.display.icon"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "basis": "48px",
                  "grow": 1
                },
                "props": {
                  "style": {
                    "textAlign": "center"
                  },
                  "text": "Theme"
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Dropdown"
                },
                "position": {
                  "basis": "138px",
                  "shrink": 0
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "config": {
                        "bidirectional": true,
                        "path": "session.props.theme"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "options": [
                    {
                      "label": "Light",
                      "value": "light"
                    },
                    {
                      "label": "Light Cool",
                      "value": "light-cool"
                    },
                    {
                      "label": "Light Warm",
                      "value": "light-warm"
                    },
                    {
                      "label": "Dark",
                      "value": "dark"
                    },
                    {
                      "label": "Dark Cool",
                      "value": "dark-cool"
                    },
                    {
                      "label": "Dark Warm",
                      "value": "dark-warm"
                    }
                  ],
                  "search": {
                    "enabled": false,
                    "marginLeft": "8px"
                  }
                },
                "type": "ia.input.dropdown"
              }
            ],
            "meta": {
              "name": "themePicker"
            },
            "position": {
              "basis": "199px"
            },
            "props": {
              "justify": "space-evenly",
              "style": {
                "marginBottom": "8px",
                "marginRight": "16px",
                "marginTop": "1px"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "Left",
          "tooltip": {
            "style": {
              "backgroundColor": "#27507E"
            },
            "width": "100%"
          }
        },
        "position": {
          "basis": "455px",
          "shrink": 0
        },
        "props": {
          "alignContent": "center",
          "alignItems": "center"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "30px"
            },
            "props": {
              "path": "material/account_box"
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "user"
            },
            "position": {
              "basis": "90px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if(\r\n    isNull({session.props.auth.user.userName}),\r\n    \"Guest\",\r\n    {session.props.auth.user.userName}\r\n)\r\n"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "    if self.session.props.auth.authenticated:\n    \tsystem.perspective.logout()\n    else:\n     system.perspective.login()"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Label_0"
            },
            "position": {
              "basis": "65px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if({session.props.auth.authenticated}, \"Logout\", \"Login\")\r\n"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Icon_1"
            },
            "position": {
              "basis": "30px"
            },
            "props": {
              "path": "material/date_range"
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "83px",
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "dateFormat(now(), \"dd-MM-yyyy HH:mm:ss\")\r\n"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Right",
          "tooltip": {
            "width": "100%"
          }
        },
        "position": {
          "basis": "463px",
          "shrink": 0
        },
        "props": {
          "alignContent": "center",
          "alignItems": "center",
          "justify": "flex-end"
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root",
      "tooltip": {
        "style": {
          "backgroundColor": "#174195"
        }
      }
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "session.props.auth.user.roles"
          },
          "transforms": [
            {
              "code": "\t\tif \"Administrator\" in value:\n\t\t\treturn \"var(--div-3)\"\n\t\telse:\n\t\t\treturn \"var(--div-9)\"\n\t\t",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "justify": "space-between"
    },
    "type": "ia.container.flex"
  }
}