              "props.data": {
                "binding": {
                  "config": {
                    "expression": "now(5000)"
                  },
                  "transforms": [
                    {
                      "code": "    basePath \u003d self.view.params.tagpath\n    tags \u003d system.tag.browse(basePath).getResults()\n    \n    paths \u003d []\n    names \u003d []\n    \n    for t in tags:\n        tagPath \u003d basePath + \"/\" + t[\u0027name\u0027]\n        paths.append(tagPath)\n        \n        # format parameter name\n        formattedName \u003d t[\u0027name\u0027].replace(\"_\", \" \").title()\n        names.append(formattedName)\n    \n    # read tag values\n    values \u003d system.tag.readBlocking(paths)\n    \n    data \u003d []\n    \n    for i, v in enumerate(values):\n    \n        tagPath \u003d paths[i]\n    \n        # read engineering unit\n        uom \u003d system.tag.readBlocking([tagPath + \".EngUnit\"])[0].value\n    \n        val \u003d v.value\n        if isinstance(val, (int, float)):\n            val \u003d round(val, 2)\n    \n        data.append([\n            names[i],\n            str(val),\n            str(uom),\n            str(v.quality)\n        ])\n    \n    dataset \u003d system.dataset.toDataSet(\n        [\"Parameter\", \"Actual Value\", \"Unit\", \"Quality\"],\n        data\n    )\n    \n    return dataset",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              },
