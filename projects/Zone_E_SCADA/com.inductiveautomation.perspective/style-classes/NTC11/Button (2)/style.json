{
  "base": {
    "style": {
      "backgroundImage": "linear-gradient(180deg, #FFFFFF 0%, #D6D6D6 100%)",
      "backgroundColor": "#E6E6E6",
      "border": "1px solid #7E7E7E",
      "borderRadius": "3px",
      "color": "#1F1F1F",
      "fontFamily": "Roboto, 'Segoe UI', Arial, sans-serif",
      "fontSize": "12px",
      "fontWeight": "600",
      "letterSpacing": "0.4px",
      "textTransform": "uppercase",
      "boxShadow": "0 1px 2px rgba(0,0,0,0.35), inset 0 1px 0 rgba(255,255,255,0.8)",
      "cursor": "pointer",
      "padding": "0 12px",
      "transition": "background-image 0.15s, box-shadow 0.15s"
    }
  },
  "variants": [
    {
      "pseudo": "hover",
      "style": {
        "backgroundImage": "linear-gradient(180deg, #FFFFFF 0%, #C9D5E1 100%)",
        "borderColor": "#2E5C8A"
      }
    },
    {
      "pseudo": "active",
      "style": {
        "backgroundImage": "linear-gradient(180deg, #C2C9D0 0%, #DADFE4 100%)",
        "boxShadow": "inset 0 2px 3px rgba(0,0,0,0.35)"
      }
    },
    {
      "pseudo": "focus",
      "style": {
        "outline": "2px solid #2E5C8A",
        "outlineOffset": "1px"
      }
    },
    {
      "pseudo": "disabled",
      "style": {
        "backgroundImage": "none",
        "backgroundColor": "#E3E3E3",
        "color": "#9A9A9A",
        "borderColor": "#C2C2C2",
        "boxShadow": "none",
        "cursor": "not-allowed"
      }
    }
  ]
}