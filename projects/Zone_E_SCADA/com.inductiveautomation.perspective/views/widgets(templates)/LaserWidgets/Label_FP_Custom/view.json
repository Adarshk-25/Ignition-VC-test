{
  "custom": {
    "popupOpen": false
  },
  "params": {
    "label": "value"
  },
  "propConfig": {
    "custom.popupOpen": {
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 26,
      "width": 47
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tself.view.custom.popupOpen \u003d True"
              },
              "scope": "G",
              "type": "script"
            },
            "onMouseOut": {
              "config": {
                "script": "\tself.props.style.backgroundColor \u003d \"\""
              },
              "scope": "G",
              "type": "script"
            },
            "onMouseOver": {
              "config": {
                "script": "\tself.props.style.backgroundColor \u003d \"#D3D3D3\""
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Label",
          "tooltip": {
            "enabled": true
          }
        },
        "position": {
          "height": 1.1154,
          "width": 0.9787,
          "x": 0.0274,
          "y": -0.0035
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.ToolTip"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          },
          "props.textStyle.backgroundColor": {
            "binding": {
              "config": {
                "expression": "if({view.custom.popupOpen}, \"#D3D3D3\", \"transparent\")"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": ""
          },
          "textStyle": {
            "borderStyle": "outset",
            "borderWidth": 1,
            "classes": "Page/Label3",
            "paddingBottom": 9,
            "paddingLeft": 0,
            "paddingRight": 0,
            "paddingTop": 9,
            "resize": "both",
            "whiteSpace": "normal"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "aspectRatio": "47:26",
      "mode": "percent",
      "style": {
        "alignItems": "stretch",
        "overflow": "hidden"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "PopupClosed",
          "pageScope": true,
          "script": "\t# implement your handler here\n\tself.view.custom.popupOpen \u003d False",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.coord"
  }
}