{
  "custom": {},
  "params": {
    "forwardDisplay": true,
    "label": "Sanand",
    "path": "value"
  },
  "propConfig": {
    "params.forwardDisplay": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": "auto"
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "propConfig": {
          "props.style.fontWeight": {
            "binding": {
              "config": {
                "path": "view.params.forwardDisplay"
              },
              "transforms": [
                {
                  "fallback": null,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": true,
                      "output": "normal"
                    },
                    {
                      "input": false,
                      "output": "bolder"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "General/textHover HeaderTheme",
            "cursor": "pointer",
            "fontFamily": "sans-serif",
            "letterSpacing": "1px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "22px"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.forwardDisplay"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "material/navigate_next"
        },
        "type": "ia.display.icon"
      }
    ],
    "events": {
      "dom": {
        "onClick": [
          {
            "config": {
              "page": "{view.params.path}"
            },
            "enabled": false,
            "scope": "C",
            "type": "nav"
          },
          {
            "config": {
              "script": "\t\t\t\n#\tsystem.perspective.navigate(\n#\t    page\u003dself.view.params.path\n#\t)\n#\t\n#\tif self.session.custom.nav.breadcrumb:\n#\t    self.session.custom.nav.breadcrumb.pop()\n\n\n    path \u003d self.view.params.path\n    crumbs \u003d self.session.custom.nav.breadcrumb\n\n    # trim breadcrumb up to clicked item\n    newCrumbs \u003d []\n\n    for c in crumbs:\n        newCrumbs.append(c)\n        if c[\"path\"] \u003d\u003d path:\n            break\n\n    self.session.custom.nav.breadcrumb \u003d newCrumbs\n#    self.session.custom.nav.currentPath \u003d path\n\n    system.perspective.navigate(page\u003dpath)\n    \n    "
            },
            "scope": "G",
            "type": "script"
          }
        ]
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}