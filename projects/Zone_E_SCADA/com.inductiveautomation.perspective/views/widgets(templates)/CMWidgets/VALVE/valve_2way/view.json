                  "tagpath": "{view.params.tagpath}"
                },
                "tagPath": "{tagpath}/openValue"
              },
              "transforms": [
                {
                  "code": "\treturn str(round(value,2)) + \" %\"",
                  "type": "script"
                }
              ],
              "type": "tag"
            }
          }
        },
        "props": {
          "label": {
            "location": "top",
            "style": {
              "fontSize": "100%"
            }
          },
          "value": {
            "style": {
              "fontSize": "100%"
            }
          },
          "valve": "bottom"
        },
        "type": "ia.symbol.valve"
      },
      {
        "meta": {
          "name": "Valve_vertical"
        },
        "position": {
          "height": 1,
          "width": 1
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "view.params.isvertical"
              },
              "type": "property"
