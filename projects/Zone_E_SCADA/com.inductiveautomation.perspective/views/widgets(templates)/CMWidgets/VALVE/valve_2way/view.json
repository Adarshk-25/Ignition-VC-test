                "references": {
                  "tagpath": "{view.params.tagpath}"
                },
                "tagPath": "{tagpath}.name"
              },
              "type": "tag"
            }
          },
          "props.value.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "tagpath": "{view.params.tagpath}"
                },
                "tagPath": "{tagpath}/openValue"
              },
              "transforms": [
                {
                  "code": "\treturn str(round(value,2)) + \" %\"",
