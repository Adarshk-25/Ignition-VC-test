{
  "custom": {},
  "params": {
    "isvertical": true,
    "nameLabelPosition": "value",
    "tagpath": "[default]agratas/sanand/zoneE/line1/mixing/VLV 904-607",
    "valuePosition": "value",
    "valveOrientation": "value",
    "valveType": "p\u0026id"
  },
  "propConfig": {
    "params.isvertical": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.nameLabelPosition": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagpath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.valuePosition": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.valveOrientation": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.valveType": {
      "paramDirection": "input",
      "persistent": true
