              "transforms": [
                {
                  "fallback": "default",
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": 0,
                      "output": "closed"
                    },
                    {
                      "input": 1,
                      "output": "open"
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "tag"
            }
          },
          "props.value.text": {
            "binding": {
              "config": {
