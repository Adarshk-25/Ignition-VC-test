        "transforms": [
          {
            "fallback": null,
            "inputType": "scalar",
            "mappings": [
              {
                "input": true,
                "output": 180
              },
              {
                "input": false,
                "output": 80
              }
            ],
            "outputType": "scalar",
            "type": "map"
          }
        ],
        "type": "property"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 60
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Valve"
        },
        "position": {
          "height": 1,
          "width": 1
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "!{view.params.isvertical}"
              },
              "type": "expr"
            }
          },
          "props.appearance": {
